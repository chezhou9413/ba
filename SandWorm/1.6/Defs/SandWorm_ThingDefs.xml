<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>SandWorm_Thing</defName>
    <label>sandworm</label>
    <description>A gigantic sand-dwelling leviathan that tunnels through the map, crushes anything in its path, and answers the signal of a sand hammer.</description>
    <thingClass>SandWormLib.SandWormThing</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Pawn</altitudeLayer>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <graphicData>
      <texPath>Things/SandWorm/SandWorm_HitProxy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/SandWorm/SandWorm_HitProxy</uiIconPath>
    <statBases>
      <WorkToBuild>1</WorkToBuild>
      <MaxHitPoints>50000</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="SandWormLib.CompProperties_SandWormHostileDummy">
        <conditionDef>Flashstorm</conditionDef>
        <worldRange>0</worldRange>
        <hideSource>true</hideSource>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>SandWorm_SmallThing</defName>
    <label>small sandworm</label>
    <description>A smaller sandworm that crushes targets with its body but lacks the instant-kill bite of a leviathan-class sandworm.</description>
    <thingClass>SandWormLib.SandWormSmallThing</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Pawn</altitudeLayer>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <graphicData>
      <texPath>Things/SandWorm/SandWorm_HitProxy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/SandWorm/SandWorm_HitProxy</uiIconPath>
    <statBases>
      <WorkToBuild>1</WorkToBuild>
      <MaxHitPoints>20000</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="SandWormLib.CompProperties_SandWormHostileDummy">
        <conditionDef>Flashstorm</conditionDef>
        <worldRange>0</worldRange>
        <hideSource>true</hideSource>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>SandWorm_HitProxy</defName>
    <thingClass>SandWormLib.SandWormHitProxyThing</thingClass>
    <label>sandworm</label>
    <description>A hidden hit proxy segment for the sandworm.</description>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <drawGUIOverlay>false</drawGUIOverlay>
    <altitudeLayer>Pawn</altitudeLayer>
    <size>(5,5)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <graphicData>
      <texPath>Things/SandWorm/SandWorm_HitProxy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <uiIconPath>Things/SandWorm/SandWorm_HitProxy</uiIconPath>
    <statBases>
      <MaxHitPoints>50000</MaxHitPoints>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>SandWorm_SmallHitProxy</defName>
    <thingClass>SandWormLib.SandWormHitProxyThing</thingClass>
    <label>small sandworm</label>
    <description>A hidden hit proxy segment for the small sandworm.</description>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <drawGUIOverlay>false</drawGUIOverlay>
    <altitudeLayer>Pawn</altitudeLayer>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <graphicData>
      <texPath>Things/SandWorm/SandWorm_HitProxy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <uiIconPath>Things/SandWorm/SandWorm_HitProxy</uiIconPath>
    <statBases>
      <MaxHitPoints>20000</MaxHitPoints>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>SandHammer</defName>
    <label>sand hammer</label>
    <description>A vibration device used to lure a deep-sand leviathan. The sand hammer repeatedly strikes the ground and releases low-frequency echoes, imitating the seismic mating signal of a sandworm. Deploy it in the marked desert zone to draw out the creature hiding below.</description>
    <thingClass>SandWormLib.SandHammerThing</thingClass>
    <category>Building</category>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <graphicData>
      <texPath>Things/SandWorm/SandHammer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/SandWorm/SandHammer</uiIconPath>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>4</Mass>
    </statBases>
    <minifiedDef>MinifiedThing</minifiedDef>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>SandWorm_ShockwaveRockWall</defName>
    <label>shockwave rock wall</label>
    <description>A temporary wall of shattered stone raised by the sand leviathan's seismic shockwave.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Never</tickerType>
    <useHitPoints>true</useHitPoints>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <drawGUIOverlay>false</drawGUIOverlay>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockLight>true</blockLight>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>5</costStuffCount>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <graphicData>
      <texPath>Things/Building/Linked/Wall</texPath>
      <graphicClass>Graphic_Appearances</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isWall>true</isWall>
    </building>
  </ThingDef>

  <ThingDef ParentName="MoteBase">
    <defName>SandWorm_ShockwaveDistortionMote</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.08</fadeInTime>
      <solidTime>0.55</solidTime>
      <fadeOutTime>1.05</fadeOutTime>
      <growthRate>7</growthRate>
    </mote>
    <graphicData>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>MoteLargeDistortionWave</shaderType>
      <shaderParameters>
        <_DistortionTex>/Things/Mote/PsychicDistortionCurrents</_DistortionTex>
        <_NoiseTex>/Things/Mote/PsycastNoise</_NoiseTex>
        <_distortionIntensity>0.34</_distortionIntensity>
        <_brightnessMultiplier>0.3</_brightnessMultiplier>
        <_noiseIntensity>0.1</_noiseIntensity>
      </shaderParameters>
      <drawSize>10</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
