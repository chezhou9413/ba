<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>SandWorm_SyndicateMoveSuppression</defName>
    <label>辛迪加沙阻</label>
    <description>辛迪加挑战空间里的深砂干扰正在拖慢这个小人的行动。</description>
    <hediffClass>Hediff</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <maxSeverity>3</maxSeverity>
    <stages>
      <li>
        <label>轻度沙阻</label>
        <minSeverity>0.5</minSeverity>
        <statFactors>
          <MoveSpeed>0.8</MoveSpeed>
        </statFactors>
      </li>
      <li>
        <label>中度沙阻</label>
        <minSeverity>1.5</minSeverity>
        <statFactors>
          <MoveSpeed>0.6</MoveSpeed>
        </statFactors>
      </li>
      <li>
        <label>重度沙阻</label>
        <minSeverity>2.5</minSeverity>
        <statFactors>
          <MoveSpeed>0.4</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SandWorm_SyndicateAimSuppression</defName>
    <label>辛迪加沙幕</label>
    <description>辛迪加挑战空间里的高密度沙幕正在干扰这个小人的瞄准。</description>
    <hediffClass>Hediff</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <maxSeverity>2</maxSeverity>
    <stages>
      <li>
        <label>轻度沙幕</label>
        <minSeverity>0.5</minSeverity>
        <statFactors>
          <ShootingAccuracyPawn>0.9</ShootingAccuracyPawn>
          <AimingDelayFactor>1.1</AimingDelayFactor>
        </statFactors>
      </li>
      <li>
        <label>重度沙幕</label>
        <minSeverity>1.5</minSeverity>
        <statFactors>
          <ShootingAccuracyPawn>0.78</ShootingAccuracyPawn>
          <AimingDelayFactor>1.25</AimingDelayFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
