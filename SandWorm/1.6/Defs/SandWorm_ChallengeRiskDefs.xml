<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_SmallWorm1</defName>
    <label>小沙虫增援 I</label>
    <description>挑战开始时，沙海巨虫会额外召来一条小型沙虫。</description>
    <level>1</level>
    <gridPosition>(0, 0)</gridPosition>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_SmallWorm1</iconPath>
    <effects>
      <li>
        <effectType>SpawnSmallWorm</effectType>
        <count>1</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_SmallWorm2</defName>
    <label>小沙虫增援 II</label>
    <description>在前置增援的基础上，再额外召来一条小型沙虫。</description>
    <level>2</level>
    <gridPosition>(1, 0)</gridPosition>
    <prerequisite>SandWorm_Risk_SmallWorm1</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_SmallWorm2</iconPath>
    <effects>
      <li>
        <effectType>SpawnSmallWorm</effectType>
        <count>1</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_SmallWorm3</defName>
    <label>小沙虫凶化 III</label>
    <description>所有由词条追加的小型沙虫获得头部秒杀能力，并提升 30% 生命值。</description>
    <level>3</level>
    <gridPosition>(2, 0)</gridPosition>
    <prerequisite>SandWorm_Risk_SmallWorm2</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_SmallWorm3</iconPath>
    <effects>
      <li>
        <effectType>SmallWormHeadInstantKill</effectType>
      </li>
      <li>
        <effectType>SmallWormHitPointFactor</effectType>
        <factor>1.3</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_ChargeFrenzy1</defName>
    <label>沙虫狂暴化 I</label>
    <description>沙海巨虫的冲锋冷却间隔降低 20%，更快进入下一次狂暴追击。</description>
    <level>1</level>
    <gridPosition>(0, 1)</gridPosition>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_ChargeFrenzy1</iconPath>
    <effects>
      <li>
        <effectType>ChargeCooldownFactor</effectType>
        <factor>0.8</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_ChargeFrenzy2</defName>
    <label>沙虫狂暴化 II</label>
    <description>沙海巨虫的冲锋冷却间隔降低 40%，狂暴追击会更频繁地压迫战场。</description>
    <level>2</level>
    <gridPosition>(1, 1)</gridPosition>
    <prerequisite>SandWorm_Risk_ChargeFrenzy1</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_ChargeFrenzy2</iconPath>
    <effects>
      <li>
        <effectType>ChargeCooldownFactor</effectType>
        <factor>0.6</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_ChargeFrenzy3</defName>
    <label>沙虫狂暴化 III</label>
    <description>沙海巨虫的冲锋冷却间隔降低 60%，会以极短间隔连续发动狂暴追击。</description>
    <level>3</level>
    <gridPosition>(2, 1)</gridPosition>
    <prerequisite>SandWorm_Risk_ChargeFrenzy2</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_ChargeFrenzy3</iconPath>
    <effects>
      <li>
        <effectType>ChargeCooldownFactor</effectType>
        <factor>0.4</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_DamageCap1</defName>
    <label>厚重甲壳 I</label>
    <description>沙海巨虫单次受到的最高伤害不超过 60 点。</description>
    <level>1</level>
    <gridPosition>(0, 2)</gridPosition>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_DamageCap1</iconPath>
    <effects>
      <li>
        <effectType>MaxIncomingDamagePerHit</effectType>
        <count>60</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_DamageCap2</defName>
