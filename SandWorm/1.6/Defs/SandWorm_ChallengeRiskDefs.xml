      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_DamageCap3</defName>
    <label>厚重甲壳 III</label>
    <description>沙海巨虫单次受到的最高伤害不超过 20 点。</description>
    <level>3</level>
    <gridPosition>(2, 2)</gridPosition>
    <prerequisite>SandWorm_Risk_DamageCap2</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_DamageCap3</iconPath>
    <effects>
      <li>
        <effectType>MaxIncomingDamagePerHit</effectType>
        <count>20</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_PawnRange1</defName>
    <label>压制火线 I</label>
    <description>参战小人的远程武器射程降低 10%。</description>
    <level>1</level>
    <gridPosition>(0, 3)</gridPosition>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_PawnRange1</iconPath>
    <effects>
      <li>
        <effectType>PawnRangeFactor</effectType>
        <factor>0.9</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_PawnRange2</defName>
    <label>压制火线 II</label>
    <description>参战小人的远程武器射程降低 30%。</description>
    <level>2</level>
    <gridPosition>(1, 3)</gridPosition>
    <prerequisite>SandWorm_Risk_PawnRange1</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_PawnRange2</iconPath>
    <effects>
      <li>
        <effectType>PawnRangeFactor</effectType>
        <factor>0.7</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_PawnRange3</defName>
    <label>压制火线 III</label>
    <description>参战小人的远程武器射程降低 50%。</description>
    <level>3</level>
    <gridPosition>(2, 3)</gridPosition>
    <prerequisite>SandWorm_Risk_PawnRange2</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_PawnRange3</iconPath>
    <effects>
      <li>
        <effectType>PawnRangeFactor</effectType>
        <factor>0.5</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_PawnMove1</defName>
    <label>深砂迟滞 I</label>
    <description>参战小人的移动速度降低 20%。</description>
    <level>1</level>
    <gridPosition>(0, 4)</gridPosition>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_PawnMove1</iconPath>
    <effects>
      <li>
        <effectType>PawnMoveSuppression</effectType>
        <count>1</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_PawnMove2</defName>
    <label>深砂迟滞 II</label>
    <description>参战小人的移动速度降低 40%。</description>
    <level>2</level>
    <gridPosition>(1, 4)</gridPosition>
    <prerequisite>SandWorm_Risk_PawnMove1</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_PawnMove2</iconPath>
    <effects>
      <li>
        <effectType>PawnMoveSuppression</effectType>
        <count>2</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_PawnMove3</defName>
    <label>深砂迟滞 III</label>
    <description>参战小人的移动速度降低 60%。</description>
    <level>3</level>
    <gridPosition>(2, 4)</gridPosition>
    <prerequisite>SandWorm_Risk_PawnMove2</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_PawnMove3</iconPath>
    <effects>
      <li>
        <effectType>PawnMoveSuppression</effectType>
        <count>3</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_ShockwaveAttack1</defName>
    <label>地脉冲击 I</label>
    <description>沙海巨虫获得周期性全图径向冲击波。释放前会隆起碎石墙作为掩体，未被遮挡的小人受到 100 点钝器伤害。</description>
    <level>1</level>
    <gridPosition>(0, 5)</gridPosition>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_ShockwaveAttack1</iconPath>
    <effects>
      <li>
        <effectType>EnableShockwaveAttack</effectType>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_ShockwaveAttack2</defName>
    <label>地脉共振 II</label>
    <description>地脉冲击的蓄能节奏加快，危险带更宽。沙海巨虫的冲击波冷却降低 25%，危险带宽度提高 15%。</description>
    <level>2</level>
    <gridPosition>(1, 5)</gridPosition>
    <prerequisite>SandWorm_Risk_ShockwaveAttack1</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_ShockwaveAttack2</iconPath>
    <effects>
      <li>
        <effectType>ShockwaveCooldownFactor</effectType>
        <factor>0.75</factor>
      </li>
      <li>
        <effectType>ShockwaveLaneWidthFactor</effectType>
        <factor>1.15</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_ShockwaveAttack3</defName>
    <label>地脉裂变 III</label>
    <description>地层回响进入失控裂变。冲击波冷却降低 45%，危险带宽度提高 30%，冲击波伤害提高 25%。</description>
    <level>3</level>
    <gridPosition>(2, 5)</gridPosition>
    <prerequisite>SandWorm_Risk_ShockwaveAttack2</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_ShockwaveAttack3</iconPath>
    <effects>
      <li>
        <effectType>ShockwaveCooldownFactor</effectType>
        <factor>0.55</factor>
      </li>
      <li>
        <effectType>ShockwaveLaneWidthFactor</effectType>
        <factor>1.3</factor>
      </li>
      <li>
        <effectType>ShockwaveDamageFactor</effectType>
        <factor>1.25</factor>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_SandBlind1</defName>
    <label>沙幕干扰 I</label>
    <description>辛迪加空间内的高密度沙幕干扰瞄准。参战小人的射击精度降低 10%，瞄准时间增加 10%。</description>
    <level>1</level>
    <gridPosition>(0, 6)</gridPosition>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_SandBlind1</iconPath>
    <effects>
      <li>
        <effectType>PawnAimSuppression</effectType>
        <count>1</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_SandBlind2</defName>
    <label>沙幕干扰 II</label>
    <description>沙幕干扰进一步压低远程火力。参战小人的射击精度降低 22%，瞄准时间增加 25%。</description>
    <level>2</level>
    <gridPosition>(1, 6)</gridPosition>
    <prerequisite>SandWorm_Risk_SandBlind1</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_SandBlind2</iconPath>
    <effects>
      <li>
        <effectType>PawnAimSuppression</effectType>
        <count>2</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_ResonancePressure1</defName>
    <label>共振倒计时 I</label>
    <description>战斗拖得越久，地下回响越容易引来增援。沙海巨虫出现 4800 tick 后，每 3600 tick 召来一条小型沙虫，最多触发 3 次。</description>
    <level>2</level>
    <gridPosition>(0, 7)</gridPosition>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_ResonancePressure1</iconPath>
    <effects>
      <li>
        <effectType>ResonanceEscalation</effectType>
        <count>1</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

  <SandWormLib.SandWormChallengeRiskDef>
    <defName>SandWorm_Risk_ResonancePressure2</defName>
    <label>共振倒计时 II</label>
    <description>地下共振更早失控。沙海巨虫出现 3600 tick 后，每 2400 tick 召来一条小型沙虫，最多触发 5 次；若已启用地脉冲击，会压缩下一次冲击波冷却。</description>
    <level>3</level>
    <gridPosition>(1, 7)</gridPosition>
    <prerequisite>SandWorm_Risk_ResonancePressure1</prerequisite>
    <iconPath>UI/SandWorm/Contract/Risks/SandWorm_Risk_ResonancePressure2</iconPath>
    <effects>
      <li>
        <effectType>ResonanceEscalation</effectType>
        <count>2</count>
      </li>
    </effects>
  </SandWormLib.SandWormChallengeRiskDef>

</Defs>
