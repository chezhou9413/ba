<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BANWlLib</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../Assemblies</OutputPath>
    <DebugType>none</DebugType>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">E:/steam/steamapps/common/RimWorld</RimWorldDir>
    <RimUnityRoot Condition="'$(RimUnityRoot)' == ''">E:/RimModDev/RimUnity</RimUnityRoot>
    <ChezhouLibRoot Condition="'$(ChezhouLibRoot)' == ''">E:/RimModDev/ChezhouLib</ChezhouLibRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Source/BANWlLib/**/*.cs" Exclude="../../../Source/BANWlLib/obj/**;../../../Source/BANWlLib/bin/**" />
    <Compile Include="**/*.cs" Exclude="obj/**;bin/**" />
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorldDir)/Waylith.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="../../../Source/References/Newtonsoft.Json.dll" Private="true" />
    <Reference Include="0Harmony" HintPath="$(RimWorldDir)/../../workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll" Private="false" />
    <Reference Include="AlienRace" HintPath="$(ChezhouLibRoot)/Source/.build/references/1.7/AlienRace.dll" Private="false" />
    <Reference Include="ChezhouLib" HintPath="$(ChezhouLibRoot)/1.7/Assemblies/ChezhouLib.dll" Private="false" />
    <Reference Include="ChezhouLib.RimUnity" HintPath="$(ChezhouLibRoot)/1.7/RimUnityCompat/Assemblies/ChezhouLib.RimUnity.dll" Private="false" />
    <Reference Include="RimUnity.Core" HintPath="$(RimUnityRoot)/1.7/Assemblies/RimUnity.Core.dll" Private="false" />
    <Reference Include="RimUnity" HintPath="$(RimUnityRoot)/1.7/Assemblies/RimUnity.dll" Private="false" />
    <Reference Include="RimUnity.Spine" HintPath="$(RimUnityRoot)/1.7/Assemblies/RimUnity.Spine.dll" Private="false" />
  </ItemGroup>
</Project>
