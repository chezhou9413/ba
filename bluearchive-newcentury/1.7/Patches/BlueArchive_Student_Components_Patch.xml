<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 
    为BA基沃托斯学生添加完整功能的补丁
    包含：自定义属性组件、光环减伤保护组件
    基于 BANWlLib 命名空间的组件系统
  -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[@Name="BANW_StudentThingBase"]/comps</xpath>
    <!-- 如果基类已经有comps节点，直接添加所有组件 -->
    <match Class="PatchOperationAdd">
      <xpath>Defs/AlienRace.ThingDef_AlienRace[@Name="BANW_StudentThingBase"]/comps</xpath>
      <value>
        <!-- 经验值系统组件 - 修正为原项目的属性配置 -->
        <li Class="BANWlLib.HumanIntPropertyCompProperties">
          <defaultValue>0</defaultValue>
          <minValue>0</minValue>
          <maxValue>330</maxValue>
        </li>
        <!-- 光环减伤组件 - 修正为原项目的属性配置 -->
        <li Class="BANWlLib.DamageReductionCompProperties">
          <!-- 减伤保护的身体部位：光环 -->
          <damageReductionBodyPart>Halo</damageReductionBodyPart>
          <!-- 自定义属性值阈值列表 - 对应星星等级 -->
          <customValueThresholds>
            <li>0</li>
            <!-- 1级阈值：0点 -->
            <li>30</li>
            <!-- 2级阈值：20点 -->
            <li>110</li>
            <!-- 3级阈值：40点 -->
            <li>210</li>
            <!-- 4级阈值：60点 -->
            <li>330</li>
            <!-- 5级阈值：80点 -->
          </customValueThresholds>
          <!-- 减伤比例列表 - 对应各等级的减伤和回复比例 -->
          <damageReductionRatios>
            <li>0</li>
            <!-- 1级：10%减伤+回复 -->
            <li>0.1</li>
            <!-- 2级：25%减伤+回复 -->
            <li>0.2</li>
            <!-- 3级：40%减伤+回复 -->
            <li>0.55</li>
            <!-- 4级：55%减伤+回复 -->
            <li>0.7</li>
            <!-- 5级：70%减伤+回复 -->
          </damageReductionRatios>
        </li>
      </value>
    </match>
    <!-- 如果基类还没有comps节点，先创建comps节点再添加所有组件 -->
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/AlienRace.ThingDef_AlienRace[@Name="BANW_StudentThingBase"]</xpath>
      <value>
        <comps>
          <!-- 经验值系统组件 - 修正为原项目的属性配置 -->
          <li Class="BANWlLib.HumanIntPropertyCompProperties">
            <defaultValue>0</defaultValue>
            <minValue>0</minValue>
            <maxValue>330</maxValue>
          </li>
          <!-- 光环减伤组件 - 修正为原项目的属性配置 -->
          <li Class="BANWlLib.DamageReductionCompProperties">
            <!-- 减伤保护的身体部位：光环 -->
            <damageReductionBodyPart>Halo</damageReductionBodyPart>
            <!-- 自定义属性值阈值列表 -->
            <customValueThresholds>
              <li>0</li>
              <!-- 1级阈值：0点 -->
              <li>30</li>
              <!-- 2级阈值：20点 -->
              <li>110</li>
              <!-- 3级阈值：40点 -->
              <li>210</li>
              <!-- 4级阈值：60点 -->
              <li>330</li>
              <!-- 5级阈值：80点 -->
            </customValueThresholds>
            <!-- 减伤比例列表 -->
            <damageReductionRatios>
              <li>0</li>
              <!-- 1级：10%减伤+回复 -->
              <li>0.1</li>
              <!-- 2级：25%减伤+回复 -->
              <li>0.2</li>
              <!-- 3级：40%减伤+回复 -->
              <li>0.55</li>
              <!-- 4级：55%减伤+回复 -->
              <li>0.7</li>
              <!-- 5级：70%减伤+回复 -->
            </damageReductionRatios>
          </li>
        </comps>
      </value>
    </nomatch>
  </Operation>
</Patch>
