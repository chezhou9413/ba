
<Defs>
  <AbilityDef>
<defName>BAWN_Kisaki_EX</defName>
 <label>敕令：修身齐家</label>
 <description>对1名我方单位赋予自身自愈力131%的护盾(持续17秒)</description>
 <iconPath>Ability/Icon/Kisaki/Kisaki_EX</iconPath>
 <cooldownTicksRange>2100</cooldownTicksRange>
 <hotKey>Misc12</hotKey>
 <warmupStartSound>Kisaki_Skill_EX</warmupStartSound>
 <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
 <stunTargetWhileCasting>False</stunTargetWhileCasting><!-- 施法时是否定身目标 -->  
 <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
 <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
 <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
 <targetRequired>true</targetRequired><!-- 对自己使用 -->
 <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
 <hostile>false</hostile><!-- 是否是敌对行为 -->
 <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
 <warmupEffecter>BANW_Kisaki_Ef_C</warmupEffecter>
 <verbProperties>
  <warmupEffecter>BANW_Effecter_NewA</warmupEffecter>
 <soundCast></soundCast>
 <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
 <drawAimPie>false</drawAimPie><!-- 不绘制瞄准圈 -->
 <range>69.9</range><!-- 作用范围：-1 表示只能近战接触 -->
 <warmupTime>1.5</warmupTime><!-- 前摇时间（单位：秒） -->
 <targetParams><!-- 目标参数设置 -->
  <canTargetSelf>false</canTargetSelf> <!-- 可以选自己 -->
  <canTargetPawns>true</canTargetPawns><!-- 不能选其他生物 -->
  <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
  <canTargetAnimals>true</canTargetAnimals> <!-- 不能选动物 -->
  <canTargetHumans>true</canTargetHumans><!-- 不能选人类 -->
  <canTargetMechs>false</canTargetMechs><!-- 不能选机械体 -->
  <neverTargetHostileFaction>true</neverTargetHostileFaction><!-- 只能选友军 -->
  </targetParams>
  </verbProperties>
  <comps>
   <li Class="BANWlLib.BattleSystem.CompProperties_AbilityApplyBattleAction">  <!-- 战斗动作应用组件：技能触发时执行指定的战斗动作 -->
        <applyToSelf>false</applyToSelf>  <!-- false=对目标生效（对友军施加护盾） -->
        <action>
          <isShield>true</isShield>  <!-- 标记为护盾效果 -->
          <shieldPowerRatio>1.31</shieldPowerRatio>  <!-- 护盾量倍率：护盾值 = 最终治愈力 × 3.28 -->
          <shieldHediffDef>BANW_BattleShield_Kisaki</shieldHediffDef>  <!-- 护盾对应的 Hediff 定义（承载护盾值的健康状态） -->
          <affectFriendly>true</affectFriendly>  <!-- 对友方生效 -->
          <affectHostile>false</affectHostile>  <!-- 不对敌方生效 -->
        </action>
      </li>
    </comps>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">  <!-- 战斗公式预览扩展：技能图标悬浮时显示护盾量预览 -->
        <showBattleFormula>true</showBattleFormula>  <!-- 是否在 Tooltip 中展开战斗公式 -->
        <previewActions>  <!-- 预览用动作配置，仅用于显示，不实际触发 -->
          <li>
            <isShield>true</isShield>
            <shieldPowerRatio>1.31</shieldPowerRatio>
            <shieldHediffDef>BANW_BattleShield_Kisaki</shieldHediffDef>
            <affectFriendly>true</affectFriendly>
            <affectHostile>false</affectHostile>
          </li>
        </previewActions>
      </li>
    </modExtensions>
</AbilityDef>
<HediffDef>
    <defName>BANW_BattleShield_Kisaki</defName>
    <label>护盾</label>
    <defaultLabelColor>(0,255,255)</defaultLabelColor>
    <description>吸收下一次受到的伤害，护盾不足时也会完整抵住本次伤害。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <makesSickThought>false</makesSickThought>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="BANWlLib.BattleSystem.HediffCompProperties_BattleShield" />
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>
          <min>1020</min>
          <max>1020</max>
        </disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Shield_Ef_A</stateEffecter>
      </li>
    </comps>
    <stages>
      <li>
        <label>护盾</label>
      </li>
    </stages>
  </HediffDef>
  <AbilityDef>
<defName>BAWN_Kisaki_EXX</defName>
