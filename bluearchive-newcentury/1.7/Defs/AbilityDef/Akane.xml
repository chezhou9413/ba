      <canHitOwnPawn>true</canHitOwnPawn>
      <canHitOwnBuilding>false</canHitOwnBuilding>
      <extraDamages>
        <li>
          <damageDef>BANC_Damage_guantong</damageDef>
          <attackPowerRatio>7.5</attackPowerRatio>
          <delayTicks>0</delayTicks>
          <penetration>2</penetration>
          <isNormalAttack>false</isNormalAttack>
          <canCrit>true</canCrit>
          <alwaysCrit>false</alwaysCrit>
          <alwaysShowCriticalText>true</alwaysShowCriticalText>
          <applyAffinity>true</applyAffinity>
          <isExSkill>false</isExSkill>
        </li>
      </extraDamages>
    </li>
  </modExtensions>
</ThingDef>

<AbilityDef>
  <defName>BAWN_Akane_EXX</defName>
  <label>清除，要优雅</label>
  <description>发射一枚单体子弹，造成自身攻击力890%的伤害，命中后追加7段从低到高递增的必定暴击伤害，并使目标乘伤系数增加30%（持续30秒）。</description>
  <iconPath>Ability/Icon/Akane/Akane_EXX</iconPath>
  <cooldownTicksRange>1000</cooldownTicksRange>
  <hotKey>Misc12</hotKey>
  <warmupStartSound>Akane_ExSkill</warmupStartSound>
  <!-- 是否显示心灵异能特效（如光束、粒子） -->
  <showPsycastEffects>False</showPsycastEffects>
  <!-- 施法时是否定身目标 -->
  <stunTargetWhileCasting>false</stunTargetWhileCasting>
  <!-- 未征召状态下是否显示操作按钮 -->
  <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
  <!-- 未征召状态下是否禁用按钮 -->
  <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
  <uiOrder>5</uiOrder>
  <targetRequired>True</targetRequired>
  <!-- 是否在征召状态时显示 -->
  <showWhenDrafted>True</showWhenDrafted>
  <!-- 是否是敌对行为 -->
  <hostile>true</hostile>
  <!-- 施法者是否必须能进行暴力行为 -->
  <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
  <verbProperties>
    <!-- 前摇特效 -->
    <soundCast>Akane_ExxSkill</soundCast>
    <!-- 带目标预览的施法 Verb -->
    <verbClass>BANWlLib.BaVerb.Verb_CastAbilityWithTargetPreview</verbClass>
    <!-- 作用范围：-1 表示只能近战接触 -->
    <range>27.9</range>
    <!-- 前摇时间（单位：秒） -->
    <warmupTime>1.0</warmupTime>
    <requireLineOfSight>true</requireLineOfSight>
    <targetParams>
      <canTargetLocations>false</canTargetLocations>
      <!-- 可以选自己 -->
      <canTargetSelf>false</canTargetSelf>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>false</canTargetBuildings>
      <canTargetAnimals>true</canTargetAnimals>
      <canTargetHumans>true</canTargetHumans>
      <canTargetMechs>true</canTargetMechs>
    </targetParams>
  </verbProperties>
  <comps>
    <li Class="CompProperties_AbilityLaunchProjectile">
      <projectileDef>Akane_Bullt_EXX</projectileDef>
    </li>
  </comps>
  <modExtensions>
    <!-- 目标预览圈配置 -->
    <li Class="BANWlLib.BaVerb.AbilityTargetPreviewExtension">
      <shape>Circle</shape>
      <range>27.9</range>
      <drawCasterRange>true</drawCasterRange>
      <drawTargetHighlight>true</drawTargetHighlight>
    </li>
    <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
      <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
      <showBattleFormula>true</showBattleFormula>
      <!-- 悬浮预览用的战斗段配置，只用于显示公式，不直接造成伤害。 -->
      <previewActions>
        <li>
          <!-- 最终攻击力倍率：8.9 = 造成 890% 攻击力伤害 -->
          <attackPowerRatio>8.9</attackPowerRatio>
          <!-- 伤害类型 -->
          <damageDef>BANC_Damage_guantong</damageDef>
          <!-- 是否普通攻击（false = 走技能伤害计算） -->
          <isNormalAttack>false</isNormalAttack>
          <!-- 是否允许暴击 -->
          <canCrit>true</canCrit>
          <!-- 是否必定暴击 -->
          <alwaysCrit>false</alwaysCrit>
          <!-- 是否始终显示暴击字样 -->
          <alwaysShowCriticalText>true</alwaysShowCriticalText>
          <!-- 是否应用攻击类型与护甲类型克制 -->
          <applyAffinity>true</applyAffinity>
          <isExSkill>true</isExSkill>
        </li>
      </previewActions>
    </li>
  </modExtensions>
</AbilityDef>

<!-- ===== 茜 EXX 技能子弹（多段射击模板） ===== -->
<ThingDef ParentName="BaseBullet">
  <defName>Akane_Bullt_EXX</defName>
  <label>茜子弹</label>
  <!-- 弹道类，飞向目标后触发命中判定 -->
  <thingClass>Bullet</thingClass>
  <graphicData>
    <drawSize>(1,3)</drawSize>
    <texPath>Projectile/Bullet_Akane_EX</texPath>
    <graphicClass>Graphic_Single</graphicClass>
  </graphicData>
  <projectile>
    <!-- 主段伤害类型 -->
    <damageDef>BANC_Damage_Akane</damageDef>
    <!-- 主段基础伤害 -->
    <damageAmountBase>10</damageAmountBase>
    <!-- 主段护甲穿透 -->
    <armorPenetrationBase>2</armorPenetrationBase>
    <!-- 停止力：>=1 命中后子弹消失 -->
    <stoppingPower>2</stoppingPower>
    <!-- 飞行速度（格/秒） -->
    <speed>100</speed>
  </projectile>
  <modExtensions>
    <!-- 战斗属性扩展：控制该弹道的暴击/克制/普攻判定 -->
    <li Class="BANWlLib.BattleSystem.BattleProjectileExtension">
      <!-- 主段攻击力倍率：8.9 = 890%。非普攻时缺这行伤害为 0 -->
      <attackPowerRatio>8.9</attackPowerRatio>
      <!-- 是否普通攻击（false = 技能伤害） -->
      <isNormalAttack>false</isNormalAttack>
      <!-- 精通倍率基数 -->
      <baseMasteryMultiplier>1.0</baseMasteryMultiplier>
      <!-- 是否允许暴击 -->
      <canCrit>true</canCrit>
      <!-- 是否应用攻击类型与护甲类型克制 -->
      <applyAffinity>true</applyAffinity>
    </li>
    <!-- 多段追加伤害扩展 -->
    <li Class="BANWlLib.BattleSystem.ProjectileMultiHitExtension">
      <!-- 各段之间的基础间隔（tick） -->
      <damageIntervalTicks>6</damageIntervalTicks>
      <!-- 追加伤害是否可命中同阵营 Pawn -->
      <canHitOwnPawn>true</canHitOwnPawn>
      <!-- 追加伤害是否可命中同阵营建筑 -->
      <canHitOwnBuilding>false</canHitOwnBuilding>
      <extraDamages>
        <!-- 第1段追加伤害 -->
        <li>
          <damageDef>BANC_Damage_Akane</damageDef>
          <!-- 该段攻击力倍率，缺这行伤害为 0 -->
          <attackPowerRatio>8.9</attackPowerRatio>
          <!-- 命中后延迟多少 tick 结算 -->
          <delayTicks>0</delayTicks>
          <!-- 该段护甲穿透 -->
          <penetration>2</penetration>
          <!-- 是否普通攻击 -->
          <isNormalAttack>false</isNormalAttack>
          <!-- 是否允许暴击 -->
          <canCrit>true</canCrit>
          <!-- 是否必定暴击 -->
          <alwaysCrit>false</alwaysCrit>
          <!-- 是否始终显示暴击字样 -->
          <alwaysShowCriticalText>true</alwaysShowCriticalText>
          <!-- 是否应用攻击类型与护甲类型克制 -->
          <applyAffinity>true</applyAffinity>
          <!-- 该段是否额外乘 EX 技能倍率 -->
          <isExSkill>true</isExSkill>
        </li>
      </extraDamages>
    </li>
  </modExtensions>
</ThingDef>

<HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Akane_HediffDef</defName>
        <!-- 显示名称 -->
