<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 临战爱丽丝EX：三档对敌表现、两档自身充能与固定直线多段伤害。 -->
  <BANWlLib.Skills.SpecialSkillProfileDef>
    <!-- 技能档案唯一标识，供 AbilityDef 的 comps 引用。 -->
    <defName>BANW_Special_Arisu</defName>
    <!-- 档案显示名。 -->
    <label>临战爱丽丝</label>
    <!-- 归属角色标识（用于匹配角色资源/图标）。 -->
    <role>Arisu</role>
    <!-- 该档案绑定的主技能 Def。 -->
    <primaryAbility>BANW_Special_Arisu_Ex</primaryAbility>
    <range>40.9</range>
    <arisu>
      <lineLength>40.9</lineLength>
      <lineWidth>3</lineWidth>
      <!-- 首段额外延迟；实际首段在施法后的第1加damageDelayTicks个tick结算。 -->
      <damageDelayTicks>160</damageDelayTicks>
      <!-- 自身充能前摇，60 tick 为1秒；chargeEffecters在前摇开始时播放。 -->
      <chargeWarmupTicks>60</chargeWarmupTicks>
      <!-- 对敌使用时按当前0、1、2档选择A、B、C，仅触发所选一项。 -->
      <attackEffecters>
        <li>BANW_Arisu_B_Ef_C</li>
        <li>BANW_Arisu_B_Ef_D</li>
        <li>BANW_Arisu_B_Ef_E</li>
      </attackEffecters>
      <!-- 对自己使用时按升至第1档、第2档分别播放，不使用对敌特效。 -->
      <chargeEffecters>
        <li>BANW_Arisu_B_Ef_A</li>
        <li>BANW_Arisu_B_Ef_B</li>
      </chargeEffecters>
      <attackSound>Arisu_B_Skill_EXX_A</attackSound>
      <chargeSound></chargeSound>
      <!-- 自动普通技能拥有独立Def、伤害、触发次数、冷却、声音和特效。 -->
      <normalSkill>BANW_Special_Arisu_Normal</normalSkill>
    </arisu>
    <exAttack>
      <!-- 总倍率由shots均分；关闭BA时改用basePower作为攻击基数。 -->
      <useBattleStats>true</useBattleStats>
      <!-- 未启用 BA 战斗数值时使用的固定攻击基数。 -->
      <basePower>100</basePower>
      <!-- 攻击力倍率，13 = 1300%。 -->
      <attackPowerRatio>53.2</attackPowerRatio>
      <!-- 使用的伤害 Def。 -->
      <damageDef>BANC_Damage_Arisu_B_EXX</damageDef>
      <!-- 本段每次伤害的护甲穿透：0.5为50%，不随连射发数均分。 -->
      <penetration>2</penetration>
      <isExSkill>true</isExSkill>
      <!-- 允许暴击。 -->
      <canCrit>true</canCrit>
      <!-- 结算时应用属性克制/亲和加成。 -->
      <applyAffinity>true</applyAffinity>
      <!-- 直线范围由arisu配置；直接范围结算，不生成追踪弹丸。 -->
      <radius>0</radius>
      <shots>22</shots>
      <shotIntervalTicks>6</shotIntervalTicks>
      <affectHostile>true</affectHostile><!-- 允许选择和伤害敌对及无阵营生物 -->
      <affectFriendly>false</affectFriendly><!-- 改为true可选择和伤害中立及友好阵营生物 -->
      <canHitOwnPawn>false</canHitOwnPawn><!-- 改为true可选择和伤害己方生物；点击自己仍用于充能 -->
    </exAttack>
  </BANWlLib.Skills.SpecialSkillProfileDef>
  <AbilityDef>
    <!-- 技能唯一标识。 -->
    <defName>BANW_Special_Arisu_Ex</defName>
    <label>光之勇者</label>
    <description>对自己使用时:能量充能状态提升至1阶充能.
- 能量充能状态为1阶充能时：能量充能状态提升至2阶充能.
对敌人使用时:对直线范围内的敌人造成- 造成自身攻击力1330%的伤害。
※ 能量充能状态为1阶充能时，效果提升至2倍.
※ 能量充能状态为2阶充能时，效果提升至3倍.
- 该技能结束后：重置自身能量充能状态为0阶充能</description>
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <jobDef>BANW_Job_ArisuExChannel</jobDef>
    <!-- 技能图标路径。 -->
    <iconPath>Ability/Icon/Arisu_B/Arisu_EXX</iconPath>
    <!-- 冷却时间（tick），60 = 1 秒。 -->
    <cooldownTicksRange>600</cooldownTicksRange>
    <!-- 未征召时也显示技能按钮。 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <!-- 未征召时按钮不可点击。 -->
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <!-- 征召状态下显示该技能。 -->
    <showWhenDrafted>true</showWhenDrafted>
    <!-- 不显示心灵能力相关特效。 -->
    <showPsycastEffects>false</showPsycastEffects>
    <!-- 非敌对技能（不会自动选中敌人为目标）。 -->
    <hostile>false</hostile>
    <!-- 必须选择目标才能释放。 -->
    <targetRequired>true</targetRequired>
    <!-- 施法者无需具备暴力能力也可使用。 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>BANWlLib.Skills.Verb_ArisuSpecialSkill</verbClass>
      <range>40.9</range>
      <warmupTime>0</warmupTime>
      <targetParams>
        <!-- 可对自己释放（用于充能）。 -->
        <canTargetSelf>true</canTargetSelf>
        <!-- 可选中人类/动物/机械等 Pawn 类型。 -->
        <canTargetPawns>true</canTargetPawns>
        <canTargetHumans>true</canTargetHumans>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <!-- 不能选建筑或空地。 -->
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- 特殊技能组件：绑定档案并声明为 EX 指令。 -->
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <profile>BANW_Special_Arisu</profile>
        <command>Ex</command>
      </li>
      <!-- COST 消耗组件：每次 EX 消耗 4 点。 -->
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost">
        <cost>4</cost>
      </li>
    </comps>
  </AbilityDef>
  <JobDef>
    <defName>BANW_Job_ArisuExChannel</defName>
    <driverClass>BANWlLib.Skills.JobDriver_ArisuExChannel</driverClass>
    <reportString>正在施放爱丽丝EX。</reportString>
    <abilityCasting>true</abilityCasting>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>
  <DamageDef ParentName="BANC_Damage_shenmi">
    <defName>BANC_Damage_Arisu_B_EXX</defName>
    <damageEffecter>BANW_Effecter_Arisu_EXS</damageEffecter>
 <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} 死于神秘伤害</deathMessage>
    <hediff>Gunshot</hediff>
    <armorCategory>Sharp</armorCategory>
    <hasForcefulImpact>true</hasForcefulImpact>
    <harmAllLayersUntilOutside>False</harmAllLayersUntilOutside>
    <impactSoundType>Bullet</impactSoundType>
    <overkillPctToDestroyPart>0~0.1</overkillPctToDestroyPart>
    <stabChanceOfForcedInternal>0.4</stabChanceOfForcedInternal>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
  </DamageDef>

  <EffecterDef>
<defName>BANW_Effecter_Arisu_EXS</defName>
<children>
      <li>
        <subEffecterClass>SubEffecter_CameraShakeSingle</subEffecterClass>
        <cameraShake>1</cameraShake>
      </li>
       <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Arisu_B_Skill_EXXS</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
</children>
</EffecterDef>
</Defs>
