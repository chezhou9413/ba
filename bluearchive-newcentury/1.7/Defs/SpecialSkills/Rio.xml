<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 莉音技能配置：独立EX复制、友军攻击增益与特效。 -->
  <!-- 复制入口不造成伤害；复制EX的每个伤害段沿用原技能对应攻击配置的penetration。 -->
  <BANWlLib.Skills.SpecialSkillProfileDef>
    <!-- 档案名，由技能组件的 profile 与角色配置引用。 -->
    <defName>BANW_Special_Rio</defName>
    <!-- 档案显示名。 -->
    <label>莉音</label>
    <!-- 角色键，代码据此走 Rio 分支（复制入口逻辑）。 -->
    <role>Rio</role>
    <!-- 主EX技能：复制入口。 -->
    <primaryAbility>BANW_Special_Rio_Ex</primaryAbility>
    <!-- 复制目标的选取射程，单位格。 -->
    <range>25</range>
    <!-- 普通技能自动施放间隔，1800 tick = 30 秒。 -->
    <normalIntervalTicks>1800</normalIntervalTicks>
    <!-- 影响半径；莉音流程未读取该值，保留默认 3 格。 -->
    <radius>3</radius>
    <!-- 复制机会附带的攻击支援持续时间，1800 tick = 30 秒。 -->
    <durationTicks>1800</durationTicks>
    <!-- 友军增益状态：TimedSkillBuff，提高攻击力，经 TimedSkillBuff.Apply 按 durationTicks 计时移除。 -->
    <buffHediff>BANW_SpecialRioBuff</buffHediff>
    <!-- 施法者身上朝目标播放的指向性施法特效。 -->
    <casterEffecter></casterEffecter>
    <!-- 施放瞬间在目标位置播放的特效。 -->
    <targetEffecter></targetEffecter>
    <!-- 阶段变化时播放的特效。 -->
    <stageEffecter></stageEffecter>
    <!-- 技能结束／结算时在目标身上播放的特效。 -->
    <endEffecter></endEffecter>
    <!-- 状态存续期间循环播放的特效。 -->
    <stateEffecter></stateEffecter>
  </BANWlLib.Skills.SpecialSkillProfileDef>
  <AbilityDef>
    <!-- 复制入口技能名，必须与上面的 primaryAbility 一致。 -->
    <defName>BANW_Special_Rio_Ex</defName>
    <!-- 技能按钮显示名。 -->
    <label>老大姐</label>
    <!-- 技能说明，显示在按钮提示与信息面板。 -->
    <description>选中1名我方单位，技能牌复制为选中目标的技能牌(使用1次后还原),
※ 复制的技能牌遵从选中目标技能牌的状态.
※ 复制的技能牌的基础COST为（选中目标的该EX技能的基础COST-1），
最小为0.攻击力增加51%（持续20秒）</description>
    <!-- 技能逻辑类，负责读取技能档案与执行复制。 -->
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <!-- 技能按钮图标。 -->
    <iconPath>Ability/Icon/Rio/Rio_EXX</iconPath>
    <!-- 冷却 600 tick = 10 秒，只限制复制入口本身的再次施放。 -->
    <cooldownTicksRange>600</cooldownTicksRange>
    <warmupStartSound>Rio_Skill_EXX</warmupStartSound>
    <!-- 未征召时也显示按钮。 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <!-- 未征召时按钮置灰不可点。 -->
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <!-- 征召状态下显示按钮。 -->
    <showWhenDrafted>true</showWhenDrafted>
    <warmupEffecter>BANW_Rio_Ef_C</warmupEffecter>
    <!-- 不播放心灵能力的施法光效，表现交给档案里的特效槽位。 -->
    <showPsycastEffects>false</showPsycastEffects>
    <!-- 非敌对技能，不会引起敌对或袭击判定。 -->
    <hostile>false</hostile>
    <!-- 必须选中一个目标才能施放。 -->
    <targetRequired>true</targetRequired>
    <!-- 无法暴力（如重伤倒地规则）时依然允许施放。 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
       <soundCast>Aoba_Skill_EX</soundCast>
      <warmupEffecter>BANW_Rio_Ef_B</warmupEffecter>
      <!-- 用普通施法动词承载瞄准与射程，实际效果由技能类处理。 -->
      <verbClass>Verb_CastAbility</verbClass>
      <!-- 动词射程，需与档案 range 保持一致。 -->
      <range>69.9</range>
      <!-- 前摇 0 秒，选中目标即刻发动。 -->
      <warmupTime>5</warmupTime>
      <!-- 目标筛选：只给其他存活的友军生物，不能选自己、建筑或空地。 -->
      <targetParams>
        <!-- 不能选自己。 -->
        <canTargetSelf>false</canTargetSelf>
        <!-- 可选人形与动物等生物。 -->
        <canTargetPawns>true</canTargetPawns>
        <canTargetHumans>true</canTargetHumans>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <!-- 不能选建筑。 -->
        <canTargetBuildings>false</canTargetBuildings>
        <!-- 不能选空地，必须有目标实体。 -->
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- 技能档案组件：绑定档案并声明这是 EX 指令。 -->
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <profile>BANW_Special_Rio</profile>
        <command>Ex</command>
      </li>
      <!-- COST 消耗组件：复制入口的基础费用，此处为 2 COST。 -->
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost">
        <cost>2</cost>
      </li>
    </comps>
  </AbilityDef>
  <HediffDef>
    <!-- 复制机会状态，由 RioSkills 在选中的友军身上添加，过期或使用后移除。 -->
    <defName>BANW_RioCopy</defName>
    <!-- 状态显示名。 -->
    <label>莉音EX复制机会</label>
    <!-- 状态说明。 -->
    <description>由本体执行一次复制EX，沿用当前阶段与属性，基础COST减1。右键复制技能按钮可选择其他EX。</description>
    <!-- 状态逻辑类：在目标身上挂出复制按钮并维护复制实例。 -->
    <hediffClass>BANWlLib.Skills.Hediff_RioCopy</hediffClass>
    <!-- 正面状态，按增益显示。 -->
    <isBad>false</isBad>
    <!-- 初始严重度，作为显示与取值的基准值。 -->
    <initialSeverity>1</initialSeverity>
    <!-- 不能被道具治愈，只能使用、过期或目标失效时移除。 -->
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <!-- 复制机会 1200 tick = 20 秒后自动失效，并在健康面板显示剩余时间。 -->
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>1200</disappearsAfterTicks>
      </li>
      <!-- 复制机会存续期间循环播放的状态特效。 -->
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Effecter_B</stateEffecter>
      </li>
    </comps>
  </HediffDef>
</Defs>
