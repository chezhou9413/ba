<Defs>
  <!-- 若藻技能配置：伤害标记、蓄积上限、持续时间与特效。 -->
  <BANWlLib.Skills.SpecialSkillProfileDef>
    <defName>BANW_Special_Wakamo</defName><label>若藻</label><role>Wakamo</role>
    <primaryAbility>BANW_Special_Wakamo_Ex</primaryAbility>
    <range>25</range><normalIntervalTicks>1800</normalIntervalTicks>
    <radius>3</radius>
    <durationTicks>600</durationTicks>
    <recordRatio>1</recordRatio>
    <recordCapRatio>13.22</recordCapRatio>
    <!-- 由EX实际伤害附加到所选目标身上的蓄积状态。 -->
    <buffHediff>BANW_WakamoAccumulation</buffHediff>
    <casterEffecter>BANW_Effecter_A</casterEffecter>
    <targetEffecter>BANW_Effecter_C</targetEffecter>
    <stageEffecter>BANW_Effecter_B</stageEffecter>
    <endEffecter>BANW_Effecter_C</endEffecter>
    <stateEffecter>BANW_Effecter_B</stateEffecter>
    <exAttack>
      <!-- 总倍率由shots均分；关闭BA时改用basePower作为攻击基数。 -->
      <useBattleStats>true</useBattleStats>
      <basePower>100</basePower>
      <attackPowerRatio>1</attackPowerRatio>
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 本段每次伤害的护甲穿透：0.5为50%，不随连射发数均分。 -->
      <penetration>0</penetration>
      <isExSkill>true</isExSkill>
      <canCrit>true</canCrit>
      <applyAffinity>true</applyAffinity>
      <radius>0</radius>
      <shots>6</shots>
      <shotIntervalTicks>6</shotIntervalTicks>
      <projectileDef>BANW_SpecialSkillBullet</projectileDef>
      <effecterDef>BANW_Effecter_C</effecterDef>
      <affectHostile>true</affectHostile><!-- 允许选择和伤害敌对及无阵营生物 -->
      <affectFriendly>false</affectFriendly><!-- 改为true可选择和伤害中立及友好阵营生物 -->
      <canHitOwnPawn>false</canHitOwnPawn><!-- 改为true可选择和伤害己方生物 -->
    </exAttack>
    <burstAttack>
      <!-- 累计伤害作为基础，按若藻BA输出、暴击、克制与EX倍率换算，再显示于敌方状态。 -->
      <useBattleStats>true</useBattleStats>
      <basePower>100</basePower>
      <attackPowerRatio>1</attackPowerRatio>
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 本段每次伤害的护甲穿透：0.5为50%，不随连射发数均分。 -->
      <penetration>0</penetration>
      <isExSkill>true</isExSkill>
      <canCrit>true</canCrit>
      <applyAffinity>true</applyAffinity>
      <radius>0</radius>
      <shots>1</shots>
      <shotIntervalTicks>6</shotIntervalTicks>
      <!-- 此段直接结算，不生成弹丸。 -->
      <effecterDef>BANW_Effecter_C</effecterDef>
      <!-- 蓄积爆发独立过滤目标；需要完整攻击同类目标时，与exAttack的阵营开关一起设置。 -->
      <affectHostile>true</affectHostile>
      <affectFriendly>false</affectFriendly>
      <canHitOwnPawn>false</canHitOwnPawn>
    </burstAttack>
  </BANWlLib.Skills.SpecialSkillProfileDef>
  <AbilityDef>
    <defName>BANW_Special_Wakamo_Ex</defName>
    <label>测试新技能·若藻</label>
    <description>向25格内配置允许的生物连续发射6发单体子弹，基础总伤害为攻击力100%，每发独立进行BA伤害结算。首次造成实际伤害时，在目标身上附加持续10秒的蓄积状态；该发伤害、后续子弹及同阵营友军造成的实际扣血都会计入。闪避、护盾或护甲完全抵挡的伤害不计入。默认允许敌对及无阵营生物。

原始累计上限为施法时攻击力的1322%。累计伤害作为爆发基础，再按若藻的BA输出倍率、暴击、克制和EX加成计算待释放值。标记建立时锁定本次换算与暴击结果，敌方状态实时显示待释放伤害、上限、类型和剩余时间。

到期时按显示值释放一次单体伤害，不重复乘算BA倍率；目标仍可通过闪避、护甲与护盾影响最终扣血。连射和爆发的damageDef、护甲穿透均可分别配置。蓄积爆发不能再次被蓄积。

再次施放会重新开始记录，不提前引爆旧记录。目标死亡或离开地图时取消记录。

基础消耗：4 COST。冷却：1秒。</description>
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <iconPath>UI/StarIcon</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
