        <li>BAWC_TraitDef_Hoshiro_B_A</li>
        <li>BAWC_TraitDef_Hoshiro_B_C</li>
      </outputTraits>
      <tankTraits>
        <li>BAWC_TraitDef_Hoshiro_B_B</li>
        <li>BAWC_TraitDef_Hoshiro_B_D</li>
