<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 星野测试技能配置；按钮在HoshinoAbilities.xml，定向特效在HoshinoEffects.xml。 -->
  <BANWlLib.Skills.SpecialSkillProfileDef>
    <!-- 技能档案唯一标识，供 AbilityDef 的 comps 引用。 -->
    <defName>BANW_Special_Hoshino</defName>
    <!-- 档案显示名。 -->
    <label>双形态星野</label>
    <!-- 归属角色标识（用于匹配角色资源/图标）。 -->
    <role>Hoshino</role>
    <!-- 主技能（输出形态）的 Def。 -->
    <primaryAbility>BANW_Special_Hoshino_Ex</primaryAbility>
    <!-- 副技能（坦克形态）的 Def。 -->
    <alternateAbility>BANW_Special_Hoshino_AlternateEx</alternateAbility>
    <!-- 形态切换技能的 Def。 -->
    <switchAbility>BANW_Special_Hoshino_SwitchForm</switchAbility>
    <!-- 技能可瞄准距离（格），目标超此距离无法施放。 -->
    <range>39.9</range>
    <!-- 默认效果半径（格），供范围结算与特效使用。 -->
    <radius>3</radius>
    <!-- 形态状态持续时间，2400 tick = 40 秒。 -->
    <durationTicks>2400</durationTicks>
    <!-- 输出形态的基础攻击力（BA 战斗属性结算用）。 -->
    <outputBaseAttack>6</outputBaseAttack>
    <!-- 防御形态的基础攻击力。 -->
    <tankBaseAttack>12</tankBaseAttack>
    <!-- 输出形态的基础生命，除以 100 后作为生命倍率（1000 = 10 倍）。 -->
    <outputBaseHealth>100</outputBaseHealth>
    <!-- 防御形态的基础生命，除以 100 后作为生命倍率（3000 = 30 倍）。 -->
    <tankBaseHealth>300</tankBaseHealth>
    <!-- EX 准备时间由 HoshinoAbilities.xml 的 warmupTime 设置，6 tick 对应 0.1 秒。 -->
    <!-- 准备期间承伤系数减去的数值（0.85），最低为 0。 -->
    <damageTakenReduction>0.85</damageTakenReduction>
    <!-- 防御普通技能状态的承受伤害次数，实际掉血满 25 次后解除。 -->
    <tankHits>25</tankHits>
    <!-- 护盾上限占最大生命的比例（0.691 = 69.1%）。 -->
    <shieldRatio>0.691</shieldRatio>
    <!-- 护盾是否走 BA 战斗属性结算。 -->
    <shieldUseBattleStats>true</shieldUseBattleStats>
    <!-- 不走 BA 时的护盾基础值。 -->
    <shieldBasePower>1000</shieldBasePower>
    <!-- 防御EX位移速度（格/tick），位移耗时 = 距离 ÷ 该值。 -->
    <moveSpeed>0.35</moveSpeed>
