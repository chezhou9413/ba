<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 运行状态与对决标记使用独立实例，数值通过当前版本存档保存。 -->
  <HediffDef>
    <defName>BANW_SpecialSkillRuntime</defName>
    <label>测试新技能状态</label>
    <description>记录角色特殊技能的阶段、层数、剩余命中次数和伤害蓄积。选中此状态可查看当前技能进度。</description>
    <hediffClass>BANWlLib.Skills.Hediff_SpecialSkillState</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>
  <HediffDef>
    <defName>BANW_NeroDuel</defName>
    <label>对决</label>
    <defaultLabelColor>(255,255,0)</defaultLabelColor>
    <description>对决标记本身不提高EX倍率。妮露处于对决阶段且双方标记有效时，攻击带有对决标记的敌人获得额外伤害；倍率由妮露技能配置决定。自身对决阶段结束时，二阶段EX与锐气层数一并重置。</description>
    <hediffClass>BANWlLib.Skills.Hediff_NeroDuel</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
  </HediffDef>
  <HediffDef>
    <defName>BANW_SpecialRioBuff</defName>
    <label>莉音攻击支援</label>
    <description>受到莉音的攻击支援，暂时提高攻击力。</description>
    <hediffClass>BANWlLib.Skills.TimedSkillBuff</hediffClass>
    <defaultLabelColor>(255,255,0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <statOffsets>
          <BANW_FinalDamageMultiplier>0.5</BANW_FinalDamageMultiplier>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>BANW_SpecialHoshinoBuff</defName>
    <label>加强防御态势</label>
    <description>攻击力增加156%(持续40秒)</description>
    <defaultLabelColor>(255,255,0)</defaultLabelColor>
    <hediffClass>BANWlLib.Skills.TimedSkillBuff</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <statOffsets>
          <BANW_FinalDamageMultiplier>1.56</BANW_FinalDamageMultiplier>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  
  <HediffDef>
    <defName>BANW_SpecialHoshinoCount</defName>
    <label>更换护甲</label>
    <description>防弹护板在自身受到25次伤害后解除,承伤系数减少24%。</description>
    <defaultLabelColor>(255,255,0)</defaultLabelColor>
    <hediffClass>BANWlLib.Skills.TimedSkillBuff</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <!-- 在此填写需要的属性加成，计数归零由角色技能移除状态。 -->
    <stages>
      <li>
        <statOffsets>
          <IncomingDamageFactor>-0.24</IncomingDamageFactor>
      </statOffsets>
      </li>
    </stages>
    <comps>

      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Hoshiro_B_D_Ef</stateEffecter>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>BANW_SpecialHoshinoShield</defName>
    <label>加强防御态势</label>
    <defaultLabelColor>(255,255,0)</defaultLabelColor>
    <description>加强防御态势提供的护盾，吸收受到的攻击。护盾耗尽、持续时间结束或切换形态时解除。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="BANWlLib.Skills.HediffCompProperties_HoshinoShield" />
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Hoshiro_B_D_Ef_C</stateEffecter>
      </li>
    </comps>
  </HediffDef>
  <ThingDef ParentName="BaseBullet">
    <defName>BANW_SpecialSkillBullet</defName>
    <label>测试技能弹丸</label>
    <thingClass>BANWlLib.Skills.Projectile_SpecialSkill</thingClass>
    <graphicData>
      <texPath>Projectile/Bullet_Nero</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(0.4,0.8)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>BANC_Damage_shenmi</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>70</speed>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="PawnFlyerBase">
    <defName>BANW_SpecialHoshinoFlyer</defName>
    <label>星野技能位移</label>
    <thingClass>BANWlLib.Skills.HoshinoMovementFlyer</thingClass>
    <pawnFlyer>
      <flightSpeed>12</flightSpeed>
      <workerClass>PawnFlyerWorker</workerClass>
      <flightDurationMin>0.1</flightDurationMin>
      <heightFactor>0</heightFactor>
    </pawnFlyer>
  </ThingDef>
</Defs>
