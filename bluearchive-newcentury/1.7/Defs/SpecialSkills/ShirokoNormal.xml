<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    黑子（Shiroko）EX期间的普通技能定义。
    只由 EX 状态自动触发，不注册主动按钮，也不出现在能力列表里。
    一轮流程：前摇 → 锁定攻击属性快照 → 投掷跟踪手榴弹 → 无人机按 droneShots 逐发连射。
    手榴弹与每一发无人机的倍率、伤害类型、穿透、弹丸、音效互相独立。
  -->
  <BANWlLib.Skills.ShirokoNormalSkillDef>
    <!-- 配置档唯一标识，被 BANW_Special_Shiroko 的 shiroko.normalSkill 引用。 -->
    <defName>BANW_Special_Shiroko_Normal</defName>
    <!-- 调试与日志显示名。 -->
    <label>无人机协同投掷</label>
    <!-- 面向玩家的机制说明。 -->
    <description>EX期间自动瞄准最近的可见敌人，投掷跟踪手榴弹并由无人机逐发连射。</description>

    <!-- 自动索敌半径（格），超出该距离或没有视线的敌人不会被选为目标。 -->
    <range>33.9</range>
    <!-- 两次普通技能之间的间隔（tick）：2400 tick = 40 秒。 -->
    <cooldownTicks>2400</cooldownTicks>
    <!-- 前摇时长（tick）：100 tick = 2 秒，前摇结束时锁定本轮攻击属性快照。 -->
    <warmupTicks>100</warmupTicks>
    <!-- 执行技能的工作定义，driverClass 必须是 JobDriver_ShirokoNormalSkill。 -->
    <jobDef>BANW_Job_ShirokoNormalSkill</jobDef>
    <!-- 前摇音效，留空表示不播放。 -->
    <warmupSound>Shiroko_C_Skill_EX_B</warmupSound>
    <!-- 前摇期间持续播放的特效。 -->
    <warmupEffecter>BANW_Effecter_A</warmupEffecter>

    <!--
      手榴弹攻击段（SpecialAttackConfig）。
      单枚跟踪手榴弹，伤害与溅射半径都由这里定义，弹丸本身不重复结算。
    -->
    <grenadeAttack>
      <!-- true 走BA战斗系统攻击力公式；false 则直接用 basePower 作为基数。 -->
      <useBattleStats>true</useBattleStats>
      <!-- 关闭BA战斗系统时使用的攻击基数。 -->
      <basePower>100</basePower>
      <!-- 伤害总倍率：4.5 表示 450% 攻击力，不按发数均分（本段固定 1 发）。 -->
      <attackPowerRatio>4.5</attackPowerRatio>
      <!-- 本段伤害类型。 -->
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 护甲穿透比例：2 表示穿透2点护甲；0 表示不额外穿透。 -->
      <penetration>2</penetration>
      <!-- 必须为 false：true 会把倍率锁定成100%攻击力并计入普攻事件。 -->
      <isNormalAttack>false</isNormalAttack>
      <!-- false 表示不享受EX伤害加成。 -->
      <isExSkill>false</isExSkill>
      <!-- 是否允许暴击。 -->
      <canCrit>true</canCrit>
      <!-- 是否应用攻击类型与护甲类型克制。 -->
      <applyAffinity>true</applyAffinity>
      <!-- 溅射半径（格）：0.9 格圆形爆炸。 -->
      <radius>0.9</radius>
      <!-- 本段发数，手榴弹固定为 1。 -->
      <shots>1</shots>
      <!-- 弹丸Def，必须是 Projectile_ShirokoGrenade（跟踪手榴弹）。 -->
      <projectileDef>BANW_ShirokoTrackingGrenade</projectileDef>
      <!-- 投掷音效，留空表示不播放。 -->
      <shotSound></shotSound>
      <!-- 爆炸命中特效。 -->
      <effecterDef>BANW_Shiroko_C_Ef_D</effecterDef>
    </grenadeAttack>

    <!--
      无人机逐发连射列表（droneShots）。
      每项 = 一个 delayTicks + 一个 attack，代表独立的一发技能伤害，间隔 7 tick：
        delayTicks      相对手榴弹投掷时刻的延迟（tick），必须非负，按升序排列。
        attack.shots    必须为 1，时间由 delayTicks 控制，倍率不再除以列表长度。
        attack.attackPowerRatio 该发自己的倍率：0.376 = 37.6% 攻击力。
        attack.isNormalAttack   必须 false，否则 attackPowerRatio 会被忽略。
        attack.isExSkill        必须 false，表示不享 EX 加成。
        attack.projectileDef    必须使用 Projectile_SpecialSkill 系列实体弹丸。
    -->
    <droneShots>
      <!-- 第1发：delayTicks 0，倍率 0.376（37.6% 攻击力）。 -->
      <li>
        <delayTicks>0</delayTicks>
        <attack>
