  <!-- 普通技能的工作定义：让小人站定做前摇，再投掷手榴弹。 -->
  <JobDef>
    <!-- 工作唯一标识，被上面 ShirokoNormalSkillDef.jobDef 引用。 -->
    <defName>BANW_Job_ShirokoNormalSkill</defName>
    <!-- 工作驱动类，校验器要求必须是它。 -->
    <driverClass>BANWlLib.Skills.JobDriver_ShirokoNormalSkill</driverClass>
    <!-- 小人进行中显示的工作说明。 -->
    <reportString>正在瞄准并投掷手榴弹。</reportString>
    <!-- 执行时显示主武器，避免双手空举。 -->
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

  <!-- 跟踪手榴弹实体：只负责飞行与命中表现，实际伤害与爆炸范围读 grenadeAttack。 -->
  <ThingDef ParentName="BaseBullet">
    <!-- 弹丸唯一标识，被 grenadeAttack.projectileDef 引用。 -->
    <defName>BANW_ShirokoTrackingGrenade</defName>
    <!-- 显示名称。 -->
    <label>白子跟踪手榴弹</label>
    <!-- 自定义弹丸类：追踪目标并在命中时按技能配置结算，不走原版爆炸伤害。 -->
    <thingClass>BANWlLib.Skills.Projectile_ShirokoGrenade</thingClass>
    <graphicData>
      <!-- 手榴弹贴图路径。 -->
      <texPath>Weapon/Abydos/Shiroko_C_Bullet_B</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- 绘制尺寸（格）。 -->
      <drawSize>(0.5,0.5)</drawSize>
    </graphicData>
    <projectile>
      <!-- 占位伤害类型，真实伤害由 grenadeAttack.damageDef 结算。 -->
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 原版伤害固定为 1，仅作占位，避免与技能伤害重复结算。 -->
      <damageAmountBase>1</damageAmountBase>
      <!-- 飞行速度（格/秒）。 -->
      <speed>50</speed>
      <!-- 抛物线高度系数，1 表示完整的投掷弧线。 -->
      <arcHeightFactor>1</arcHeightFactor>
      <!-- 自转速度（度/秒）。 -->
      <spinRate>720</spinRate>
      <!-- 阴影大小。 -->
      <shadowSize>0.3</shadowSize>
    </projectile>
  </ThingDef>

  <!-- 退场缓冲：黑子首次致命伤后不立即倒地，而是按秒叠层，叠满才真正死亡。 -->
  <HediffDef>
    <!-- 状态唯一标识。 -->
    <defName>BANW_ShirokoRetirementBuffer</defName>
    <!-- 显示名称。 -->
    <label>退场缓冲</label>
    <!-- 机制说明，数值与 BANW_Special_Shiroko 的层数上限保持一致。 -->
    <description>首次致命伤触发时获得1层，此后每经过完整1游戏秒增加一层；受伤不额外加层或刷新计时。满血时清空；达到技能配置的层数上限时强制死亡，默认15层，即首次触发14秒后。</description>
    <!-- 自定义状态类，负责计时叠层与强制死亡。 -->
    <hediffClass>BANWlLib.Skills.Hediff_ShirokoRetirementBuffer</hediffClass>
    <!-- 不是负面状态，避免被治疗类逻辑顺手清掉。 -->
    <isBad>false</isBad>
    <!-- 初始层数为 1，即触发致命伤的那一刻先给一层。 -->
    <initialSeverity>1</initialSeverity>
    <!-- 不能被物品或手术治愈，只能靠满血清空。 -->
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>
</Defs>
