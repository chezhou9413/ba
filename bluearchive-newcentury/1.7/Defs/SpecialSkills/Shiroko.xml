<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 白子技能配置：无人机、生命消耗、不死层数与特效。 -->
  <!-- 特殊技能配置档：把白子的EX、普通技能、无人机攻击和不死被动集中在一处，运行时由 Ability_SpecialSkill 按 role 读取。 -->
  <BANWlLib.Skills.SpecialSkillProfileDef>
    <!-- 配置档唯一标识，被 AbilityDef 的 CompProperties_SpecialSkill.profile 引用。 -->
    <defName>BANW_Special_Shiroko</defName>
    <!-- 显示名称，用于调试和日志。 -->
    <label>黑子</label>
    <!-- 角色类型，决定运行时走哪一套专属机制代码。 -->
    <role>Shiroko</role>
    <!-- 本配置档对应的主能力Def，能力按钮通过它反查到这里。 -->
    <primaryAbility>BANW_Special_Shiroko_Ex</primaryAbility>
    <range>33.9</range>
    <radius>0</radius>
    <durationTicks>2400</durationTicks>
    <!-- 施放EX时扣除的最大生命比例：0.2 表示 20%，且不会把自己扣死。 -->
    <lifeCostRatio>0.2</lifeCostRatio>
    <!-- 不死被动的冷却（tick）：5400 tick = 90 秒，从本场首次触发开始计算。 -->
    <immortalityCooldownTicks>5400</immortalityCooldownTicks>
    <!-- 不死层数上限：叠到第 15 层时强制死亡。 -->
    <lethalStackLimit>15</lethalStackLimit>
    <casterEffecter></casterEffecter>
    <targetEffecter></targetEffecter>
    <stageEffecter></stageEffecter>
    <endEffecter></endEffecter>
    <stateEffecter></stateEffecter>
    <shiroko>
      <!-- EX期间禁用指定按钮及施放；保留原能力、充能与正常流逝的冷却。 -->
      <disabledNormalAbility>BAWN_Shiroko_C_NS</disabledNormalAbility>
      <normalSkill>BANW_Special_Shiroko_Normal</normalSkill>
      <retirementBufferHediff>BANW_ShirokoRetirementBuffer</retirementBufferHediff>
      <!-- 路径不带方向后缀；缺少西向图时由原版镜像东向图。偏移同时用于机体和发射点。 -->
      <droneGraphic>
        <texPath>Pawns/Abydos/Shiroko/Skill/Wurenji</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2,2)</drawSize>
        <drawOffsetNorth>(-0.8,0,1.2)</drawOffsetNorth>
        <drawOffsetEast>(-1.2,0,1.2)</drawOffsetEast>
        <drawOffsetSouth>(0.8,0,1.2)</drawOffsetSouth>
        <drawOffsetWest>(1.2,0,1.2)</drawOffsetWest>
      </droneGraphic>
    </shiroko>
    <droneAttack>
      <!-- 每发主武器射击触发一轮；attackPowerRatio为整轮倍率，按shots均分。 -->
      <useBattleStats>true</useBattleStats>
      <!-- 关闭BA战斗系统时使用的攻击基数。 -->
      <basePower>100</basePower>
      <!-- 攻击力总倍率：0.5 表示以普攻基准的 50% 结算。 -->
      <attackPowerRatio>0.6</attackPowerRatio>
      <!-- 本段伤害使用的伤害类型。 -->
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 本段每次伤害的护甲穿透比例：0.5为50%，不随连射发数均分；0 表示不额外穿透。 -->
      <penetration>2</penetration>
      <!-- false 表示不享受EX伤害加成。 -->
      <isExSkill>false</isExSkill>
      <!-- false 表示按技能动作结算，attackPowerRatio 才会生效；true 会锁定为100%攻击力并计入普攻事件。 -->
      <isNormalAttack>false</isNormalAttack>
      <canCrit>true</canCrit>
      <!-- 是否应用攻击类型与护甲类型克制。 -->
      <applyAffinity>true</applyAffinity>
      <!-- 溅射半径（格），0 表示单体。 -->
      <radius>0</radius>
      <!-- 单次追击的发数。 -->
      <shots>7</shots>
      <!-- 相邻两发之间的间隔（tick）。 -->
      <shotIntervalTicks>6</shotIntervalTicks>
      <!-- 每次射击播放的音效。 -->
      <shotSound>BANW_Shiroko_DroneShot</shotSound>
      <!-- 本段使用的弹丸Def。 -->
      <projectileDef>BANW_Bullet_Shiroko_C_EX</projectileDef>
      <!-- 命中时的特效。 -->
      <effecterDef>BANW_Shiroko_C_Ef_A</effecterDef>

    </droneAttack>
  </BANWlLib.Skills.SpecialSkillProfileDef>
  <!-- EX 能力本体：消耗生命召唤无人机，按钮由上面配置档的 primaryAbility 指过来。 -->
  <AbilityDef>
    <!-- 能力唯一标识。 -->
    <defName>BANW_Special_Shiroko_Ex</defName>
    <!-- 按钮显示名称。 -->
    <label>火力强化</label>
    <!-- 悬浮说明，直接展示给玩家的机制与数值。 -->
    <description>召唤无人机（持续40秒）。
-暴击率增加67%（持续40秒）。
- 暴击伤害增加134%（持续40秒）
- 攻击速度增加34%（持续40秒）。
- 造成自身生命值上限20%的固定伤害。
无人机造成自身攻击力20%的伤害
※ 自身不会因该技能的效果退场.</description>
    <!-- 自定义能力类，接管EX释放、普通技能轮询和无人机生命周期。 -->
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <!-- 按钮图标路径。 -->
    <iconPath>Ability/Icon/Shiroko_C/Shiroko_EXX</iconPath>
    <!-- EX 冷却（tick）：600 tick = 10 秒，配合再次施放刷新无人机。 -->
    <cooldownTicksRange>600</cooldownTicksRange>
    <!-- 未征召时仍显示按钮。 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <!-- 但未征召时按钮置灰不可点。 -->
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <warmupEffecter>BANW_Shiroko_C_Ef_B</warmupEffecter>
    <!-- 征召状态下显示按钮。 -->
    <showWhenDrafted>true</showWhenDrafted>
    <!-- 不绘制心灵仪式类特效。 -->
    <showPsycastEffects>false</showPsycastEffects>
    <!-- false 表示这不是敌对行为。 -->
    <hostile>false</hostile>
    <!-- false 表示施放时不需要选择目标（对自己放）。 -->
    <targetRequired>false</targetRequired>
    <!-- 施法者不要求具备暴力能力。 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <warmupStartSound>Shiroko_C_Skill_EXX</warmupStartSound>
    <statBases>
<!-- 持续时间：20 秒 = 1200 ticks -->
  <Ability_Duration>40</Ability_Duration>
 </statBases>
    <verbProperties>
      <!-- 基础施法动词，本技能的实际效果全部由 comps 接管。 -->
      <verbClass>Verb_CastAbility</verbClass>
      <!-- 施法距离（格）。 -->
      <range>25</range>
      <!-- 前摇时间（秒），2 表示施法前摇 2 秒，走完才结算 comps。 -->
      <warmupTime>2</warmupTime>
      <!-- 目标参数：只能选自己，因此关闭了选空地、选Pawn和选建筑。 -->
      <targetParams>
        <!-- 允许以自己为目标。 -->
        <canTargetSelf>true</canTargetSelf>
        <!-- 不允许瞄准其他 Pawn。 -->
        <canTargetPawns>false</canTargetPawns>
        <!-- 人类目标开关，这里不生效（canTargetPawns 已关闭）。 -->
        <canTargetHumans>true</canTargetHumans>
        <!-- 动物目标开关，这里不生效。 -->
        <canTargetAnimals>true</canTargetAnimals>
        <!-- 机械体目标开关，这里不生效。 -->
        <canTargetMechs>true</canTargetMechs>
        <!-- 不允许选建筑。 -->
        <canTargetBuildings>false</canTargetBuildings>
        <!-- 不允许选空地。 -->
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- 核心效果组件：把能力挂到对应配置档上，并声明本次是 EX 施放。 -->
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <!-- 引用上面的配置档 defName。 -->
        <profile>BANW_Special_Shiroko</profile>
        <!-- 施放类型：Ex 表示召唤/刷新无人机的EX；同一能力还会用该组件承载普通技能与被动。 -->
        <command>Ex</command>
      </li>
      <!-- 自身增益组件：施法完成后给自己挂上火力强化，重复施放会替换旧状态并重新计时。 -->
      <li Class="CompProperties_AbilityGiveHediff">
        <!-- 使用原版给予状态的效果类。 -->
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <!-- 要施加的状态Def。 -->
        <hediffDef>BANW_Shiroko_FirepowerBuff</hediffDef>
        <!-- 只作用于施法者自己。 -->
        <onlyApplyToSelf>true</onlyApplyToSelf>
        <!-- 再次施放时移除旧状态再添加，从而刷新 40 秒持续时间。 -->
        <replaceExisting>true</replaceExisting>
      </li>
      <!-- COST 消耗组件：施放时扣除 4 点 COST。 -->
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost">
        <!-- 本技能消耗的 COST 点数。 -->
        <cost>3</cost>
      </li>
    </comps>
  </AbilityDef>
  <!-- EX 施放后给予自身的火力强化状态：暴击率 +67%，暴击伤害倍率 +1.34（即 +134%），持续 40 秒。 -->
  <HediffDef>
    <!-- 状态唯一标识，被上面 CompProperties_AbilityGiveHediff 引用。 -->
    <defName>BANW_Shiroko_FirepowerBuff</defName>
    <!-- 状态显示名，与技能名保持一致。 -->
    <label>火力强化</label>
    <!-- 悬浮说明，写明具体加成与持续时间。 -->
    <description>暴击率增加67%，暴击伤害增加134%，攻击速度增加34%(持续40秒)</description>
    <!-- 正面状态，按增益显示在健康面板。 -->
    <isBad>false</isBad>
    <!-- 标签颜色，与其余技能增益保持一致的金黄色。 -->
    <defaultLabelColor>(255,255,0)</defaultLabelColor>
    <!-- 不能被道具治愈，只能等持续时间结束或被刷新替换。 -->
    <everCurableByItem>false</everCurableByItem>
    <!-- 状态逻辑类：必须为 HediffWithComps 或其子类，否则下面的 comps 无法加载。 -->
    <hediffClass>HediffWithComps</hediffClass>
    <!-- 初始严重度，保证第 0 阶段的属性加成生效。 -->
    <initialSeverity>1</initialSeverity>
    <!-- 属性加成放在阶段里，severity >= 0 即套用。 -->
    <stages>
      <li>
        <statOffsets>
          <!-- 暴击率加值：0.67 即 +67%，该属性单位为比例，1 表示 100%。 -->
          <BANW_CriticalChance>0.67</BANW_CriticalChance>
          <!-- 暴击伤害倍率加值：1.34 即 +134%，基础 2 表示 200%，加后为 334%。 -->
          <BANW_CriticalDamage>1.34</BANW_CriticalDamage>
          <Muice_RangedAimingTimeFactor>-0.17</Muice_RangedAimingTimeFactor>
          <RangedCooldownFactor>-0.17</RangedCooldownFactor>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <!-- 2400 tick = 40 秒后自动消失，并在健康面板显示剩余时间。 -->
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>2400</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Shiroko_C_Ef_C</stateEffecter>
      </li>
    </comps>
  </HediffDef>
  <ThingDef ParentName="BaseBullet">
    <defName>BANW_Bullet_Shiroko_C_EX</defName>
    <label>导弹</label>
    <thingClass>BANWlLib.Skills.Projectile_SpecialSkill</thingClass>
    <graphicData>
      <texPath>Weapon/Abydos/Shiroko_C_Bullet_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.5,0.8)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>BANC_Damage_Shiroko_C_EX_A</damageDef>
      <damageAmountBase>2</damageAmountBase>
      <speed>90</speed>
    </projectile>
  </ThingDef>
    <DamageDef ParentName="BANC_Damage_shenmi">
    <defName>BANC_Damage_Shiroko_C_EX_A</defName><!--通用贯通-->
    <damageEffecter>BANW_Shiroko_C_Ef_A</damageEffecter>
  </DamageDef>

  <AbilityDef>
    <defName>BAWN_Shiroko_C_NS</defName>
    <label>投掷手榴弹·改</label>
    <description>对圆形范围内的敌方单位造成自身攻击力704%的伤害</description>
    <iconPath>Ability/Icon/Asuna/Asuna_EX</iconPath>
    <cooldownTicksRange>2400</cooldownTicksRange>
    <hotKey>Misc12</hotKey>
    <warmupStartSound>Shiroko_C_Skill_EX</warmupStartSound>
    <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
    <stunTargetWhileCasting>false</stunTargetWhileCasting><!-- 施法时是否定身目标 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
    <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
    <hostile>true</hostile><!-- 是否是敌对行为 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
    <verbProperties>
      <warmupEffecter>BANW_Effecter_NewA</warmupEffecter>
      <soundCast>ThrowGrenade</soundCast>
      <!-- 通用预览动词：施法时按 modExtensions 里的 AbilityTargetPreviewExtension 绘制范围。 -->
      <verbClass>BANWlLib.BaVerb.Verb_CastAbilityWithTargetPreview</verbClass>
      <range>45.9</range><!-- 投掷范围 -->
      <warmupTime>1</warmupTime><!-- 前摇时间 -->
      <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
      <requireLineOfSight>false</requireLineOfSight><!-- 不需要视线 -->
      <targetParams><!-- 目标参数设置 -->
        <canTargetLocations>true</canTargetLocations> <!-- 可以瞄准地面位置 -->
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetHumans>true</canTargetHumans>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>BAWN_Shiroko_NS_Boom</projectileDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="BANWlLib.BaVerb.AbilityTargetPreviewExtension">
        <!-- 圆形预览，半径与投射物的 explosionRadius 保持一致，悬停即显示爆炸范围。 -->
        <shape>Circle</shape>
        <range>45.9</range>
        <radius>2.9</radius>
        <drawCasterRange>true</drawCasterRange>
        <drawTargetHighlight>true</drawTargetHighlight>
      </li>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
        <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
        <showBattleFormula>true</showBattleFormula>
        <!-- 悬浮预览用的战斗段配置，只用于显示公式，不直接造成伤害。 -->
        <previewActions>
          <li>
            <!-- 固定基础伤害，0 表示只吃攻击力倍率。 -->
            <!-- 最终攻击力倍率，2.0 表示造成 200% 攻击力伤害。 -->
            <attackPowerRatio>7.04</attackPowerRatio>
            <!-- 伤害类型。 -->
            <damageDef>BANC_Damage_shenmi</damageDef>
            <!-- 是否允许暴击。 -->
            <canCrit>true</canCrit>
            <!-- 是否应用攻击类型与护甲类型克制。 -->
            <applyAffinity>true</applyAffinity>
            <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
            <isExSkill>false</isExSkill>
          </li>
        </previewActions>
      </li>
    </modExtensions>
  </AbilityDef>
  <!-- 投掷物型弹丸：继承原版 BaseGrenadeProjectile，自带 Projectile_Explosive、弧线飞行与落地阴影，命中即爆炸。 -->
  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>BAWN_Shiroko_NS_Boom</defName>
    <label>投掷手榴弹·改</label>
    <projectile>
      <explosionRadius>2.9</explosionRadius>
      <damageDef>BANC_Damage_Shiroko_NS</damageDef><!--子弹类型-->
      <damageAmountBase>24</damageAmountBase><!--子弹伤害-->
      <stoppingPower>1.5</stoppingPower><!--抑制-->
      <armorPenetrationBase>2</armorPenetrationBase><!--穿透-->
      <speed>90</speed><!--子弹速度-->
      <!-- 落地立即爆炸，不延迟。 -->
      <explosionDelay>0</explosionDelay>
      <!-- 伤害由中心向外衰减。 -->
      <explosionDamageFalloff>true</explosionDamageFalloff>
    </projectile>
    <graphicData>
      <drawSize>1.0</drawSize>
      <texPath>Weapon/Abydos/Shiroko_C_Bullet_B</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.BattleProjectileExtension">
        <attackPowerRatio>7.04</attackPowerRatio>
         <isNormalAttack>false</isNormalAttack>
        <canCrit>true</canCrit>
        <isExSkill>false</isExSkill>
      </li>
    </modExtensions>
  </ThingDef>
  <DamageDef ParentName="BANC_Damage_guantong">
    <defName>BANC_Damage_Shiroko_NS</defName><!--通用贯通-->
    <explosionHeatEnergyPerCell>5</explosionHeatEnergyPerCell>
    <explosionCellFleck>BlastDry</explosionCellFleck>
    <!-- 爆炸颜色：中心偏亮的深蓝，边缘压暗的深蓝。 -->
    <explosionColorCenter>(0.13, 0.28, 0.62)</explosionColorCenter>
    <explosionColorEdge>(0.05, 0.11, 0.30)</explosionColorEdge>
    <soundExplosion>Explosion_Bomb</soundExplosion>
    <combatLogRules>Damage_Bomb</combatLogRules>
  </DamageDef>
</Defs>
