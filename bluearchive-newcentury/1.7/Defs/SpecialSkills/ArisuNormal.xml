<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 独立自动普通技能，不注册AbilityDef或主动按钮，不共用EX的表现与伤害配置。 -->
  <BANWlLib.Skills.ArisuNormalSkillDef>
    <!-- 技能 Def 唯一标识，供角色机制按名查找。 -->
    <defName>BANW_Special_Arisu_Normal</defName>
    <!-- 显示名。 -->
    <label>勇气的魔法</label>
    <!-- 说明文本。 -->
    <description>每累计20次有效普通攻击对1名敌方单位造成自身攻击力457%的伤害。</description>
    <!-- 触发一次自动技能所需的有效普攻命中次数。 -->
    <requiredHits>20</requiredHits>
    <!-- 两次自动触发之间的最短间隔，1 tick 表示命中数达标即立刻追加。 -->
    <cooldownTicks>1</cooldownTicks>
    <!-- 独立普通技能前摇；期间播放castSound和casterEffecter。 -->
    <warmupTicks>60</warmupTicks>
    <jobDef>BANW_Job_ArisuNormalSkill</jobDef>
    <!-- 技能可及距离（格），超出该距离不追加攻击。 -->
    <range>39.9</range>
    <!-- 可分别替换施法音效、自身特效、目标施法特效及attack内的命中特效。 -->
    <castSound>Arisu_B_Skill_EX</castSound>
    <casterEffecter>BANW_Effecter_Arisu_B_NS</casterEffecter>
    <targetEffecter></targetEffecter>
    <!-- 自动技能的单体伤害配置；不配置主动按钮，全部参数在此声明。 -->
    <attack>
      <!-- 是否使用 BA 战斗属性结算；false 时改用 basePower×attackPowerRatio。 -->
      <useBattleStats>true</useBattleStats>
      <!-- 基础伤害值（关闭 BA 时作为攻击基数）。 -->
      <basePower>100</basePower>
      <!-- 本段总倍率，shots 大于 1 时按发数均分；1 = 100%。 -->
      <attackPowerRatio>18.28</attackPowerRatio>
      <!-- 伤害类型。 -->
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 每发使用完整护甲穿透，0.5为50%。 -->
      <penetration>2</penetration>
      <!-- 是否应用EX独立乘区；不改变普通技能的自动触发与充能规则。 -->
      <isExSkill>true</isExSkill>
      <!-- 是否可暴击。 -->
      <canCrit>true</canCrit>
      <!-- 是否应用攻击/护甲类型克制。 -->
      <applyAffinity>true</applyAffinity>
      <!-- 溅射半径（格），0 = 只结算弹丸命中的单体。 -->
      <radius>0</radius>
      <!-- 本段发数。 -->
      <shots>12</shots>
      <!-- 段内多发时的发射间隔，6 tick = 0.1 秒。 -->
      <shotIntervalTicks>7</shotIntervalTicks>
      <!-- 弹丸 ThingDef，必须使用 Projectile_SpecialSkill。 -->
      <projectileDef>BANW_Bullet_Arisu_B_EX</projectileDef>
      <!-- 命中特效。 -->
      <effecterDef>BANW_Effecter_Arisu_B_NSS</effecterDef>
      <shotSound>Arisu_B_Skill_NS</shotSound>
      <!-- 是否可以命中自己。 -->
      <canHitOwnPawn>false</canHitOwnPawn>
      <!-- 是否影响友军。 -->
      <affectFriendly>false</affectFriendly>
      <!-- 是否影响敌军。 -->
      <affectHostile>true</affectHostile>
    </attack>
  </BANWlLib.Skills.ArisuNormalSkillDef>
  <JobDef>
    <defName>BANW_Job_ArisuNormalSkill</defName>
    <driverClass>BANWlLib.Skills.JobDriver_ArisuNormalSkill</driverClass>
    <reportString>正在施放勇气的魔法。</reportString>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

 <ThingDef ParentName="BaseBullet">
    <defName>BANW_Bullet_Arisu_B_EX</defName>
    <label>导弹</label>
    <thingClass>BANWlLib.Skills.Projectile_SpecialSkill</thingClass>
    <graphicData>
      <texPath>Projectile/Arisu_B_NS</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>BANC_Damage_shenmi</damageDef>
      <damageAmountBase>2</damageAmountBase>
      <speed>90</speed>
    </projectile>
  </ThingDef>
<EffecterDef>
<defName>BANW_Effecter_Arisu_B_NSS</defName>
<children>
  <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Arisu_B_Skill_NSS</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>BAWN_Arisu_B_NS_3_Mote</moteDef>
        <initialDelayTicks>0</initialDelayTicks>
        <positionRadius>0.35</positionRadius><!-- 生成位置的半径范围 -->
        <scale>1</scale>  <!-- 缩放比例，影响特效显示大小 -->
        <rotation>0</rotation><!-- 初始旋转角度 -->
        <rotationRate>0</rotationRate><!-- 每秒旋转角度（持续旋转） -->
        <burstCount>1</burstCount>  <!-- 一次触发时生成的特效数量 -->
        <positionOffset>(0,0.5,0)</positionOffset>  <!-- 特效生成的位置偏移（X, Z, Y） -->
        <angle>0</angle><!-- 发射角度 -->
        <fleckUsesAngleForVelocity>false</fleckUsesAngleForVelocity><!-- 是否根据角度设置速度方向，true 表示启用 -->
        <spawnLocType>OnSource</spawnLocType>
        <speed>0</speed>
        <attachToSpawnThing>true</attachToSpawnThing><!-- 是否跟踪 -->
        <absoluteAngle>true</absoluteAngle>
      </li>
      
</children>
</EffecterDef>
</Defs>
