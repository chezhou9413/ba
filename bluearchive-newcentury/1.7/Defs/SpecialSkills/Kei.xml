<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 凯伊技能配置：友军增益场地、伤害蓄积与结束释放。 -->
  <BANWlLib.Skills.SpecialSkillProfileDef>
    <!-- 技能档案唯一标识，供 AbilityDef 的 comps 引用。 -->
    <defName>BANW_Special_Kei</defName>
    <!-- 档案显示名，同时作为技能状态 hediff 的显示名。 -->
    <label>凯伊</label>
    <!-- 归属角色标识，决定技能流程走 KeiSkills 分支。 -->
    <role>Kei</role>
    <!-- 该档案绑定的主技能 Def。 -->
    <primaryAbility>BAWN_Kei_EXX</primaryAbility>
    <!-- 技能射程（格），与 AbilityDef 的 range 保持一致。 -->
    <range>69.9</range>
    <!-- 凯伊专属配置：场地来源、蓄积贡献状态与普通技能表现。 -->
    <kei>
      <!-- 场地半径、持续时间和增益动作都读取这个现有EX的实际配置。 -->
      <sourceExAbility>BAWN_Kei_EXX</sourceExAbility>
      <!-- 友军进入场地后获得的增益状态，同时用于判定其是否仍在场地内、可以贡献蓄积。 -->
      <contributionHediff>BAWN_Kei_buff</contributionHediff>
      <!-- 场地结束后自动执行的释放工作。 -->
      <normalJob>BANW_Job_KeiNormalSkill</normalJob>
      <!-- 普通技能前摇，60 tick为1秒；语音与前摇特效在前摇开始时播放。 -->
      <warmupTicks>120</warmupTicks>
      <!-- 前摇开始时播放的语音。 -->
      <warmupSound>Kei_Skill_EXX</warmupSound>
      <!-- 前摇开始时在施法者身上播放的特效。 -->
      <warmupEffecter>BANW_Kei_Ef_B</warmupEffecter>
      <!-- 子弹命中结算时播放的射击语音。 -->
      <castSound>BANW_Wp_RG_At</castSound>
      <!-- 普通技能发射时施法者身上朝目标方向的定向特效。 -->
      <casterEffecter></casterEffecter>
      <!-- 普通技能发射时目标位置播放的特效；留空表示不播放。 -->
      <targetEffecter></targetEffecter>
    </kei>
    <!-- 友军在场地内对敌人造成的实际伤害计入蓄积的比例，0.1为10%；施法者自身伤害不计入。 -->
    <recordRatio>0.1</recordRatio>
    <!-- 蓄积上限倍率：上限 = burstAttack 的攻击基数 × 该倍率，50 即 5000%。 -->
    <recordCapRatio>50</recordCapRatio>
    <casterEffecter></casterEffecter>
    <targetEffecter></targetEffecter>
    <stageEffecter></stageEffecter>
    <endEffecter></endEffecter>
    <stateEffecter></stateEffecter>
    <normalAttack>
      <!-- 普通技能的攻击力伤害段，与蓄积伤害分别结算。 -->
      <useBattleStats>true</useBattleStats>
      <!-- 未启用 BA 战斗数值时使用的固定攻击基数。 -->
      <basePower>100</basePower>
      <!-- 281%自身攻击力，记录量为0时仍正常造成该段伤害。 -->
      <attackPowerRatio>2.81</attackPowerRatio>
      <damageDef>BANC_Damage_shenmi</damageDef>
      <penetration>0</penetration>
      <!-- 普通技能不属于武器普攻，也不使用EX加成。 -->
      <isNormalAttack>false</isNormalAttack>
      <isExSkill>false</isExSkill>
      <canCrit>true</canCrit>
      <applyAffinity>true</applyAffinity>
      <radius>0</radius>
      <shots>1</shots>
      <shotIntervalTicks>6</shotIntervalTicks>
      <projectileDef>BANW_SpecialSkillBullet</projectileDef>
      <effecterDef>BANW_Effecter_C</effecterDef>
    </normalAttack>
    <burstAttack>
      <!-- 普通技能的记录伤害段，独立于normalAttack；攻击基数仅用于计算蓄积上限。 -->
      <useBattleStats>true</useBattleStats>
      <basePower>100</basePower>
      <!-- 按装置记录量的100%释放，不再次乘攻击力、暴击或克制倍率。 -->
      <attackPowerRatio>1</attackPowerRatio>
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 本段每次伤害的护甲穿透：0.5为50%，不随连射发数均分。 -->
      <penetration>2</penetration>
      <!-- 是否乘施法者的 EX 技能倍率；false 表示按普通伤害结算。 -->
      <isExSkill>false</isExSkill>
      <!-- 允许暴击。 -->
      <canCrit>true</canCrit>
      <!-- 结算时应用属性克制/亲和加成。 -->
      <applyAffinity>true</applyAffinity>
      <!-- 命中范围半径，0 为单体直接命中。 -->
      <radius>0</radius>
      <!-- 连射发数；单发单体弹丸固定为 1。 -->
      <shots>1</shots>
      <!-- 相邻两发之间的间隔 tick，60 tick 为 1 秒。 -->
      <shotIntervalTicks>6</shotIntervalTicks>
      <!-- 单发单体实体弹丸在命中时结算蓄积伤害，shots固定为1、radius固定为0。 -->
      <projectileDef>BANC_Bullet_Kei_NS</projectileDef>
      <!-- 弹丸命中时播放的特效。 -->
      <effecterDef></effecterDef>
    </burstAttack>
  </BANWlLib.Skills.SpecialSkillProfileDef>

  <!-- 普通技能工作不提供主动按钮，只能在场地到期后自动执行。 -->
  <JobDef>
    <defName>BANW_Job_KeiNormalSkill</defName>
    <driverClass>BANWlLib.Skills.JobDriver_KeiNormalSkill</driverClass>
    <reportString>正在瞄准并释放两段普通技能伤害。</reportString>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>
   <ThingDef ParentName="BaseBullet">
    <defName>BANC_Bullet_Kei_NS</defName>
    <label>亮新星子弹 </label>
    <thingClass>BANWlLib.Skills.Projectile_SpecialSkill</thingClass>
    <graphicData>
      <shaderType>MoteGlow</shaderType><!-- 使用的着色器类型，用于发光效果 -->
      <texPath>Projectile/Bullet_Kei</texPath>
      <graphicClass>Graphic_Single</graphicClass>
   <drawSize>(8,15)</drawSize><!--贴图大小-->
    </graphicData>
    <projectile>
      <damageDef>BANC_Damage_shenmi</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>140</speed>
    </projectile>
  </ThingDef>
</Defs>