<Defs>
  <AbilityDef>
    <defName>BAWN_Hoshiro_A_EX</defName>
    <label>水上袭击</label>
    <description>对一名敌人造成自身攻击力454%的伤害并回复自身治愈力98%的生命值</description>
    <iconPath>Ability/Icon/Serika/Serika_EX</iconPath>
    <cooldownTicksRange>2400</cooldownTicksRange>
    <hotKey>Misc12</hotKey>
    <warmupStartSound>Hoshiro_A_Skill_EX</warmupStartSound>
    <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
    <stunTargetWhileCasting>True</stunTargetWhileCasting><!-- 施法时是否定身目标 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
    <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
    <hostile>true</hostile><!-- 是否是敌对行为 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
    <warmupEffecter></warmupEffecter>
    <statBases>
      <!-- 能力持续时间 -->
      <Ability_Duration>0.1</Ability_Duration>
    </statBases>
    <verbProperties>
      <warmupEffecter>BANW_Effecter_NewA</warmupEffecter>
      <soundCast>BANW_Wp_SG_At</soundCast>
      <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
      <range>33.9</range><!-- 作用范围：-1 表示只能近战接触 -->
      <warmupTime>1</warmupTime><!-- 前摇时间（单位：秒） -->
      <muzzleFlashScale>9</muzzleFlashScale><!-- 枪口闪光的缩放比例为 9 -->
      <ticksBetweenBurstShots>7</ticksBetweenBurstShots><!-- 连发射击之间的间隔为 6 ticks -->
      <burstShotCount>2</burstShotCount> <!--连发射击的数量为
      12 发。-->
      <accuracyTouch>1</accuracyTouch><!--近距离射击的命中率为
      90%。-->
      <accuracyShort>1</accuracyShort> <!--短距离射击的命中率为
      80%。-->
      <accuracyMedium>1</accuracyMedium> <!--中距离射击的命中率为
      70%。-->
      <accuracyLong>1</accuracyLong><!--长距离射击的命中率为
      60%。-->
      <ai_IsWeapon>false</ai_IsWeapon> <!--AI
      不将此能力视为武器。-->
      <targetParams><!-- 目标参数设置 -->
        <canTargetSelf>false</canTargetSelf> <!-- 可以选自己 -->
        <canTargetPawns>true</canTargetPawns><!-- 不能选其他生物 -->
        <canTargetBuildings>true</canTargetBuildings><!-- 不能选建筑 -->
        <canTargetAnimals>true</canTargetAnimals> <!-- 不能选动物 -->
        <canTargetHumans>true</canTargetHumans><!-- 不能选人类 -->
        <canTargetMechs>true</canTargetMechs><!-- 不能选机械体 -->
      </targetParams>
    </verbProperties>
    <comps>
      <!-- 给予健康状态效果的组件 -->
      <li Class="CompProperties_AbilityGiveHediff">
        <!-- 组件类 -->
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <!-- 应用的健康状态效果定义 -->
        <hediffDef>BAWN_Hoshiro_A_EXX_buff_C</hediffDef>
        <!-- 是否只应用给自己 -->
        <onlyApplyToSelf>True</onlyApplyToSelf>
        <!-- 是否替换已存在的同种效果 -->
        <replaceExisting>true</replaceExisting>
      </li>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>BANC_Bullet_Hoshiro_A_EX</projectileDef>
      </li>
      <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Hoshiro_A_Ef_C</effecterDef>
        <maintainForTicks>150</maintainForTicks>
      </li>
    </comps>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
        <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
        <showBattleFormula>true</showBattleFormula>
        <!-- 悬浮预览用的战斗段配置，只用于显示公式，不直接造成伤害。 -->
        <previewActions>
          <li>
            <!-- 固定基础伤害，0 表示只吃攻击力倍率。 -->
            <!-- 最终攻击力倍率，2.0 表示造成 200% 攻击力伤害。 -->
            <attackPowerRatio>4.54</attackPowerRatio>
            <!-- 伤害类型。 -->
            <damageDef>BANC_Damage_baofa</damageDef>
            <!-- 是否允许暴击。 -->
            <canCrit>true</canCrit>
            <!-- 是否应用攻击类型与护甲类型克制。 -->
            <applyAffinity>true</applyAffinity>
            <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
            <isExSkill>false</isExSkill>
          </li>
        </previewActions>
      </li>
    </modExtensions>
  </AbilityDef>

  <HediffDef>
    <!-- 范围内目标应用的健康状态标识符 -->
    <defName>BAWN_Hoshiro_A_EXX_buff_C</defName>
    <!-- 显示标签 -->
    <label>水上袭击</label>
    <!-- 描述信息 -->
    <description>回复自身治愈力98%的生命值</description>
    <!-- 调试标签 -->
    <debugLabelExtra>other</debugLabelExtra>
    <!-- 健康状态类 -->
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(90, 255, 112)</defaultLabelColor>
    <!-- 组件列表 -->
    <comps>
      <li Class="BANWlLib.comp.HediffCompProps_Regeneration">
        <!-- 固定治疗量，设为 0 表示主要由治疗力倍率提供回复。 -->
        <!-- 每 tick 回复最终治疗力的 4%。 -->
        <healPowerRatio>0.98</healPowerRatio>
        <!-- 每 tick 触发一次治疗。 -->
        <healIntervalTicks>6</healIntervalTicks>
        <!-- 是否允许治疗永久伤。 -->
        <isHeatScar>true</isHeatScar>
        <!-- true 表示该持续治疗会额外乘施法者 EX技能倍率。 -->
        <isExSkill>false</isExSkill>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>60</disappearsAfterTicks>
      </li>
      <!-- 自动消失组件 -->
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Chinatsu_Ef_A</stateEffecter>
      </li>
    </comps>
    <!-- 是否为负面效果 -->
    <isBad>false</isBad>
    <!-- 阶段效果定义 -->
    <stages>
      <li>
        <!-- 属性加成 -->
        <statOffsets>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="BaseBullet">
    <defName>BANC_Bullet_Hoshiro_A_EX</defName>
    <label>水上袭击</label>
    <projectile>
      <damageDef>BANC_Damage_baofa</damageDef><!--子弹类型-->
      <damageAmountBase>20</damageAmountBase><!--子弹伤害-->
      <stoppingPower>5</stoppingPower><!--抑制-->
      <armorPenetrationBase>2</armorPenetrationBase><!--穿透-->
      <speed>200</speed><!--子弹速度-->
    </projectile>
    <graphicData>
      <drawSize>5</drawSize>
      <texPath>Projectile/kongbai</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.BattleProjectileExtension">
        <attackPowerRatio>4.54</attackPowerRatio>
         <isNormalAttack>false</isNormalAttack>
        <canCrit>true</canCrit>
         <isExSkill>false</isExSkill>
      </li>
    </modExtensions>
  </ThingDef>
  <AbilityDef>
    <!-- 能力的唯一标识符 -->
    <defName>BAWN_Hoshiro_A_EXX</defName>
    <!-- 能力显示名称 -->
    <label>水上支援</label>
    <!-- 能力描述，说明效果和持续时间 -->
    <description>赋予以自身为中心的圆形范围内的友方单位攻击力增加39%护甲穿透增加99%(持续50秒)</description>
    <!-- 是否需要特定目标，False表示为范围效果 -->
    <cooldownTicksRange>3000</cooldownTicksRange>
    <targetRequired>False</targetRequired>
    <!-- 是否可以使用AOE范围来获取目标 -->
    <canUseAoeToGetTargets>False</canUseAoeToGetTargets>
    <!-- 能力图标路径 -->
    <iconPath>Ability/Icon/Hina/Hina_A</iconPath>
    <!-- 施法时是否定身施法者 -->
    <stunTargetWhileCasting>True</stunTargetWhileCasting>
    <!-- 是否显示心灵异能特效 -->
    <showPsycastEffects>False</showPsycastEffects>
    <!-- 未征召状态下是否显示能力按钮 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
    <!-- 未征召状态下是否禁用能力按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
    <!-- 快捷键设置 -->
    <hotKey>Misc12</hotKey>
    <!-- 在UI中的排列顺序 -->
    <uiOrder>5</uiOrder>
    <!-- 施法开始时播放的声音 -->
    <warmupStartSound>Hoshiro_A_Skill_EXX</warmupStartSound>
    <!-- 施法者是否必须具备暴力行为能力 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <!-- 数值属性 -->
    <statBases>
      <!-- 能力持续时间 -->
      <Ability_Duration>50</Ability_Duration>
      <!-- 能力效果半径 -->
      <Ability_EffectRadius>5.9</Ability_EffectRadius>
    </statBases>
    <!-- 动作属性 -->
    <verbProperties>
      <warmupEffecter></warmupEffecter>
      <soundCast></soundCast>
      <!-- 动作类 -->
      <verbClass>Verb_CastAbility</verbClass>
      <!-- 前摇时间（秒） -->
      <warmupTime>0.1</warmupTime>
      <!-- 作用范围 -->
      <range>5.9</range>
      <!-- 是否绘制瞄准饼图 -->
      <drawAimPie>False</drawAimPie>
      <!-- 是否需要视线 -->
      <requireLineOfSight>False</requireLineOfSight>
      <!-- 目标参数设置 -->
      <targetParams>
        <!-- 是否可以以自己为目标 -->
        <canTargetSelf>true</canTargetSelf>
        <!-- 是否可以以pawn为目标 -->
        <canTargetPawns>false</canTargetPawns>
        <!-- 是否可以以建筑为目标 -->
        <canTargetBuildings>false</canTargetBuildings>
        <!-- 是否可以以动物为目标 -->
        <canTargetAnimals>false</canTargetAnimals>
        <!-- 是否可以以人类为目标 -->
        <canTargetHumans>false</canTargetHumans>
        <!-- 是否可以以机械体为目标 -->
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>

    <!-- 能力组件 -->
    <comps>
      <!-- 给予健康状态效果的组件 -->
      <li Class="CompProperties_AbilityGiveHediff">
        <!-- 组件类 -->
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <!-- 应用的健康状态效果定义 -->
        <hediffDef>BAWN_Hoshiro_A_EXX_buff_A</hediffDef>
        <!-- 是否只应用给自己 -->
        <onlyApplyToSelf>True</onlyApplyToSelf>
        <!-- 是否替换已存在的同种效果 -->
        <replaceExisting>true</replaceExisting>
      </li>
    </comps>
  </AbilityDef>

  <HediffDef>
    <!-- 健康状态唯一标识符 -->
    <defName>BAWN_Hoshiro_A_EXX_buff_A</defName>
    <!-- 显示标签 -->
    <label>水上支援</label>
    <!-- 描述信息 -->
    <description>水上支援</description>
    <!-- 健康状态类 -->
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(90, 255, 112)</defaultLabelColor>
    <!-- 组件列表 -->
    <comps>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Hoshiro_A_Ef_A</stateEffecter>
      </li>
      <!-- 自动消失组件 -->
      <li Class="HediffCompProperties_Disappears">
        <!-- 显示剩余时间 -->
        <showRemainingTime>True</showRemainingTime>
      </li>
      <!-- 死亡时消失组件 -->
      <li Class="HediffCompProperties_DisappearsOnDeath" />
      <!-- 范围内给予健康状态组件 -->
      <li Class="HediffCompProperties_GiveHediffsInRange">
        <!-- 影响范围 -->
        <range>9.9</range>
        <!-- 显示的微粒效果 -->
        <mote></mote>
        <!-- 未征召时是否隐藏微粒 -->
        <hideMoteWhenNotDrafted>false</hideMoteWhenNotDrafted>
        <!-- 目标选择参数 -->
        <targetingParameters>
          <!-- 不影响建筑 -->
          <canTargetBuildings>false</canTargetBuildings>
          <!-- 不影响动物 -->
          <canTargetAnimals>false</canTargetAnimals>
          <!-- 不影响机械体 -->
          <canTargetMechs>false</canTargetMechs>
          <!-- 只影响殖民者 -->
          <onlyTargetColonists>true</onlyTargetColonists>
        </targetingParameters>
        <!-- 应用的健康状态 -->
        <hediff>BAWN_Hoshiro_A_EXX_buff_B</hediff>
      </li>
    </comps>
    <!-- 是否为负面效果 -->
    <isBad>false</isBad>
  </HediffDef>
  <HediffDef>
    <!-- 范围内目标应用的健康状态标识符 -->
    <defName>BAWN_Hoshiro_A_EXX_buff_B</defName>
    <!-- 显示标签 -->
    <label>水上支援</label>
    <!-- 描述信息 -->
    <description>攻击力增加39%爆发克制率增加99%</description>
    <!-- 调试标签 -->
    <debugLabelExtra>other</debugLabelExtra>
    <!-- 健康状态类 -->
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(90, 255, 112)</defaultLabelColor>
    <!-- 组件列表 -->
    <comps>
      <!-- 自动消失组件 -->
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Hoshiro_A_Ef_B</stateEffecter>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <!-- 不显示剩余时间 -->
        <showRemainingTime>false</showRemainingTime>
      </li>
      <!-- 死亡时消失组件 -->
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <!-- 是否为负面效果 -->
    <isBad>false</isBad>
    <!-- 阶段效果定义 -->
    <stages>
      <li>
        <!-- 属性加成 -->
        <statOffsets>
          <BANW_FinalDamageMultiplier>0.39</BANW_FinalDamageMultiplier>
          <BANW_AffinityBonus_Explosion>0.99</BANW_AffinityBonus_Explosion>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>