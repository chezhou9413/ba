
<Defs>
   <AbilityDef>
    <defName>BAWN_Mari_EX</defName>
    <label>想吃苦头是吧？！</label>
    <description>对圆形范围内的敌方单位造成自身攻击力364%的伤害</description>
    <iconPath>Ability/Icon/Chise/Chise_EX</iconPath>
    <cooldownTicksRange>1500</cooldownTicksRange>
    <hotKey>Misc12</hotKey>
    <warmupStartSound>Mari_Skill_EX</warmupStartSound>
    <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
    <stunTargetWhileCasting>false</stunTargetWhileCasting><!-- 施法时是否定身目标 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
    <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
    <hostile>true</hostile><!-- 是否是敌对行为 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
    <verbProperties>
      <warmupEffecter>BANW_Effecter_NewA</warmupEffecter>
      <soundCast>ThrowGrenade</soundCast>
      <verbClass>Verb_CastAbility</verbClass> <!-- 改为投射物动词类 -->
      <range>69.9</range><!-- 投掷范围 -->
      <warmupTime>1</warmupTime><!-- 前摇时间 -->
      <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
      <requireLineOfSight>false</requireLineOfSight><!-- 不需要视线 -->
      <targetParams><!-- 目标参数设置 -->
        <canTargetLocations>true</canTargetLocations> <!-- 可以瞄准地面位置 -->
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetHumans>true</canTargetHumans>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>BAWN_Mari_EX_Boom</projectileDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
        <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
        <showBattleFormula>true</showBattleFormula>
        <!-- 悬浮预览用的战斗段配置，只用于显示公式，不直接造成伤害。 -->
        <previewActions>
          <li>
            <!-- 固定基础伤害，0 表示只吃攻击力倍率。 -->
            <!-- 最终攻击力倍率，2.0 表示造成 200% 攻击力伤害。 -->
            <attackPowerRatio>3.64</attackPowerRatio>
            <!-- 伤害类型。 -->
            <damageDef>BANC_Damage_shenmi</damageDef>
            <!-- 是否允许暴击。 -->
            <canCrit>true</canCrit>
            <!-- 是否应用攻击类型与护甲类型克制。 -->
            <applyAffinity>true</applyAffinity>
            <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
            <isExSkill>false</isExSkill>
          </li>
        </previewActions>
      </li>
    </modExtensions>
  </AbilityDef>
  <DamageDef ParentName="BANC_Damage_shenmi">
    <defName>BANC_Damage_Mari_EXX</defName><!--通用贯通-->
    <explosionHeatEnergyPerCell>5</explosionHeatEnergyPerCell>
    <explosionCellFleck>BlastDry</explosionCellFleck>
    <explosionColorCenter>(0.0, 0.8, 1.0)</explosionColorCenter>
    <explosionColorEdge>(0.0, 0.5, 0.8)</explosionColorEdge>
    <soundExplosion>Explosion_Bomb</soundExplosion>
    <combatLogRules>Damage_Bomb</combatLogRules>
  </DamageDef>
  <ThingDef ParentName="BaseBullet">
    <defName>BAWN_Mari_EX_Boom</defName>
    <label>净化的洗礼</label>
    <projectile>
      <explosionRadius>3.9</explosionRadius>
      <damageDef>BANC_Damage_Mari_EXX</damageDef><!--子弹类型-->
      <damageAmountBase>15</damageAmountBase><!--子弹伤害-->
      <stoppingPower>0.5</stoppingPower><!--抑制-->
      <armorPenetrationBase>2</armorPenetrationBase><!--穿透-->
      <speed>220</speed><!--子弹速度-->
    </projectile>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <shaderType>MoteGlow</shaderType><!-- 使用的着色器类型，用于发光效果 -->
      <drawSize>3.5</drawSize>
      <texPath>Projectile/kongbai</texPath>
      <graphicClass>BANWlLib.Effects.Graphic_BAAbSingle</graphicClass>
    </graphicData>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.BattleProjectileExtension">
        <attackPowerRatio>3.64</attackPowerRatio>
         <isNormalAttack>false</isNormalAttack>
        <canCrit>true</canCrit>
        <isExSkill>false</isExSkill>
      </li>
    </modExtensions>
  </ThingDef>
  <AbilityDef>
    <defName>BAWN_Mari_EXX</defName>
    <label>神圣的庇护</label>
    <description>赋予一名友军单位自身治愈力328%的护盾(持续20秒)</description>
    <iconPath>Ability/Icon/Mari/Mari_EXX</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <hotKey>Misc5</hotKey>
    <targetRequired>true</targetRequired><!-- 需要一个目标，不能对地面使用 -->
    <warmupStartSound>Mari_Skill_EXX</warmupStartSound>
    <hostile>false</hostile>
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>true</drawAimPie>
      <range>69.9</range><!-- 施法范围 -->
      <warmupTime>1.0</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf><!-- 不能选自己 -->
        <canTargetPawns>true</canTargetPawns><!-- 可以选 Pawn -->
        <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
        <canTargetAnimals>false</canTargetAnimals><!-- 不能选动物 -->
        <canTargetHumans>true</canTargetHumans><!-- 可以选人类 -->
        <canTargetMechs>false</canTargetMechs><!-- 不能选机械体 -->
      </targetParams>
    </verbProperties>
<comps>
  <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Mari_Ef_A</effecterDef>
        <maintainForTicks>600</maintainForTicks>
      </li>
      <li Class="BANWlLib.BattleSystem.CompProperties_AbilityApplyBattleAction">  <!-- 战斗动作应用组件：技能触发时执行指定的战斗动作 -->
        <applyToSelf>false</applyToSelf>  <!-- false=对目标生效（对友军施加护盾） -->
        <action>
          <isShield>true</isShield>  <!-- 标记为护盾效果 -->
          <shieldPowerRatio>3.28</shieldPowerRatio>  <!-- 护盾量倍率：护盾值 = 最终治愈力 × 3.28 -->
          <shieldHediffDef>BANW_BattleShield_Mari</shieldHediffDef>  <!-- 护盾对应的 Hediff 定义（承载护盾值的健康状态） -->
          <affectFriendly>true</affectFriendly>  <!-- 对友方生效 -->
          <affectHostile>false</affectHostile>  <!-- 不对敌方生效 -->
        </action>
      </li>
    </comps>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">  <!-- 战斗公式预览扩展：技能图标悬浮时显示护盾量预览 -->
        <showBattleFormula>true</showBattleFormula>  <!-- 是否在 Tooltip 中展开战斗公式 -->
        <previewActions>  <!-- 预览用动作配置，仅用于显示，不实际触发 -->
          <li>
            <isShield>true</isShield>
            <shieldPowerRatio>3.28</shieldPowerRatio>
            <shieldHediffDef>BANW_BattleShield_Mari</shieldHediffDef>
            <affectFriendly>true</affectFriendly>
            <affectHostile>false</affectHostile>
          </li>
        </previewActions>
      </li>
    </modExtensions>
  </AbilityDef>
  <HediffDef>
    <defName>BANW_BattleShield_Mari</defName>
    <label>护盾</label>
    <defaultLabelColor>(0,255,255)</defaultLabelColor>
    <description>吸收下一次受到的伤害，护盾不足时也会完整抵住本次伤害。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <makesSickThought>false</makesSickThought>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="BANWlLib.BattleSystem.HediffCompProperties_BattleShield" />
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>
          <min>1200</min>
          <max>1200</max>
        </disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Shield_Ef_A</stateEffecter>
      </li>
    </comps>
    <stages>
      <li>
        <label>护盾</label>
      </li>
    </stages>
  </HediffDef>

    
</Defs>
