
<Defs>
  <AbilityDef>
    <defName>BAWN_Hasumi_B_EXX</defName>
    <label>必中穿甲射击</label>
    <description>对扇形范围的敌方单位造成自身攻击力866%的伤害</description>
    <iconPath>Ability/Icon/Hoshiro/Hoshiro_EXX</iconPath>
    <cooldownTicksRange>1000</cooldownTicksRange>
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <hostile>true</hostile>
    <hotKey>Misc12</hotKey>
    <warmupStartSound>Hasumi_B_ExxSkill</warmupStartSound>
    
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <statBases>
  <Ability_Duration>43</Ability_Duration>
 </statBases>
    <verbProperties Class="BANWlLib.BaVerb.VerbProperties_SustainedAreaAttack">
      <warmupEffecter>BANW_Hasumi_B_Ef_A</warmupEffecter>
      <!-- 扇形弧度 --> 
      <soundCast></soundCast>
      <fanArc>44</fanArc>
      <verbClass>BANWlLib.BaVerb.Verb_SustainedAreaAttack</verbClass>
      <label>必中穿甲射击</label>
      <!-- 绑定的JOB -->
      <JobDef>BANW_Job_Skill_Hasumi_B_EXX</JobDef> <!-- 技能定义标识符 -->
      <violent>true</violent> <!-- 是否为暴力行为 -->
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed> <!-- 是否强制正常时间速度 -->
      <warmupTime>1.2</warmupTime> <!-- 预热时间（秒） -->
      <range>62.9</range> <!-- 作用范围 -->
      <requireLineOfSight>false</requireLineOfSight> <!-- 是否需要视线 -->
      <targetParams>
        <canTargetLocations>true</canTargetLocations> <!-- 是否可以瞄准位置 -->
        <canTargetPawns>true</canTargetPawns> <!-- 是否可以瞄准pawn（人物） -->
        <canTargetBuildings>false</canTargetBuildings> <!-- 是否可以瞄准建筑物 -->
      </targetParams>
    </verbProperties>
    <modExtensions>
     
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
      <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
      <showBattleFormula>true</showBattleFormula>
      <!-- 悬浮预览用的战斗段配置，只用于显示公式，不直接造成伤害。 -->
      <previewActions>
        <li>
          <!-- 固定基础伤害，0 表示只吃攻击力倍率。 -->
          <!-- 最终攻击力倍率，2.0 表示造成 200% 攻击力伤害。 -->
          <attackPowerRatio>8.66</attackPowerRatio>
          <!-- 伤害类型。 -->
          <damageDef>BANC_Damage_guantong</damageDef>
          <!-- 是否允许暴击。 -->
          <canCrit>true</canCrit>
          <!-- 是否应用攻击类型与护甲类型克制。 -->
          <applyAffinity>true</applyAffinity>
          <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
          <isExSkill>true</isExSkill>
        </li>
      </previewActions>
    </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
  <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
  <hediffDef>BAWN_Hasumi_buff_A</hediffDef><!-- 要添加的状态效果定义名 -->
  <onlyApplyToSelf>true</onlyApplyToSelf> <!-- 仅对自己生效 -->
  <replaceExisting>false</replaceExisting><!-- 如果已有同类效果，则替换它 -->
  </li>
   <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost">
        <cost>5</cost>
      </li>
    </comps>
  </AbilityDef>
   <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Hasumi_buff_A</defName>
        <!-- 显示名称 -->
        <label>西瓜片</label>
        <!-- 效果描述 -->
        <description>暴击伤害增加[西瓜片]层数x6%（持续43秒）</description>
        <defaultLabelColor>(90, 255, 112)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>false</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <comps>
      <li Class="BANWlLib.BattleSystem.HediffCompProperties_BattleStack">
        <!-- 最大层数，超过后只刷新时间。 -->
        <maxStacks>3</maxStacks>
        <!-- 重复施加时是否重置持续时间。 -->
        <refreshDurationOnApply>true</refreshDurationOnApply>
        <!-- 状态持续时间，单位 tick。 -->
        <durationTicks>1200</durationTicks>
        <!-- 到期后是否移除 Hediff。 -->
        <removeOnExpire>true</removeOnExpire>
        <!-- 同一个叠层状态内可以配置多个属性组，每组按当前层数取值。 -->
        <statGroups>
          <li>
            <!-- 最终伤害倍率加值：30% / 70% / 100%。 -->
            <targetStat>BANW_CriticalDamage</targetStat>
            <stackValues>
              <li>0.06</li>
              <li>0.12</li>
              <li>0.18</li>
              <li>0.24</li>
            </stackValues>
          </li>
        </statGroups>
      </li>


    </comps>

    </HediffDef>

