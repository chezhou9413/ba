  <!-- 定义一个状态效果（Hediff），用于持续治疗 -->
  <HediffDef>
    <!-- 状态的唯一标识符 -->
    <defName>BAWN_Wakamo_A_Buff_A</defName>
    <!-- 显示名称 -->
    <label>翡翠花占</label>
    <!-- 效果描述 -->
    <description>翡翠花占</description>
    <defaultLabelColor>(255, 153, 255)</defaultLabelColor>
    <!-- 是否为负面效果（会影响心情等） -->
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <everCurableByItem>false</everCurableByItem>
    <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
    <stages>
      <li>
        <statOffsets>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>300</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Wakamo_A_Ef_D</stateEffecter>
      </li>
    </comps>
  </HediffDef>
  <AbilityDef>
    <defName>BAWN_Wakamo_A_EX</defName>
    <label>只为您一人</label>
    <description>根据自身使用该技能的次数，对自身造成以下效果中的1种\n第1次：攻击力增加31%.承伤率减少9%.\n第2次：攻击力增加62%.承伤率减少19%\n第3次：攻击力增加99%.承伤率减少29%（持续120秒）</description>
    <iconPath>Ability/Icon/Wakamo_A/Wakamo_EX</iconPath>
    <cooldownTicksRange>21600</cooldownTicksRange>
    <hotKey>Misc12</hotKey>
    <charges>3</charges> <!-- 设置该能力有 5 次充能次数。-->
    <warmupStartSound>Wakamo_A_Skill_EX</warmupStartSound>
    <warmupEffecter>BANW_Wakamo_A_Ef_A</warmupEffecter>
    <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
    <stunTargetWhileCasting>True</stunTargetWhileCasting><!-- 施法时是否定身目标 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
    <targetRequired>false</targetRequired><!-- 对自己使用 -->
    <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
    <hostile>false</hostile><!-- 是否是敌对行为 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
    <statBases>
      <!-- 持续时间：20 秒 = 1200 ticks -->
      <Ability_Duration>120</Ability_Duration>
    </statBases>
    <verbProperties>
      <soundCast>Aoba_Skill_EX</soundCast>
      <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
      <drawAimPie>false</drawAimPie><!-- 不绘制瞄准圈 -->
      <range>-1</range><!-- 作用范围：-1 表示只能近战接触 -->
      <warmupTime>2</warmupTime><!-- 前摇时间（单位：秒） -->
      <targetParams><!-- 目标参数设置 -->
        <canTargetSelf>true</canTargetSelf> <!-- 可以选自己 -->
        <canTargetPawns>false</canTargetPawns><!-- 不能选其他生物 -->
        <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
        <canTargetAnimals>false</canTargetAnimals> <!-- 不能选动物 -->
        <canTargetHumans>false</canTargetHumans><!-- 不能选人类 -->
        <canTargetMechs>false</canTargetMechs><!-- 不能选机械体 -->
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Effecter_B</effecterDef>
        <maintainForTicks>60</maintainForTicks>
      </li>
      <li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
        <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
        <hediffDef>BAWN_Wakamo_A_buff</hediffDef><!-- 要添加的状态效果定义名 -->
        <onlyApplyToSelf>true</onlyApplyToSelf> <!-- 仅对自己生效 -->
        <replaceExisting>false</replaceExisting><!-- 如果已有同类效果，则替换它 -->
      </li>

    </comps>
  </AbilityDef>
  <HediffDef>
    <defName>BAWN_Wakamo_A_buff</defName>
    <label>只为您一人</label>
    <description>根据自身使用该技能的次数，对自身造成以下效果中的1种\n第1次：攻击力增加31%.承伤系数减少9%.\n第2次：攻击力增加62%.承伤系数减少19%\n第3次：攻击力增加99%.承伤率减少29%</description>
    <defaultLabelColor>(255, 210, 80)</defaultLabelColor>
    <isBad>false</isBad>
    <hediffClass>BANWlLib.BattleSystem.Hediff_BattleStack</hediffClass>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="BANWlLib.BattleSystem.HediffCompProperties_BattleStack">
        <!-- 最大层数，超过后只刷新时间。 -->
        <maxStacks>3</maxStacks>
        <!-- 重复施加时是否重置持续时间。 -->
        <refreshDurationOnApply>true</refreshDurationOnApply>
        <!-- 状态持续时间，单位 tick。 -->
        <durationTicks>1200</durationTicks>
        <!-- 到期后是否移除 Hediff。 -->
        <removeOnExpire>true</removeOnExpire>
        <!-- 同一个叠层状态内可以配置多个属性组，每组按当前层数取值。 -->
        <statGroups>
          <li>
            <!-- 最终伤害倍率加值：30% / 70% / 100%。 -->
            <targetStat>BANW_FinalDamageMultiplier</targetStat>
            <stackValues>
              <li>0.30</li>
              <li>0.70</li>
              <li>1.00</li>
            </stackValues>
          </li>
          <li>
            <!-- 暴击率加值：5% / 10% / 15%。 -->
            <targetStat>IncomingDamageFactor</targetStat>
            <stackValues>
              <li>-0.09</li>
              <li>-0.19</li>
              <li>-0.29</li>
            </stackValues>
          </li>
        </statGroups>
      </li>


    </comps>
  </HediffDef>
</Defs>