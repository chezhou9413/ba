
<Defs>
<AbilityDef>
<defName>BAWN_Nozomi_EX</defName>
 <label>在这边哟～！</label>
 <description>增加自身振动克制率54%（持续26秒）</description>
 <iconPath>Ability/Icon/Ichika/Ichika_EX</iconPath>
 <cooldownTicksRange>1800</cooldownTicksRange>
 <hotKey>Misc12</hotKey>
 <warmupStartSound>Nozomi_Skill_EX</warmupStartSound>
 <warmupEffecter>BANW_Nozomi_Ef_A</warmupEffecter>
 <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
 <stunTargetWhileCasting>True</stunTargetWhileCasting><!-- 施法时是否定身目标 -->  
 <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
 <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
 <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
 <targetRequired>false</targetRequired><!-- 对自己使用 -->
 <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
 <hostile>false</hostile><!-- 是否是敌对行为 -->
 <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
 <statBases>
<!-- 持续时间：20 秒 = 1200 ticks -->
  <Ability_Duration>26</Ability_Duration>
 </statBases>
 <verbProperties>
 <soundCast></soundCast>
 <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
 <drawAimPie>false</drawAimPie><!-- 不绘制瞄准圈 -->
 <range>-1</range><!-- 作用范围：-1 表示只能近战接触 -->
 <warmupTime>4</warmupTime><!-- 前摇时间（单位：秒） -->
 <targetParams><!-- 目标参数设置 -->
  <canTargetSelf>true</canTargetSelf> <!-- 可以选自己 -->
  <canTargetPawns>false</canTargetPawns><!-- 不能选其他生物 -->
  <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
  <canTargetAnimals>false</canTargetAnimals> <!-- 不能选动物 -->
  <canTargetHumans>false</canTargetHumans><!-- 不能选人类 -->
  <canTargetMechs>false</canTargetMechs><!-- 不能选机械体 -->
  </targetParams>
  </verbProperties>
  <comps>
    <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Effecter_B</effecterDef>
        <maintainForTicks>60</maintainForTicks>
      </li>
<li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
  <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
  <hediffDef>BAWN_Nozomi_buff</hediffDef><!-- 要添加的状态效果定义名 -->
  <onlyApplyToSelf>true</onlyApplyToSelf> <!-- 仅对自己生效 -->
  <replaceExisting>false</replaceExisting><!-- 如果已有同类效果，则替换它 -->
</li>

</comps>
</AbilityDef>
    <!-- 定义一个状态效果（Hediff），用于持续治疗 -->
    <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Nozomi_buff</defName>
        <!-- 显示名称 -->
        <label>在这边哟～！</label>
        <!-- 效果描述 -->
        <description>增加自身振动克制率54%。持续26秒</description>
        <defaultLabelColor>(0, 0, 204)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>false</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
          <stages>
          <li>     
           <statOffsets>
         <BANW_AffinityBonus_Vibration>0.54</BANW_AffinityBonus_Vibration>
           </statOffsets>
           </li>
          </stages>
        <comps>
        <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>1200</disappearsAfterTicks>
      </li>
      
    </comps>
    </HediffDef>
  
<AbilityDef>
  <defName>BAWN_Nozomi_EXX</defName>
  <label>助推启动！</label>
  <description>对直线范围内的1名指定敌方单位造成1557%自身攻击力的伤害</description>
  <iconPath>Ability/Icon/Nozomi/Nozomi_B</iconPath>
  <cooldownTicksRange>3600</cooldownTicksRange>
  <hotKey>Misc11</hotKey>
  <warmupStartSound>Nozomi_Skill_EXX</warmupStartSound>
  <showPsycastEffects>False</showPsycastEffects>
  <stunTargetWhileCasting>false</stunTargetWhileCasting>
  <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
  <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
  <showWhenDrafted>True</showWhenDrafted>
  <hostile>true</hostile>
   <warmupEffecter>BANW_Nozomi_Ef_C</warmupEffecter>
  <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
  <verbProperties>
    <warmupEffecter>BANW_Nozomi_Ef_B</warmupEffecter>
    <!-- 发射投射物的技能动词，实际命中逻辑由 projectileDef 上的 Projectile_PiercingArea 执行。 -->
    <soundCast>Nozomi_Skill_EX_D</soundCast>
    <verbClass>BANWlLib.BaVerb.Verb_CastAbilityWithTargetPreview</verbClass>
    <range>44</range>
    <warmupTime>2.0</warmupTime>
    <requireLineOfSight>false</requireLineOfSight>
    <targetParams>
      <!-- 直线弹允许瞄准地面、Pawn 和建筑，用于测试穿墙与打墙。 -->
      <canTargetLocations>false</canTargetLocations>
      <canTargetSelf>false</canTargetSelf>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>false</canTargetBuildings>
      <canTargetAnimals>true</canTargetAnimals>
      <canTargetHumans>true</canTargetHumans>
      <canTargetMechs>true</canTargetMechs>
    </targetParams>
  </verbProperties>
  <comps>
    <li Class="CompProperties_AbilityLaunchProjectile">
      <!-- 直线穿透弹 ThingDef。 -->
      <projectileDef>BANC_Bullet_Nozomi_EXX</projectileDef>
    </li>
  </comps>
  <modExtensions>
    <li Class="BANWlLib.BaVerb.AbilityTargetPreviewExtension">
      <!-- 预览形状：Line 表示从施法者朝目标方向显示直线范围。 -->
      <shape>Line</shape>
      <!-- 最大预览距离，小于等于 0 时使用技能当前有效射程。 -->
      <range>44</range>
      <!-- true 表示从 projectileDef 的 PiercingProjectileExtension 读取判定宽度；长度未显式配置时使用技能射程。 -->
      <usePiercingProjectileSize>true</usePiercingProjectileSize>
      <!-- 是否显示施法者最大射程圈。 -->
      <drawCasterRange>true</drawCasterRange>
      <!-- 是否显示鼠标目标格高亮。 -->
      <drawTargetHighlight>true</drawTargetHighlight>
    </li>
    <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
      <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
      <showBattleFormula>true</showBattleFormula>
      <!-- 悬浮预览用的战斗段配置，只用于显示公式，不直接造成伤害。 -->
      <previewActions>
        <li>
          <!-- 固定基础伤害，0 表示只吃攻击力倍率。 -->
          <!-- 最终攻击力倍率，2.0 表示造成 200% 攻击力伤害。 -->
          <attackPowerRatio>3.11</attackPowerRatio>
          <!-- 伤害类型。 -->
          <damageDef>BANC_Damage_Nozomi_EXX</damageDef>
          <!-- 是否允许暴击。 -->
          <canCrit>true</canCrit>
          <!-- 是否无论实际暴击判定都显示暴击文字。 -->
          <alwaysShowCriticalText>true</alwaysShowCriticalText>
          <!-- 是否应用攻击类型与护甲类型克制。 -->
          <applyAffinity>true</applyAffinity>
          <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
          <isExSkill>true</isExSkill>
        </li>
      </previewActions>
    </li>
  </modExtensions>
</AbilityDef>

<ThingDef ParentName="BaseBullet">
    <defName>BANC_Bullet_Nozomi_EXX</defName>
    <label>助推启动！</label>
    <thingClass>BANWlLib.Projectiles.Projectile_PiercingArea</thingClass>
    <projectile>
      <!-- 统一战斗层使用的伤害类型。 -->
      <damageDef>BANC_Damage_Nozomi_EXX</damageDef>
      <!-- 固定基础伤害交给扩展字段配置，这里保持 0。 -->
      <damageAmountBase>30</damageAmountBase>
      <stoppingPower>3</stoppingPower>
      <armorPenetrationBase>2</armorPenetrationBase>
      <speed>72</speed>
      <flyOverhead>true</flyOverhead>
    </projectile>
    <graphicData>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(4,12)</drawSize>
      <texPath>Projectile/kongbai</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <modExtensions>
      <li Class="BANWlLib.Projectiles.PiercingProjectileExtension">
        <!-- 同一目标每隔多少 tick 可再次受到该穿透弹伤害。 -->
        <damageIntervalTicks>2</damageIntervalTicks>
        <!-- 判定宽度，垂直于飞行方向。 -->
        <damageWidth>2</damageWidth>
        <!-- 判定长度，沿飞行方向。 -->
        <damageLength>8</damageLength>
        <!-- true 表示即使点击近处，也按 maxRange 沿点击方向飞到最大距离。 -->
        <extendToMaxRange>true</extendToMaxRange>
        <!-- 最大飞行距离，应与技能 range 保持一致。 -->
        <maxRange>49</maxRange>
        <!-- 是否跳过同阵营和盟友。 -->
        <immuneFriendlyFire>true</immuneFriendlyFire>
        
        
        <!-- 最终攻击力倍率，15.57 表示造成 1557% 攻击力伤害。 -->
        <attackPowerRatio>3.11</attackPowerRatio>
        <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
        <isExSkill>true</isExSkill>
        <!-- 是否允许暴击。 -->
        <canCrit>true</canCrit>
        <!-- 是否无论实际暴击判定都显示暴击文字。 -->
        <alwaysShowCriticalText>true</alwaysShowCriticalText>
        <!-- 是否应用攻击类型与护甲类型克制。 -->
        <applyAffinity>true</applyAffinity>
        <!-- 是否允许命中墙体等建筑。 -->
        <canHitBuilding>true</canHitBuilding>
        <!-- 是否命中敌对目标。 -->
        <affectHostile>true</affectHostile>
        <!-- 是否命中友方目标。 -->
        <affectFriendly>false</affectFriendly>
        <!-- 飞行中持续绑定到子弹上的特效。 -->
        <flightEffecter>BANW_Nozomi_Ef_D</flightEffecter>
        <!-- true 表示飞行特效跟随投射物 Thing。 -->
        <flightEffectAttachToProjectile>true</flightEffectAttachToProjectile>
        <!-- true 表示附着 Mote 按投射物朝向同步旋转。 -->
        <flightEffectRotateWithProjectile>true</flightEffectRotateWithProjectile>
        <!-- 飞行特效沿弹道方向偏移。 -->
        <flightEffectOffsetForward>0</flightEffectOffsetForward>
        <!-- 飞行特效向弹道右侧偏移。 -->
        <flightEffectOffsetRight>0</flightEffectOffsetRight>
        <!-- 飞行特效向上偏移。 -->
        <flightEffectOffsetUp>0</flightEffectOffsetUp>
        <!-- 命中 Pawn 或 Building 时触发的方向自适应特效。 -->
        <directionalImpactEffect></directionalImpactEffect>
        <!-- 是否对 Pawn 触发方向命中特效。 -->
        <directionalImpactOnPawn>true</directionalImpactOnPawn>
        <!-- 是否对 Building 触发方向命中特效。 -->
        <directionalImpactOnBuilding>true</directionalImpactOnBuilding>
        <!-- 方向命中特效飞出速度。 -->
        <directionalImpactSpeed>10</directionalImpactSpeed>
        <!-- 方向命中特效沿弹道方向向前偏移。 -->
        <directionalImpactOffsetForward>0.3</directionalImpactOffsetForward>
        <!-- 方向命中特效向上偏移，避免埋进地面。 -->
        <directionalImpactOffsetUp>0.5</directionalImpactOffsetUp>
        <!-- 飞行开始时的绘制缩放。 -->
        <startDrawScale>0.5</startDrawScale>
        <!-- 飞行结束时的绘制缩放。 -->
        <endDrawScale>1.2</endDrawScale>
        <!-- 淡入 tick 数。 -->
        <fadeInTicks>2</fadeInTicks>
        <!-- 淡出 tick 数。 -->
        <fadeOutTicks>5</fadeOutTicks>
      </li>
    </modExtensions>
  </ThingDef>

<AbilityDef>
  <defName>BAWN_Nozomi_StackBuff_Test</defName>
  <label>叠层攻击测试</label>
