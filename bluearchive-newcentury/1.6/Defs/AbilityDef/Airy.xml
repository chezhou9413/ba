<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<AbilityDef>
<defName>BAWN_Airy_EX</defName>
 <label>可能会头晕哦……？</label>
 <description>对1名敌方单位造成攻速减少35%。（持续30秒）</description>
 <iconPath>Ability/Icon/Airy/Airy_EX</iconPath>
 <cooldownTicksRange>1500</cooldownTicksRange>
 <hotKey>Misc12</hotKey>
 <warmupStartSound>Airy_Skill_EX</warmupStartSound>
 <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
 <stunTargetWhileCasting>False</stunTargetWhileCasting><!-- 施法时是否定身目标 -->  
 <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
 <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
 <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
 <targetRequired>true</targetRequired><!-- 对自己使用 -->
 <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
 <hostile>false</hostile><!-- 是否是敌对行为 -->
 <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
 <statBases>
<!-- 持续时间：20 秒 = 1200 ticks -->
  <Ability_Duration>16</Ability_Duration>
 </statBases>
 <verbProperties>
  <warmupEffecter>BANW_Effecter_A</warmupEffecter>
 <soundCast>BANW_Skill_A</soundCast>
 <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
 <drawAimPie>false</drawAimPie><!-- 不绘制瞄准圈 -->
 <range>35.9</range><!-- 作用范围：-1 表示只能近战接触 -->
 <warmupTime>1.0</warmupTime><!-- 前摇时间（单位：秒） -->
 <requireLineOfSight>false</requireLineOfSight><!-- 不需要视线 -->
 <targetParams><!-- 目标参数设置 -->
  <canTargetSelf>false</canTargetSelf> <!-- 可以选自己 -->
  <canTargetPawns>true</canTargetPawns><!-- 不能选其他生物 -->
  <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
  <canTargetAnimals>true</canTargetAnimals> <!-- 不能选动物 -->
  <canTargetHumans>true</canTargetHumans><!-- 不能选人类 -->
  <canTargetMechs>true</canTargetMechs><!-- 不能选机械体 -->
  </targetParams>
  </verbProperties>
  <comps>
<li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
  <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
  <hediffDef>BAWN_Airy_Buff_A</hediffDef><!-- 要添加的状态效果定义名 -->
  <onlyApplyToSelf>false</onlyApplyToSelf> <!-- 仅对自己生效 -->
  <replaceExisting>true</replaceExisting><!-- 如果已有同类效果，则替换它 -->
</li>
</comps>
</AbilityDef>
    <!-- 定义一个状态效果（Hediff），用于持续治疗 -->
    <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Airy_Buff_A</defName>
        <!-- 显示名称 -->
        <label>可能会头晕哦……？</label>
        <!-- 效果描述 -->
        <description>对1名敌方单位造成攻速减少35%。</description>
        <defaultLabelColor>(0,0,128)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
         <stages>
          <li>     
            <statOffsets>
            <AimingDelayFactor>0.35</AimingDelayFactor>
            <RangedCooldownFactor>0.35</RangedCooldownFactor>
            </statOffsets>
           </li>
          </stages>
        <comps>
        <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>1200</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Effecter_C</stateEffecter>
      </li>
    </comps>
    </HediffDef>
    
<AbilityDef>
<defName>BAWN_Airy_EXX</defName>
 <label>虽然有点可惜……嘿！</label>
 <description>对圆形范围内的敌方单位造成自身攻击力464%的伤害并且范围内的敌人移速减少23%，攻速减少26%（持续20秒）</description>
 <iconPath>Ability/Icon/Airy/Airy_EXX</iconPath>
 <cooldownTicksRange>3000</cooldownTicksRange>
 <hotKey>Misc12</hotKey>
 <warmupStartSound>Airy_Skill_EXX</warmupStartSound>
 <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
 <stunTargetWhileCasting>false</stunTargetWhileCasting><!-- 施法时是否定身目标 -->  
 <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
 <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
 <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
 <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
 <hostile>true</hostile><!-- 是否是敌对行为 -->
 <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
  <verbProperties>
    <!-- 普通点地技能，场地生成后由 Thing_BattleFieldController 自己 Tick。 -->
    <verbClass>BANWlLib.BaVerb.Verb_CastAbilityWithTargetPreview</verbClass>
    <range>69.9</range>
    <warmupTime>0.5</warmupTime>
 <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
 <requireLineOfSight>false</requireLineOfSight>      <!-- 是否需要视线 -->
 <targetParams><!-- 目标参数设置 -->
  <canTargetLocations>true</canTargetLocations> <!-- 可以瞄准地面位置 -->
  <canTargetSelf>false</canTargetSelf>
  <canTargetPawns>true</canTargetPawns>
  <canTargetBuildings>true</canTargetBuildings>
  <canTargetAnimals>true</canTargetAnimals>
  <canTargetHumans>true</canTargetHumans>
  <canTargetMechs>true</canTargetMechs>
    </targetParams>
  </verbProperties>
  <comps>
    <li Class="BANWlLib.BattleSystem.CompProperties_AbilitySpawnBattleField">
      <!-- 要生成的场地控制器 ThingDef。 -->
      <fieldThingDef>BANW_BattleField_Damage_Ariy</fieldThingDef>
      <!-- 覆盖场地默认持续时间，小于等于 0 时使用 ThingDef 扩展里的 durationTicks。 -->
      <durationTicksOverride>1200</durationTicksOverride>
    </li>
    <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Effecter_Airy_A</effecterDef>
        <maintainForTicks>1500</maintainForTicks>
      </li>
  </comps>
  <modExtensions>
    <li Class="BANWlLib.BaVerb.AbilityTargetPreviewExtension">
      <!-- 预览形状：Circle 表示以目标点为中心显示圆形场地范围。 -->
      <shape>Circle</shape>
      <!-- 最大施法距离，小于等于 0 时使用技能当前有效射程。 -->
      <range>69.9</range>
      <!-- true 表示从 fieldThingDef 的 BattleFieldControllerExtension 读取场地半径。 -->
      <useBattleFieldRadius>true</useBattleFieldRadius>
      <!-- 是否显示施法者最大射程圈。 -->
      <drawCasterRange>true</drawCasterRange>
      <!-- 是否显示鼠标目标格高亮。 -->
      <drawTargetHighlight>true</drawTargetHighlight>
    </li>
  </modExtensions>
</AbilityDef>
<ThingDef>
    <defName>BANW_BattleField_Damage_Ariy</defName>
    <label>虽然有点可惜……嘿！</label>
    <!-- 场地控制器实体，生成后独立 Tick，不再依赖施法者持续施法。 -->
    <thingClass>BANWlLib.BattleSystem.Thing_BattleFieldController</thingClass>
    <category>Mote</category>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Normal</tickerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UI/StarIcon</texPath>
      <drawSize>0.01</drawSize>
    </graphicData>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.BattleFieldControllerExtension">
        <!-- 场地存在时间，单位 tick。 -->
        <durationTicks>1200</durationTicks>
        <!-- 每隔多少 tick 结算一次 actions。 -->
        <intervalTicks>120</intervalTicks>
        <!-- 场地半径，使用圆形格子范围。 -->
        <radius>4.9</radius>
        <!-- true 表示生成场地时快照施法者属性，后续 Buff 变化不影响已生成场地。 -->
        <useCasterSnapshot>true</useCasterSnapshot>
        <!-- 每次结算时播放的范围提示特效。 -->
        <pulseEffecter></pulseEffecter>
        <!-- 场地每次脉冲执行的统一战斗动作列表。 -->
        <actions>
          <li>
            <!-- 固定基础值，和 attackPowerRatio 可叠加。 -->
            <baseAmount>38</baseAmount>
            <!-- 攻击力倍率，1.2 表示造成最终攻击力 120% 的伤害。 -->
            <attackPowerRatio>1.0</attackPowerRatio>
            <!-- 伤害 Def，决定伤害类型、命中特效和原版伤害表现。 -->
            <damageDef>BANC_Damage_Airy_EXX</damageDef>
            <!-- 护甲穿透。 -->
            <penetration>2</penetration>
            <!-- 是否允许暴击。 -->
            <canCrit>true</canCrit>
            <!-- 是否应用攻击类型与护甲类型克制。 -->
            <applyAffinity>true</applyAffinity>
            <!-- 是否影响敌对目标。 -->
            <affectHostile>true</affectHostile>
            <!-- 是否影响友方目标。 -->
            <affectFriendly>false</affectFriendly>
            <!-- 是否允许命中建筑。 -->
            <canHitBuilding>false</canHitBuilding>
          </li>
        </actions>
      </li>
    </modExtensions>
  </ThingDef>

<DamageDef ParentName="BANC_Damage_shenmi">
    <defName>BANC_Damage_Airy_EXX</defName><!--通用贯通-->
    <additionalHediffs><!--额外健康-->
      <li>
        <hediff>BAWN_Airy_Buff_B</hediff><!--健康类型-->
        <severityPerDamageDealt>1</severityPerDamageDealt><!--每点伤害增加的健康严重值-->
      </li>
    </additionalHediffs>
  </DamageDef>
   <!-- 定义一个状态效果（Hediff），用于持续治疗 -->
    <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Airy_Buff_B</defName>
        <!-- 显示名称 -->
        <label>虽然有点可惜……嘿！</label>
        <!-- 效果描述 -->
        <description>移速减少23%，攻速减少26%</description>
        <defaultLabelColor>(0,0,128)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
         <stages>
          <li>     
            <statOffsets>
            <AimingDelayFactor>0.26</AimingDelayFactor>
            <RangedCooldownFactor>0.26</RangedCooldownFactor>
            </statOffsets>
            <statFactors>
              <MoveSpeed>0.74</MoveSpeed>
            </statFactors>
           </li>
          </stages>
        <comps>
        <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>1200</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Effecter_C</stateEffecter>
      </li>
    </comps>
    </HediffDef>
  


 

</Defs>