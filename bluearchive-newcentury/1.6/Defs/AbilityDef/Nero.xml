          <li><delayTicks>68</delayTicks></li>
          <li><delayTicks>72</delayTicks></li>
          <li><delayTicks>76</delayTicks></li>
          <li><delayTicks>80</delayTicks></li>
          <li><delayTicks>84</delayTicks></li>
          <li><delayTicks>88</delayTicks></li>
          <li><delayTicks>92</delayTicks></li>
          <li><delayTicks>96</delayTicks></li>
          <li><delayTicks>100</delayTicks></li>
          <li><delayTicks>104</delayTicks></li>
          <li><delayTicks>108</delayTicks></li>
          <li><delayTicks>112</delayTicks></li>
          <li><delayTicks>116</delayTicks></li>
