      </li>
    </additionalHediffs>
  </DamageDef>
   <!-- 定义一个状态效果（Hediff），用于持续治疗 -->
    <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Kasumi_Buff_A</defName>
        <!-- 显示名称 -->
        <label>巨踵冲击</label>
        <!-- 效果描述 -->
        <description>乘伤系数增加33%</description>
        <defaultLabelColor>(0,0,128)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
         <stages>
          <li>     
       <statOffsets>
       <IncomingDamageFactor>0.33</IncomingDamageFactor>
            </statOffsets>
           </li>
          </stages>
        <comps>
