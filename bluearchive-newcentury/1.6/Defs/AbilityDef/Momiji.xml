<Defs>
  <AbilityDef>
    <defName>BAWN_Momiji_EX</defName>
    <label>知识的力量</label>
    <description>增加自身攻击力22%（持续20秒）</description>
    <iconPath>Ability/Icon/Chiaki/Chiaki_A</iconPath>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <hotKey>Misc12</hotKey>
    <warmupStartSound>Momiji_Skill_EX</warmupStartSound>
    <warmupEffecter>BANW_Effecter_A</warmupEffecter>
    <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
    <stunTargetWhileCasting>True</stunTargetWhileCasting><!-- 施法时是否定身目标 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
    <targetRequired>false</targetRequired>
    <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
    <hostile>false</hostile><!-- 是否是敌对行为 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
    <statBases>
      <Ability_Duration>20</Ability_Duration>
    </statBases>
    <verbProperties>
      <soundCast>Aoba_Skill_EX</soundCast>
      <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
      <drawAimPie>False</drawAimPie><!-- 不绘制瞄准圈 -->
      <range>-1</range><!-- 作用范围：-1 表示只能近战接触 -->
      <warmupTime>2</warmupTime><!-- 前摇时间（单位：秒） -->
      <targetParams><!-- 目标参数设置 -->
        <canTargetSelf>true</canTargetSelf> <!-- 可以选自己 -->
        <canTargetPawns>false</canTargetPawns><!-- 不能选其他生物 -->
        <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
        <canTargetAnimals>false</canTargetAnimals> <!-- 不能选动物 -->
        <canTargetHumans>false</canTargetHumans><!-- 不能选人类 -->
        <canTargetMechs>false</canTargetMechs><!-- 不能选机械体 -->
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Effecter_B</effecterDef>
        <maintainForTicks>60</maintainForTicks>
      </li>
      <li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
        <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
        <hediffDef>BAWN_Momiji_buff_A</hediffDef><!-- 要添加的状态效果定义名 -->
        <onlyApplyToSelf>true</onlyApplyToSelf> <!-- 仅对自己生效 -->
        <replaceExisting>false</replaceExisting><!-- 如果已有同类效果，则替换它 -->
      </li>

    </comps>
  </AbilityDef>

  <!-- 定义一个状态效果（Hediff），用于持续治疗 -->
  <HediffDef>
    <!-- 状态的唯一标识符 -->
    <defName>BAWN_Momiji_buff_A</defName>
    <!-- 显示名称 -->
    <label>知识的力量</label>
    <!-- 效果描述 -->
    <description>增加自身攻击力22%（持续20秒）</description>
    <defaultLabelColor>(90, 255, 112)</defaultLabelColor>
    <!-- 是否为负面效果（会影响心情等） -->
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <everCurableByItem>false</everCurableByItem>
    <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
    <stages>
      <li>
        <statOffsets>
          <BANW_FinalDamageMultiplier>+0.22</BANW_FinalDamageMultiplier>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>60</disappearsAfterTicks>
      </li>

    </comps>

  </HediffDef>
  <AbilityDef>
    <defName>BAWN_Momiji_EXX</defName>
    <label>伟大的沟通方式</label>
    <description>对圆形范围内的敌方单位造成自身攻击力364%的伤害</description>
    <iconPath>Ability/Icon/Kasumi/Kasumi_EXX</iconPath>
    <cooldownTicksRange>1500</cooldownTicksRange>
    <hotKey>Misc12</hotKey>
    <warmupStartSound>Momiji_Skill_EXX</warmupStartSound>
    <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
    <stunTargetWhileCasting>false</stunTargetWhileCasting><!-- 施法时是否定身目标 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
    <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
    <hostile>true</hostile><!-- 是否是敌对行为 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
    <verbProperties>
      <warmupEffecter></warmupEffecter>
      <soundCast>ThrowGrenade</soundCast>
      <verbClass>Verb_CastAbility</verbClass> <!-- 改为投射物动词类 -->
      <range>45.9</range><!-- 投掷范围 -->
      <warmupTime>1</warmupTime><!-- 前摇时间 -->
      <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
      <requireLineOfSight>false</requireLineOfSight><!-- 不需要视线 -->
      <targetParams><!-- 目标参数设置 -->
        <canTargetLocations>true</canTargetLocations> <!-- 可以瞄准地面位置 -->
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetHumans>true</canTargetHumans>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>BAWN_Momiji_EX_Boom</projectileDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
        <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
        <showBattleFormula>true</showBattleFormula>
        <!-- 悬浮预览用的战斗段配置，只用于显示公式，不直接造成伤害。 -->
        <previewActions>
          <li>
            <!-- 固定基础伤害，0 表示只吃攻击力倍率。 -->
            <!-- 最终攻击力倍率，2.0 表示造成 200% 攻击力伤害。 -->
            <attackPowerRatio>3.56</attackPowerRatio>
            <!-- 伤害类型。 -->
            <damageDef>BANC_Damage_zhendong</damageDef>
            <!-- 是否允许暴击。 -->
            <canCrit>true</canCrit>
            <!-- 是否应用攻击类型与护甲类型克制。 -->
            <applyAffinity>true</applyAffinity>
            <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
            <isExSkill>true</isExSkill>
          </li>
        </previewActions>
      </li>
    </modExtensions>
  </AbilityDef>
  <ThingDef ParentName="BaseBullet">
    <defName>BAWN_Momiji_EX_Boom</defName>
    <label>伟大的沟通方式</label>
    <projectile>
      <explosionRadius>3.56</explosionRadius>
      <damageDef>BANC_Damage_Momiji_EXX</damageDef><!--子弹类型-->
      <damageAmountBase>90</damageAmountBase><!--子弹伤害-->
      <stoppingPower>1.5</stoppingPower><!--抑制-->
      <armorPenetrationBase>2</armorPenetrationBase><!--穿透-->
      <speed>50</speed><!--子弹速度-->
    </projectile>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <shaderType>TransparentPostLight</shaderType><!-- 使用的着色器类型，用于发光效果 -->
      <drawSize>3.5</drawSize>
      <texPath>Projectile/Bullet_Momiji</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.BattleProjectileExtension">
        <attackPowerRatio>3.64</attackPowerRatio>
         <isNormalAttack>false</isNormalAttack>
        <canCrit>true</canCrit>
        <isExSkill>false</isExSkill>
      </li>
    </modExtensions>
  </ThingDef>
  <DamageDef ParentName="BANC_Damage_zhendong">
    <defName>BANC_Damage_Momiji_EXX</defName><!--通用贯通-->
    <explosionHeatEnergyPerCell>5</explosionHeatEnergyPerCell>
    <explosionCellFleck>BlastDry</explosionCellFleck>
    <explosionColorCenter>(0.85, 0.85, 0.85)</explosionColorCenter>
    <explosionColorEdge>(0.7, 0.7, 0.7)</explosionColorEdge>
    <soundExplosion>Explosion_Bomb</soundExplosion>
    <damageEffecter>BANW_Momiji_Ef_A</damageEffecter><!-- 爆炸造成伤害时触发的特效 -->
    <combatLogRules>Damage_Bomb</combatLogRules>
  </DamageDef>
</Defs>