<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<AbilityDef>
<defName>BAWN_Chinatsu_EXX</defName>
 <label>实施战术治疗</label>
 <description>对1名我方单位恢复自身治愈力342%的生命值</description>
 <iconPath>Ability/Icon/Chinatsu/Chinatsu_EXX</iconPath>
 <cooldownTicksRange>3000</cooldownTicksRange>
 <hotKey>Misc12</hotKey>
 <warmupStartSound>Chinatsu_Skill_EXX</warmupStartSound>
 <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
 <stunTargetWhileCasting>False</stunTargetWhileCasting><!-- 施法时是否定身目标 -->  
 <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
 <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
 <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
 <targetRequired>true</targetRequired><!-- 对自己使用 -->
 <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
 <hostile>false</hostile><!-- 是否是敌对行为 -->
 <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
 <statBases>
<!-- 持续时间：20 秒 = 1200 ticks -->
  <Ability_Duration>0.1</Ability_Duration>
 </statBases>
 <verbProperties>
  <warmupEffecter></warmupEffecter>
 <soundCast>BANW_Skill_A</soundCast>
 <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
 <drawAimPie>false</drawAimPie><!-- 不绘制瞄准圈 -->
 <range>65.9</range><!-- 作用范围：-1 表示只能近战接触 -->
 <warmupTime>1.0</warmupTime><!-- 前摇时间（单位：秒） -->
 <requireLineOfSight>false</requireLineOfSight><!-- 不需要视线 -->
 <targetParams><!-- 目标参数设置 -->
  <canTargetSelf>false</canTargetSelf> <!-- 可以选自己 -->
  <canTargetPawns>true</canTargetPawns><!-- 不能选其他生物 -->
  <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
  <canTargetAnimals>true</canTargetAnimals> <!-- 不能选动物 -->
  <canTargetHumans>true</canTargetHumans><!-- 不能选人类 -->
  <canTargetMechs>false</canTargetMechs><!-- 不能选机械体 -->
  <neverTargetHostileFaction>true</neverTargetHostileFaction><!-- 只能选友军 -->
  </targetParams>
  </verbProperties>
  <comps>
<li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
  <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
  <hediffDef>BAWN_Chinatsu_Buff_A</hediffDef><!-- 要添加的状态效果定义名 -->
  <onlyApplyToSelf>false</onlyApplyToSelf> <!-- 仅对自己生效 -->
  <replaceExisting>true</replaceExisting><!-- 如果已有同类效果，则替换它 -->
</li>
<li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Effecter_B</effecterDef>
        <maintainForTicks>60</maintainForTicks>
      </li>
</comps>
<modExtensions>
   <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
     <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
     <showBattleFormula>true</showBattleFormula>
     <!-- 悬浮预览用的治疗段配置，只用于显示公式，不直接治疗。 -->
     <previewActions>
       <li>
         <!-- 固定基础治疗，0 表示只吃治疗力倍率。 -->
         <baseAmount>0</baseAmount>
         <!-- 最终治疗力倍率，0.04 表示每次回复 4% 治疗力。 -->
         <healPowerRatio>3.42</healPowerRatio>
         <!-- true 表示该段是治疗。 -->
         <isHealing>true</isHealing>
         <!-- 治疗是否允许暴击。 -->
         <canCrit>false</canCrit>
         <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
         <isExSkill>false</isExSkill>
       </li>
     </previewActions>
   </li>
 </modExtensions>
</AbilityDef>
<AbilityDef>
<defName>BAWN_Chinatsu_EX</defName>
 <label>重整旗鼓</label>
 <description>对友方单位增加60%的闪避率（持续30秒）</description>
 <iconPath>Ability/Icon/Chinatsu/Chinatsu_EX</iconPath>
 <cooldownTicksRange>2400</cooldownTicksRange>
 <hotKey>Misc12</hotKey>
 <warmupStartSound>Chinatsu_Skill_EX</warmupStartSound>
 <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
 <stunTargetWhileCasting>False</stunTargetWhileCasting><!-- 施法时是否定身目标 -->  
 <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
 <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
 <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
 <targetRequired>true</targetRequired><!-- 对自己使用 -->
 <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
 <hostile>false</hostile><!-- 是否是敌对行为 -->
 <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
 <statBases>
<!-- 持续时间：20 秒 = 1200 ticks -->
  <Ability_Duration>30</Ability_Duration>
 </statBases>
 <verbProperties>
  <warmupEffecter>BANW_Effecter_A</warmupEffecter>
 <soundCast>BANW_Skill_A</soundCast>
 <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
 <drawAimPie>false</drawAimPie><!-- 不绘制瞄准圈 -->
 <range>65.9</range><!-- 作用范围：-1 表示只能近战接触 -->
 <warmupTime>1.0</warmupTime><!-- 前摇时间（单位：秒） -->
 <requireLineOfSight>false</requireLineOfSight><!-- 不需要视线 -->
 <targetParams><!-- 目标参数设置 -->
  <canTargetSelf>false</canTargetSelf> <!-- 可以选自己 -->
  <canTargetPawns>true</canTargetPawns><!-- 不能选其他生物 -->
  <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
  <canTargetAnimals>true</canTargetAnimals> <!-- 不能选动物 -->
  <canTargetHumans>true</canTargetHumans><!-- 不能选人类 -->
  <canTargetMechs>false</canTargetMechs><!-- 不能选机械体 -->
  <neverTargetHostileFaction>true</neverTargetHostileFaction><!-- 只能选友军 -->
  </targetParams>
  </verbProperties>
  <comps>
<li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
  <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
  <hediffDef>BAWN_Chinatsu_Buff_B</hediffDef><!-- 要添加的状态效果定义名 -->
  <onlyApplyToSelf>false</onlyApplyToSelf> <!-- 仅对自己生效 -->
  <replaceExisting>true</replaceExisting><!-- 如果已有同类效果，则替换它 -->
</li>
 <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Effecter_B</effecterDef>
        <maintainForTicks>60</maintainForTicks>
      </li>
</comps>
</AbilityDef>
    <!-- 定义一个状态效果（Hediff），用于持续治疗 -->
    <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Chinatsu_Buff_A</defName>
        <!-- 显示名称 -->
        <label>实施战术治疗</label>
        <!-- 效果描述 -->
        <description>恢复血量</description>
        <defaultLabelColor>(51, 255, 153)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>false</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
        <comps>
        <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>6</disappearsAfterTicks>
      </li>
       <li Class="BANWlLib.comp.HediffCompProps_Regeneration">
        <!-- 固定治疗量，设为 0 表示主要由治疗力倍率提供回复。 -->
        <healAmount>0</healAmount>
        <!-- 每 tick 回复最终治疗力的 4%。 -->
        <healPowerRatio>3.42</healPowerRatio>
        <!-- 每 tick 触发一次治疗。 -->
        <healIntervalTicks>6</healIntervalTicks>
        <!-- 是否允许治疗永久伤。 -->
        <isHeatScar>true</isHeatScar>
        <!-- true 表示该持续治疗会额外乘施法者 EX技能倍率。 -->
        <isExSkill>false</isExSkill>
      </li>
      <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Chinatsu_Ef_A</stateEffecter>
      </li>
    </comps>
    <tags>
      <li>Medical</li>
      <li>Stimulant</li>
      <li>Temporary</li>
      <li>PainRelief</li>
      <li>ConsciousnessBoost</li>
    </tags>
    </HediffDef>
    <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Chinatsu_Buff_B</defName>
        <!-- 显示名称 -->
        <label>重整旗鼓</label>
        <!-- 效果描述 -->
        <description>增加60%的闪避率（持续30秒）</description>
        <defaultLabelColor>(51, 255, 153)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>false</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
          <stages>
          <li>     
           <statOffsets>
           <BANW_Miss>+0.6</BANW_Miss>
            </statOffsets>
           </li>
          </stages>
        <comps>
        <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>1200</disappearsAfterTicks>
      </li>
    </comps>
    </HediffDef>

</Defs>