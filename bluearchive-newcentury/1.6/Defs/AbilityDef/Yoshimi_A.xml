<Defs>
<AbilityDef>
<defName>BAWN_Yoshimi_A_EXX</defName>
 <label>爆发式的高潮</label>
 <description>对自身攻击力增加112%，攻速增加112%(持续50秒)</description>
 <iconPath>Ability/Icon/Airy/Airy_A</iconPath>
 <cooldownTicksRange>1000</cooldownTicksRange>
 <hotKey>Misc12</hotKey>
 <warmupStartSound>Yoshimi_A_Skill_EXX</warmupStartSound>

 <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
 <stunTargetWhileCasting>True</stunTargetWhileCasting><!-- 施法时是否定身目标 -->  
 <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
 <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
 <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
 <targetRequired>false</targetRequired><!-- 对自己使用 -->
 <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
 <hostile>false</hostile><!-- 是否是敌对行为 -->
 <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
 <statBases>
<!-- 持续时间：20 秒 = 1200 ticks -->
  <Ability_Duration>50</Ability_Duration>
 </statBases>
 <verbProperties>
  <warmupEffecter>BANW_Yoshimi_A_Ef_A</warmupEffecter>
 <soundCast>Aoba_Skill_EX</soundCast>
 <verbClass>Verb_CastAbility</verbClass> <!-- 动词类，这里是触发型技能 -->
 <drawAimPie>false</drawAimPie><!-- 不绘制瞄准圈 -->
 <range>-1</range><!-- 作用范围：-1 表示只能近战接触 -->
 <warmupTime>5.0</warmupTime><!-- 前摇时间（单位：秒） -->
 <targetParams><!-- 目标参数设置 -->
  <canTargetSelf>true</canTargetSelf> <!-- 可以选自己 -->
  <canTargetPawns>false</canTargetPawns><!-- 不能选其他生物 -->
  <canTargetBuildings>false</canTargetBuildings><!-- 不能选建筑 -->
  <canTargetAnimals>false</canTargetAnimals> <!-- 不能选动物 -->
  <canTargetHumans>false</canTargetHumans><!-- 不能选人类 -->
  <canTargetMechs>false</canTargetMechs><!-- 不能选机械体 -->
  </targetParams>
  </verbProperties>
  <comps>
    <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>BANW_Effecter_B</effecterDef>
        <maintainForTicks>60</maintainForTicks>
      </li>
<li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
  <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
  <hediffDef>BAWN_Yoshimi_A_buff</hediffDef><!-- 要添加的状态效果定义名 -->
  <onlyApplyToSelf>true</onlyApplyToSelf> <!-- 仅对自己生效 -->
  <replaceExisting>false</replaceExisting><!-- 如果已有同类效果，则替换它 -->
</li>
<!-- COST 消耗组件：每次 EX 消耗 4 点。 -->
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost">
        <cost>10</cost>
      </li>
</comps>
</AbilityDef>
    <!-- 定义一个状态效果（Hediff），用于持续治疗 -->
    <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Yoshimi_A_buff</defName>
        <!-- 显示名称 -->
        <label>爆发式的高潮</label>
        <!-- 效果描述 -->
        <description>对自身攻击力增加112%，攻速增加112%(持续50秒)</description>
        <defaultLabelColor>(0, 0, 204)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>false</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
          <stages>
          <li>     
           <statOffsets>
          <BANW_FinalDamageMultiplier>1.12</BANW_FinalDamageMultiplier>
           <AimingDelayFactor>-0.56</AimingDelayFactor>
          <RangedCooldownFactor>-0.56</RangedCooldownFactor>
           </statOffsets>
           <statFactors>
				</statFactors>
           </li>
          </stages>
        <comps>
        <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>3000</disappearsAfterTicks>
      </li>
      
    </comps>
    </HediffDef>
  <AbilityDef>
    <defName>BAWN_Yoshimi_A_EX</defName>
    <label>视觉艺术家</label>
    <description>对一名敌人造成自身子弹攻击力的1352%的伤害</description>
    <iconPath>Ability/Icon/Yoshimi_A/Yoshimi_EX</iconPath>
    <cooldownTicksRange>1000</cooldownTicksRange>
    <hotKey>Misc12</hotKey>
    <warmupStartSound>Yoshimi_A_Skill_EX</warmupStartSound>
    
    <jobDef>BANW_Job_Nozomi_DelayedMultiShot_Test</jobDef>
    <showPsycastEffects>False</showPsycastEffects><!-- 是否显示心灵异能特效（如光束、粒子） -->
    <stunTargetWhileCasting>True</stunTargetWhileCasting><!-- 施法时是否定身目标 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <uiOrder>5</uiOrder><!-- 在 UI 中的排列顺序 -->
    <showWhenDrafted>True</showWhenDrafted><!-- 是否在征召状态时显示 -->
    <hostile>true</hostile><!-- 是否是敌对行为 -->
    <targetRequired>true</targetRequired><!-- 对自己使用 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence><!-- 施法者是否必须能进行暴力行为 -->
    <statBases>
    <Ability_Duration>4</Ability_Duration>
  </statBases>
    <verbProperties>
      <warmupEffecter>BANW_Yoshimi_A_Ef_B</warmupEffecter>
      <soundCast>BANW_Wp_AR_At</soundCast>
      <verbClass>BANWlLib.BaVerb.Verb_CastAbilityWithTargetPreview</verbClass> <!-- 动词类，这里是触发型技能 -->
      <range>34.9</range><!-- 作用范围：-1 表示只能近战接触 -->
      <warmupTime>1.0</warmupTime><!-- 前摇时间（单位：秒） -->
      <ai_IsWeapon>false</ai_IsWeapon> <!--AI
      不将此能力视为武器。-->
      <targetParams><!-- 目标参数设置 -->
        <canTargetSelf>false</canTargetSelf> <!-- 可以选自己 -->
        <canTargetPawns>true</canTargetPawns><!-- 不能选其他生物 -->
        <canTargetBuildings>true</canTargetBuildings><!-- 不能选建筑 -->
        <canTargetAnimals>true</canTargetAnimals> <!-- 不能选动物 -->
        <canTargetHumans>true</canTargetHumans><!-- 不能选人类 -->
        <canTargetMechs>true</canTargetMechs><!-- 不能选机械体 -->
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="BANWlLib.BattleSystem.CompProperties_AbilityMultiShotProjectile">
        <repeatShotSound>true</repeatShotSound>
        <!-- 默认子弹 Def，单发配置不覆盖时使用它。 -->
        <projectileDef></projectileDef>
        <!-- 是否允许本技能子弹对同阵营 Pawn 生效。 -->
        <canHitOwnPawn>true</canHitOwnPawn>
        <!-- 是否允许本技能子弹对同阵营建筑生效。 -->
        <canHitOwnBuilding>true</canHitOwnBuilding>
        <!-- 每个 li 代表一发，delayTicks 是相对施法完成时的发射延迟。 -->
        <cancelWhenCasterMoved>true</cancelWhenCasterMoved>
        <!-- 施法者倒地、死亡、眩晕或失去基础射击能力后，中断同一轮剩余子弹。 -->
        <requireCasterCanShoot>true</requireCasterCanShoot>
        <!-- 每发子弹到点时重新检查视线，视线被墙体或遮挡切断后中断同一轮剩余子弹。 -->
        <requireLineOfSightEachShot>true</requireLineOfSightEachShot>
        <!-- 连射队列未结束前每 tick 停止寻路，禁止施法者移动。 -->
        <lockCasterDuringSequence>true</lockCasterDuringSequence>
        <!-- 连射队列未结束前持续绘制主武器朝目标瞄准。 -->
        <drawPrimaryWeaponAimDuringSequence>true</drawPrimaryWeaponAimDuringSequence>
        <shots>
          <li>
            <delayTicks>0</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.12</attackPowerRatio>
          </li>
        
          <li>
            <delayTicks>7</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.12</attackPowerRatio>
          </li>
          
          <li>
            <delayTicks>14</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.12</attackPowerRatio>
          </li>
          
          <li>
            <delayTicks>21</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.12</attackPowerRatio>
          </li>
         
          <li>
            <delayTicks>28</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.13</attackPowerRatio>
          </li>
          
          <li>
            <delayTicks>35</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.13</attackPowerRatio>
          </li>

          <li>
            <delayTicks>42</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.13</attackPowerRatio>
          </li>

          <li>
            <delayTicks>49</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.13</attackPowerRatio>
          </li>

          <li>
            <delayTicks>56</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.13</attackPowerRatio>
          </li>

          <li>
            <delayTicks>63</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.13</attackPowerRatio>
          </li>

          <li>
            <delayTicks>70</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.13</attackPowerRatio>
          </li>

          <li>
            <delayTicks>77</delayTicks>
            <projectileDef>BANC_Bullet_Yoshimi_A_EX</projectileDef>
            <attackPowerRatio>1.13</attackPowerRatio>
          </li>
          
        </shots>
      </li>
    </comps>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
        <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
        <showBattleFormula>true</showBattleFormula>
      </li>
      <li Class="BANWlLib.BaVerb.AbilityTargetPreviewExtension">
        <shape>Circle</shape>
        <range>34.9</range>
        <drawCasterRange>true</drawCasterRange>
        <drawTargetHighlight>true</drawTargetHighlight>
      </li>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
      <showBattleFormula>true</showBattleFormula>
    </li>
    </modExtensions>
  </AbilityDef>
  <ThingDef ParentName="BaseBullet">
    <defName>BANC_Bullet_Yoshimi_A_EX</defName>
    <label>视觉艺术家子弹</label>
    <projectile>
      <damageDef>BANC_Damage_baofa</damageDef><!--子弹类型-->
      <damageAmountBase>26</damageAmountBase><!--子弹伤害-->
      <stoppingPower>20</stoppingPower><!--抑制-->
      <armorPenetrationBase>2</armorPenetrationBase><!--穿透-->
      <speed>120</speed><!--子弹速度-->
      <extraDamages>
      <li>
        <def>BANC_Damage_baofa</def>
        <amount>10</amount>
      </li>
    </extraDamages>
    </projectile>
    <graphicData>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(1,3)</drawSize>
      <texPath>Projectile/Bullet_Yoshimi_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  <modExtensions>
      <li Class="BANWlLib.BattleSystem.BattleProjectileExtension">
        <attackPowerRatio>1</attackPowerRatio>
         <isNormalAttack>false</isNormalAttack>
        <canCrit>true</canCrit>
        <isExSkill>false</isExSkill>
      <applyAffinity>true</applyAffinity>
      <canHitOwnPawn>true</canHitOwnPawn>
      <canHitOwnBuilding>true</canHitOwnBuilding>
      </li>

    </modExtensions>
  </ThingDef>
