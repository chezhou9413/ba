<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <AbilityDef>
    <defName>BAWN_Hanako_A_EXX</defName>
    <label>喷出来了好多呢♡</label>
    <description>对扇形范围的敌方单位造成自身攻击力707%的伤害</description>
    <iconPath>Ability/Icon/Hanako_A/Hanako_EXX</iconPath>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <charges>3</charges> <!-- 设置该能力有 5 次充能次数。-->
    <cooldownPerCharge>true</cooldownPerCharge> <!-- 每次使用后单独计算冷却时间。。-->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召状态下是否显示操作按钮 --> 
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召状态下是否禁用按钮 -->
    <hostile>true</hostile>
    <hotKey>Misc12</hotKey>
    <warmupStartSound>Hanako_A_Skill_EXX</warmupStartSound>
    <warmupEffecter></warmupEffecter>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <statBases>
  <Ability_Duration>20</Ability_Duration>
 </statBases>
    <verbProperties Class="BANWlLib.BaVerb.VerbProperties_SustainedAreaAttack">
      <!-- 扇形弧度 --> 
      <soundCast></soundCast>
      <TiggerHediff></TiggerHediff>
      <fanArc>60</fanArc>
      <verbClass>BANWlLib.BaVerb.Verb_SustainedAreaAttack</verbClass>
      <label>喷出来了好多呢♡</label>
      <!-- 绑定的JOB -->
      <JobDef>BANW_Job_Skill_Hanako_A_EXX</JobDef> <!-- 技能定义标识符 -->
      <violent>true</violent> <!-- 是否为暴力行为 -->
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed> <!-- 是否强制正常时间速度 -->
      <warmupTime>0.1</warmupTime> <!-- 预热时间（秒） -->
      <range>44</range> <!-- 作用范围 -->
      <requireLineOfSight>false</requireLineOfSight> <!-- 是否需要视线 -->
      <targetParams>
        <canTargetLocations>true</canTargetLocations> <!-- 是否可以瞄准位置 -->
        <canTargetPawns>true</canTargetPawns> <!-- 是否可以瞄准pawn（人物） -->
        <canTargetBuildings>false</canTargetBuildings> <!-- 是否可以瞄准建筑物 -->
      </targetParams>
    </verbProperties>
    <modExtensions>
      <li Class="BANWlLib.BaVerb.AbilityTargetPreviewExtension">
        <!-- 预览形状：Fan 表示从施法者朝目标方向显示扇形范围。 -->
        <shape>Fan</shape>
        <!-- 最大预览距离，小于等于 0 时使用技能当前有效射程。 -->
        <range>44</range>
        <!-- 扇形角度，需要和 verbProperties 里的 fanArc 保持一致。 -->
        <fanArc>60</fanArc>
        <!-- 是否显示施法者最大射程圈。 -->
        <drawCasterRange>true</drawCasterRange>
        <!-- 是否显示鼠标目标格高亮。 -->
        <drawTargetHighlight>true</drawTargetHighlight>
      </li>
      <li Class="BANWlLib.BattleSystem.AbilityBattleTooltipExtension">
      <!-- true 表示地图技能按钮悬浮时显示BA战斗公式。 -->
      <showBattleFormula>true</showBattleFormula>
      <!-- 悬浮预览用的战斗段配置，只用于显示公式，不直接造成伤害。 -->
      <previewActions>
        <li>
          <!-- 固定基础伤害，0 表示只吃攻击力倍率。 -->
          <baseAmount>30</baseAmount>
          <!-- 最终攻击力倍率，2.0 表示造成 200% 攻击力伤害。 -->
          <attackPowerRatio>7.07</attackPowerRatio>
          <!-- 伤害类型。 -->
          <damageDef>BANC_Damage_Nozomi_EXX</damageDef>
          <!-- 是否允许暴击。 -->
          <canCrit>true</canCrit>
          <!-- 是否应用攻击类型与护甲类型克制。 -->
          <applyAffinity>true</applyAffinity>
          <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
          <isExSkill>true</isExSkill>
        </li>
      </previewActions>
    </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff"><!-- 给目标添加一个 Hediff（状态效果） -->
  <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 实际执行效果的组件类 -->
  <hediffDef>BAWN_Hanako_buff_A</hediffDef><!-- 要添加的状态效果定义名 -->
  <onlyApplyToSelf>true</onlyApplyToSelf> <!-- 仅对自己生效 -->
  <replaceExisting>false</replaceExisting><!-- 如果已有同类效果，则替换它 -->
  </li>
    </comps>
  </AbilityDef>
   <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Hanako_buff_A</defName>
        <!-- 显示名称 -->
        <label>补充水分♡</label>
        <!-- 效果描述 -->
        <description>攻击力增加38%（持续20秒）</description>
        <defaultLabelColor>(90, 255, 112)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>false</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
          <stages>
          <li>     
           <statOffsets>
           <BANW_FinalDamageMultiplier>+0.38</BANW_FinalDamageMultiplier>
            </statOffsets>
           </li>
          </stages>
        <comps>
        <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>2400</disappearsAfterTicks>
      </li>
         <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Hanako_Ef_A</stateEffecter>
      </li> 
    </comps>

    </HediffDef>
