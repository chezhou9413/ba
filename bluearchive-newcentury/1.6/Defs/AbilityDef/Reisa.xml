        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
        <comps>
           <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>400</disappearsAfterTicks>
      </li>
         <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Reisa_Ef_C</stateEffecter>
      </li> 
    </comps>
    </HediffDef>

     <HediffDef>
        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Reisa_Hedi_C</defName>
        <!-- 显示名称 -->
        <label>宇泽玲纱的存在感</label>
        <!-- 效果描述 -->
        <description>乘伤系数增加11%(持续25秒)</description>
        <defaultLabelColor>(0,0,128)</defaultLabelColor>
        <!-- 是否为负面效果（会影响心情等） -->
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <!-- 属性限制调整，这里是 LifeStage 属性不受影响 -->
         <stages>
          <li>     
           <statOffsets>
        <IncomingDamageFactor>0.11</IncomingDamageFactor>
            </statOffsets>
           </li>
          </stages>
        <comps>
           <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>1500</disappearsAfterTicks>
      </li>
         <li Class="HediffCompProperties_Effecter">
        <stateEffecter>BANW_Effecter_CC</stateEffecter>
      </li> 
    </comps>
    </HediffDef>

<DamageDef ParentName="BANC_Damage_guantong">
