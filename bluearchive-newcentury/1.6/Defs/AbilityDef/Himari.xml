        <!-- 状态的唯一标识符 -->
        <defName>BAWN_Himari_buff</defName>
        <!-- 显示名称 -->
        <label>呵呵，见识一下我的实力吧</label>
        <!-- 效果描述 -->
        <description>提升105%的攻击力。持续13秒</description>
