<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <BANWlLib.BattleSystem.DamageAffinityMatrixDef>
    <defName>BANW_DamageAffinityMatrix_Default</defName>
    <label>蓝档属性克制矩阵</label>
    <!-- 没有攻击类型或防御类型时使用的默认倍率。 -->
    <defaultMultiplier>1.0</defaultMultiplier>
    <!-- 每一行代表一种攻击类型，entries 里按目标防御类型配置最终克制倍率。 -->
    <rows>
      <li>
        <!-- 爆发攻击，当前按轻装优势、特殊劣势处理。 -->
        <attackType>Explosion</attackType>
        <entries>
          <li><defenseType>Explosion</defenseType><multiplier>2.0</multiplier></li>
          <li><defenseType>Through</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Mysterious</defenseType><multiplier>0.5</multiplier></li>
          <li><defenseType>Vibration</defenseType><multiplier>0.5</multiplier></li>
          <li><defenseType>Composite</defenseType><multiplier>1.0</multiplier></li>
        </entries>
      </li>
      <li>
        <!-- 贯通攻击，当前按重装优势、弹力劣势处理。 -->
        <attackType>Through</attackType>
        <entries>
          <li><defenseType>Explosion</defenseType><multiplier>0.5</multiplier></li>
          <li><defenseType>Through</defenseType><multiplier>2.0</multiplier></li>
          <li><defenseType>Mysterious</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Vibration</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Composite</defenseType><multiplier>1.0</multiplier></li>
        </entries>
      </li>
      <li>
        <!-- 神秘攻击，当前按特殊优势、轻装劣势处理。 -->
        <attackType>Mysterious</attackType>
        <entries>
          <li><defenseType>Explosion</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Through</defenseType><multiplier>0.5</multiplier></li>
          <li><defenseType>Mysterious</defenseType><multiplier>2.0</multiplier></li>
          <li><defenseType>Vibration</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Composite</defenseType><multiplier>0.5</multiplier></li>
        </entries>
      </li>
      <li>
        <!-- 振动攻击，当前按弹力优势、重装劣势处理。 -->
        <attackType>Vibration</attackType>
        <entries>
          <li><defenseType>Explosion</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Through</defenseType><multiplier>0.5</multiplier></li>
          <li><defenseType>Mysterious</defenseType><multiplier>1.5</multiplier></li>
          <li><defenseType>Vibration</defenseType><multiplier>2.0</multiplier></li>
          <li><defenseType>Composite</defenseType><multiplier>0.5</multiplier></li>
        </entries>
      </li>
      <li>
        <!-- 复合攻击样例，默认只对复合防御优势。 -->
        <attackType>Composite</attackType>
        <entries>
          <li><defenseType>Explosion</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Through</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Mysterious</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Vibration</defenseType><multiplier>1.0</multiplier></li>
          <li><defenseType>Composite</defenseType><multiplier>2.0</multiplier></li>
        </entries>
      </li>
    </rows>
  </BANWlLib.BattleSystem.DamageAffinityMatrixDef>

  <ThingDef>
    <defName>BANW_BattleField_Damage_Template</defName>
    <label>脱手伤害场地模板</label>
    <!-- 场地控制器实体，生成后独立 Tick，不再依赖施法者持续施法。 -->
    <thingClass>BANWlLib.BattleSystem.Thing_BattleFieldController</thingClass>
    <category>Mote</category>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Normal</tickerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UI/StarIcon</texPath>
      <drawSize>0.01</drawSize>
    </graphicData>
    <modExtensions>
      <li Class="BANWlLib.BattleSystem.BattleFieldControllerExtension">
        <!-- 场地存在时间，单位 tick。 -->
        <durationTicks>600</durationTicks>
        <!-- 每隔多少 tick 结算一次 actions。 -->
        <intervalTicks>60</intervalTicks>
        <!-- 场地半径，使用圆形格子范围。 -->
        <radius>4.9</radius>
        <!-- true 表示生成场地时快照施法者属性，后续 Buff 变化不影响已生成场地。 -->
        <useCasterSnapshot>true</useCasterSnapshot>
        <!-- 每次结算时播放的范围提示特效。 -->
        <pulseEffecter>BANW_Effecter_A</pulseEffecter>
        <!-- 场地每次脉冲执行的统一战斗动作列表。 -->
        <actions>
          <li>
            <!-- 固定基础值，和 attackPowerRatio 可叠加。 -->
            <baseAmount>0</baseAmount>
            <!-- 攻击力倍率，1.2 表示造成最终攻击力 120% 的伤害。 -->
            <attackPowerRatio>1.2</attackPowerRatio>
            <!-- 伤害 Def，决定伤害类型、命中特效和原版伤害表现。 -->
            <damageDef>BANC_Damage_Nozomi_Train</damageDef>
            <!-- 护甲穿透。 -->
            <penetration>0.25</penetration>
            <!-- 是否允许暴击。 -->
            <canCrit>true</canCrit>
            <!-- 是否应用攻击类型与护甲类型克制。 -->
            <applyAffinity>true</applyAffinity>
            <!-- 是否影响敌对目标。 -->
            <affectHostile>true</affectHostile>
            <!-- 是否影响友方目标。 -->
            <affectFriendly>false</affectFriendly>
            <!-- 是否允许命中建筑。 -->
            <canHitBuilding>true</canHitBuilding>
          </li>
        </actions>
      </li>
    </modExtensions>
  </ThingDef>

  <HediffDef>
    <defName>BANW_BattleStack_Attack_Test</defName>
    <label>叠层攻击测试</label>
    <description>重复使用技能时按30%、70%、100%提高攻击力，并刷新持续时间。</description>
    <defaultLabelColor>(255, 210, 80)</defaultLabelColor>
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="BANWlLib.BattleSystem.HediffCompProperties_BattleStack">
        <!-- 叠层状态实际修改的战斗 Stat。 -->
        <targetStat>BANW_FinalDamageMultiplier</targetStat>
        <!-- 最大层数，超过后只刷新时间。 -->
        <maxStacks>3</maxStacks>
        <!-- 重复施加时是否重置持续时间。 -->
        <refreshDurationOnApply>true</refreshDurationOnApply>
        <!-- 状态持续时间，单位 tick。 -->
        <durationTicks>1200</durationTicks>
        <!-- 到期后是否移除 Hediff。 -->
        <removeOnExpire>true</removeOnExpire>
        <!-- 每层对应的最终数值，第一层 30%，第二层 70%，第三层 100%。 -->
        <stackValues>
          <li>0.30</li>
          <li>0.70</li>
          <li>1.00</li>
        </stackValues>
      </li>
    </comps>
  </HediffDef>

  <ThingDef ParentName="MoteBase">
    <defName>BANW_Mote_DirectionalImpact_Test</defName>
    <thingClass>MoteThrown</thingClass>
    <drawOffscreen>true</drawOffscreen>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Effect/HPP</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>1.5</drawSize>
    </graphicData>
    <mote>
      <!-- 方向命中特效显示时间，MoteThrown 的速度由 SubEffecter_DirectionalImpactMote 设置。 -->
      <fadeInTime>0.02</fadeInTime>
      <solidTime>0.20</solidTime>
      <fadeOutTime>0.18</fadeOutTime>
      <collide>false</collide>
    </mote>
  </ThingDef>

  <EffecterDef>
    <defName>BANW_Effecter_DirectionalImpact_Test</defName>
    <children>
      <li>
        <!-- 从穿透弹命中上下文读取弹道方向，并生成沿该方向飞出的 MoteThrown。 -->
        <subEffecterClass>BANWlLib.Projectiles.SubEffecter_DirectionalImpactMote</subEffecterClass>
        <!-- 实际飞出的 Mote。 -->
        <moteDef>BANW_Mote_DirectionalImpact_Test</moteDef>
        <!-- Mote 缩放倍率。 -->
        <scale>1</scale>
        <!-- Mote 自转速度。 -->
        <rotationRate>0</rotationRate>
      </li>
    </children>
  </EffecterDef>
</Defs>
