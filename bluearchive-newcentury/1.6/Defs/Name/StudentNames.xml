<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 学生共用种族的兜底名字生成器：仅用于让原版名字生成流程拿到一个有效规则，
       真正的学生姓名由各 PawnKindDef 的 ChezhouLib.Extension.kindRule.kindName 生成后覆盖。 -->
  <RulePackDef>
    <defName>NamerStudent</defName>
    <rulePack>
      <rulesStrings>
        <li>name->学生</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
  <RulePackDef>
		<defName>NamerHikali</defName>
		<rulePack>
			<rulesStrings>
				<li>name-&gt;[FirstName] [LastName]</li>
				<li>FirstName-&gt;光</li>
                <li>LastName-&gt;橘</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>
</Defs>