<?xml version="1.0" encoding="utf-8"?><Defs>
  <BANWlLib.BaDef.BaStudentDef>
    <defName>BANW_Hoshiro_A_Student</defName>
    <label>星野</label>
    <studentId>BANW_Hoshiro_A</studentId>
    <kindDef>BANW_Hoshiro_A</kindDef>

    <!-- 学生UI界面配置 -->
		<BaStudentUI>
			<!-- 学生头像路径，用于在UI中显示学生头像 -->
			<StudentAvatar>ManuaUI/Avatar/Hoshiro_A</StudentAvatar>
			<!-- 学生名称显示模式，Auto表示自动生成名称 -->
			<StudentName>Auto</StudentName>
			<!-- 角色立绘路径，用于显示学生的全身立绘图像 -->
			<CharacterimagePath>ManuaUI/Live/Hoshiro_A</CharacterimagePath>
			<!-- 背景图片路径，用于学生详情界面的背景 -->
			<BackgroundPath>ManuaUI/Bg/BG_Swimsuit02</BackgroundPath>
			<!-- 角色立绘的缩放倍数，1.2表示放大1.2倍 -->
			<CharacterimageOffsetSize>1.5</CharacterimageOffsetSize>
			<!-- 角色立绘在X轴上的偏移量，单位像素 -->
			<CharacterimageOffsetX>100</CharacterimageOffsetX>
			<!-- 角色立绘在Y轴上的偏移量，单位像素 -->
			<CharacterimageOffsetY>-100</CharacterimageOffsetY>
			<!-- 角色类型标签路径，用于显示学生的类型标签 -->
			<CharacterTypePath>ManuaUI/Type/Assault</CharacterTypePath>
			<!-- 角色的星星数量 -->
			<CharacterStarCount>3</CharacterStarCount>
			<!-- 出击按钮旁边的1号tag图片路径，对应位置左上 -->
			<infotagImagePath1>ManuaUI/Type/辅助</infotagImagePath1>
			<!-- 出击按钮旁边的2号tag图片路径，对应位置左下 -->
			<infotagImagePath2>ManuaUI/Type/前排</infotagImagePath2>
			<!-- 出击按钮旁边的3号tag图片路径，对应位置右上 -->
			<infotagImagePath3>ManuaUI/Type/爆发</infotagImagePath3>
			<!-- 出击按钮旁边的4号tag图片路径，对应位置右下 -->
			<infotagImagePath4>ManuaUI/Type/特殊装甲</infotagImagePath4>
			<!-- 技能等级显示，写整数，不要大于20，小于0 -->
			<Skills>
				<!--射击-->
				<Shooting>20</Shooting>
				<!--近战-->
				<Melee>20</Melee>
				<!--建造-->
				<Construction>0</Construction>
				<!--采矿-->
				<Mining>15</Mining>
				<!--烹饪-->
				<Cooking>0</Cooking>
				<!--种植-->
				<Plants>0</Plants>
				<!--驯兽-->
				<Animals>12</Animals>
				<!--手工-->
				<Crafting>0</Crafting>
				<!--艺术-->
				<Artistic>0</Artistic>
				<!--医学-->
				<Medical>0</Medical>
				<!--社交-->
				<Social>10</Social>
				<!--智慧-->
				<Intellectual>10</Intellectual>
			</Skills>
			<!--武器UI配置-->
			<WapenUI>
				<!--武器图片路径配置-->
				<WapenUIImagePath>ManuaUI/Wapen/Hoshiro</WapenUIImagePath>
				<!--武器类型文本配置-->
				<WapenTypeText>霰弹枪</WapenTypeText>
			</WapenUI>
			<Ability1>
				<AbilityImagePath>Ability/Icon/Hina/Hina_A</AbilityImagePath>
				<AbilityTypeText>EX技能</AbilityTypeText>
				<AbilityTitle>水上支援</AbilityTitle>
				<AbilitySubtitle><![CDATA[EX技能 / <color=black>COST:</color><color=blue>5</color>]]></AbilitySubtitle>
				<AbilityIntroduction><![CDATA[赋予以自身为中心的圆形范围内的友方单位攻击力增加<color=#00FFFF>39%</color>爆发克制率增加<color=#00FFFF>99%</color>(持续50秒)]]>
				</AbilityIntroduction>
				<offSetX>12</offSetX>
				<offSetY>0</offSetY>
			</Ability1>
			<Ability2>
				<AbilityImagePath>Ability/Icon/Serika/Serika_EX</AbilityImagePath>
				<AbilityTypeText>基本技能</AbilityTypeText>
				<AbilityTitle>水上袭击</AbilityTitle>
				<AbilitySubtitle><![CDATA[基本技能 / 冷却<color=#00FFFF>40</color>秒]]></AbilitySubtitle>
				<AbilityIntroduction><![CDATA[对一名敌人造成自身攻击力<color=#00FFFF>454%</color>的伤害并回复自身<color=#00FFFF>98%</color>的生命值]]>
				</AbilityIntroduction>
				<offSetX>12</offSetX>
				<offSetY>0</offSetY>
			</Ability2>
			<Ability3>
				<AbilityImagePath>Ability/Icon/Megu/Megu_A</AbilityImagePath>
				<AbilityTypeText>被动技能</AbilityTypeText>
				<AbilityTitle>忍耐酷暑</AbilityTitle>
				<AbilitySubtitle><![CDATA[被动技能]]></AbilitySubtitle>
				<AbilityIntroduction><![CDATA[增加自身<color=#00FFFF>16%</color>的攻击力和<color=#00FFFF>16%</color>的防御力。]]>
				</AbilityIntroduction>
				<offSetX>12</offSetX>
				<offSetY>0</offSetY>
			</Ability3>
			<Ability4>
				<AbilityImagePath>Ability/Icon/Icon_Error</AbilityImagePath>
				<AbilityTypeText>子技能</AbilityTypeText>
				<AbilityTitle>测试技能4</AbilityTitle>
				<AbilitySubtitle><![CDATA[测试技能4 / <color=black>COST: </color><color=blue>30</color>]]></AbilitySubtitle>
				<AbilityIntroduction><![CDATA[这里是技能4的简介部分。
可以包含<b>多行</b>文本。
并且可以混合使用<color=#FFA500>各种颜色</color>和<i>样式</i>。]]>
				</AbilityIntroduction>
				<offSetX>12</offSetX>
				<offSetY>0</offSetY>
			</Ability4>
			<StudentBio>
				<!--学生简介页面的粗略介绍配置，显示在学院logo旁边-->
				<StudentDesp><![CDATA[阿拜多斯高等学院
3年级
社团 对策委员会]]>
				</StudentDesp>
				<!--学生简介页面的名字，显示在学院logo旁边-->
				<StudentBioName>小鸟游 星野</StudentBioName>
				<!--学院logo路径，显示在学生简介页面的左上角-->
				<AcademyLogoPath>ManuaUI/AcademyLogo/Abydos</AcademyLogoPath>
				<!--学生简介页面的学生背景故事配置，长文本，可以任意字数-->
				<StudentCard>阿比多斯高级中学所属，为了追求悠闲夏日，而来到无人岛的对策委员会委员长。跟她怕麻烦的态度相反，各项准备都非常确实。而她本人并没有发现自己比平常还要积极。</StudentCard>
			</StudentBio>
		</BaStudentUI>
    <baStudentData>
			<!-- 伤害类型：Explosion(爆发), Mysterious(神秘), Vibration(振动), Through(穿透) -->
			<DamageType>Explosion</DamageType>
			<!-- 防御类型：Explosion(爆发), Mysterious(神秘), Vibration(振动), Through(穿透) -->
			<DefenseType>Mysterious</DefenseType>
			<!-- 位置类型：Assist(辅助), Henc(前排), Medical(医疗), Tank(坦克), Vehicle(载具) -->
			<PosType>Assist</PosType>
			<!-- 星级数量 -->
			<StarCont>3</StarCont>
			<DraggableAudio>Common\Sounds\Fight\Hoshiro_A</DraggableAudio>
		    <!--点数商店面板显示的学校-->
			<stuSchool>阿拜多斯高中</stuSchool>
				<!-- 
            抽卡抽到重复的时候这名学生产生的东西
           键(Key)是 ThingDef 的 defname。
           值(Value)是掉落的数量。
        -->
			<GakaStudentThingData>
				<li>
					<key>Kami_Proplevel</key>
					<value>50</value>
				</li>
				<li>
					<key>BANW_Hoshiro_A_Proplevel</key>
					<value>30</value>
				</li>
			</GakaStudentThingData>
			<UpGakaStudentThingData>
				<li>
					<key>Kami_Proplevel</key>
					<value>50</value>
				</li>
				<li>
					<key>BANW_Hoshiro_A_Proplevel</key>
					<value>100</value>
				</li>
			</UpGakaStudentThingData>
			<OneGakaStudentThingData>
				<li>
					<key>BANW_Hoshiro_A_Proplevel</key>
					<value>100</value>
				</li>
			</OneGakaStudentThingData>
			<!-- 抽卡面板显示的纹理，就是最后翻牌那一下的头像 -->
			<avtTexPath>Gacha/Student/Hoshiro_A</avtTexPath>
		</baStudentData>
  </BANWlLib.BaDef.BaStudentDef>
</Defs>