<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<ThingDef ParentName="MoteBase"><!-- Fleck定义 -->
<defName>BAWN_Hiyori_1_Mote</defName>
<thingClass>MoteAttached</thingClass>
<drawOffscreen>true</drawOffscreen>
<altitudeLayer>MoteOverhead</altitudeLayer><!-- 特效的海拔层，设置为头顶显示 -->
<mote>
<fadeInTime>0.0</fadeInTime><!-- 特效淡入时间（秒） -->
<solidTime>1.00</solidTime><!-- 特效持续可见时间（秒） -->
<fadeOutTime>0.0</fadeOutTime><!-- 特效淡出时间（秒） -->
</mote>
<graphicData>
<graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
<shaderType>GlowAnimated</shaderType><!-- 着色器类型，使用发光动画着色器 -->
<texPath>Effect/Hiyori/A/Hiyori_1</texPath> <!-- 纹理路径，指向特效图片资源 -->
<drawSize>(3,3)</drawSize><!-- 绘制尺寸 -->   
<shaderParameters>
<_NumFrames>30</_NumFrames>
<_FramesPerSec>30</_FramesPerSec>
</shaderParameters>
</graphicData>
</ThingDef>
<ThingDef ParentName="MoteBase"><!-- Fleck定义 -->
<defName>BAWN_Hiyori_2_Mote</defName>
<thingClass>MoteAttached</thingClass>
<drawOffscreen>true</drawOffscreen>
<altitudeLayer>MoteOverhead</altitudeLayer><!-- 特效的海拔层，设置为头顶显示 -->
<mote>
<fadeInTime>0.0</fadeInTime><!-- 特效淡入时间（秒） -->
<solidTime>0.80</solidTime><!-- 特效持续可见时间（秒） -->
<fadeOutTime>0.0</fadeOutTime><!-- 特效淡出时间（秒） -->
</mote>
<graphicData>
<graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
<shaderType>GlowAnimated</shaderType><!-- 着色器类型，使用发光动画着色器 -->
<texPath>Effect/Hiyori/A/Hiyori_2</texPath> <!-- 纹理路径，指向特效图片资源 -->
<drawSize>(3,3)</drawSize><!-- 绘制尺寸 -->   
<shaderParameters>
<_NumFrames>24</_NumFrames>
<_FramesPerSec>30</_FramesPerSec>
</shaderParameters>
</graphicData>
</ThingDef>
  <ThingDef ParentName="MoteBase"><!-- Mote向上浮动 -->
    <defName>BAWN_Hiyori_3_Mote</defName>
    <drawOffscreen>true</drawOffscreen>
    <graphicData><!-- 图形数据配置 -->
      <texPath>Effect/Hiyori/B/Hiyori_1</texPath><!-- 纹理图片路径 -->
      <shaderType>MoteGlow</shaderType><!-- 使用的着色器类型，用于发光效果 -->
      <drawSize>(3,20)</drawSize>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer><!-- 显示层级，设置为最顶层 -->
    <mote>
      <fadeInTime>0.1</fadeInTime><!-- 淡入时间（秒） -->
      <solidTime>0.6</solidTime><!-- 固定显示时间（秒） -->
      <fadeOutTime>0.1</fadeOutTime> <!-- 淡出时间（秒） -->
      <collide>false</collide><!-- 是否与其它物体碰撞 -->
    </mote>
  </ThingDef>
<EffecterDef>
<defName>BANW_Hiyori_Ef_A</defName>
<children>
   <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <soundDef>Hiyori_Skill_EX_A</soundDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>BANWlLib.BaClass.SubEffecter_SprayerTriggeredRotatedOffset</subEffecterClass>
        <moteDef>BAWN_Hiyori_1_Mote</moteDef>
        <initialDelayTicks>0</initialDelayTicks>
        <scale>1</scale>  <!-- 缩放比例，影响特效显示大小 -->
        <rotation>0</rotation><!-- 初始旋转角度 -->
        <rotationRate>0</rotationRate><!-- 每秒旋转角度（持续旋转） -->
        <burstCount>1</burstCount>  <!-- 一次触发时生成的特效数量 -->
        <positionOffset>(0,0.5,1)</positionOffset>  <!-- 特效生成的位置偏移（X, Z, Y） -->
        <angle>0</angle><!-- 发射角度 -->
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity><!-- 是否根据角度设置速度方向，true 表示启用 -->
        <spawnLocType>OnSource</spawnLocType>
        <speed>0</speed>
        <attachToSpawnThing>true</attachToSpawnThing><!-- 是否跟踪 -->
        <absoluteAngle>false</absoluteAngle>
      </li>
</children>
</EffecterDef>
