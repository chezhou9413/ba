<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 输出形态EX按钮：持续瞄准并发射追踪技能子弹，具体伤害段在 Hoshino.xml 的 exStages 中配置。 -->
  <AbilityDef>
    <!-- 技能Def唯一标识，供 ProfileDef 的 primaryAbility 引用。 -->
    <defName>BANW_Special_Hoshino_Ex</defName>
    <!-- 按钮显示名。 -->
    <label>集中突破</label>
    <!-- 技能说明文本，展示在按钮提示中。 -->
    <description>准备0.1秒后，持续瞄准目标并依次发射追踪技能弹。各段分别造成单体或范围伤害，实际总倍率见下方预估；目标移动时弹丸继续跟踪，友军目标同样显示举枪瞄准。

施放期间承伤系数降低0.85，最低为0。完整发射后，下一轮普攻强化为扇形范围攻击；即使目标提前死亡，也会朝最后瞄准位置打完剩余强化弹。</description>
    <!-- 技能实现类，负责把施法请求交给特殊技能系统处理。 -->
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <!-- 前摇结束后保持瞄准，直到最后一段弹丸发射。 -->
    <jobDef>BANW_Job_HoshinoExChannel</jobDef>
    <!-- 前摇开始时播放的语音。 -->
    <warmupStartSound>Hoshiro_B_Skill_EXX</warmupStartSound>
    <!-- 按钮图标路径。 -->
    <iconPath>Ability/Icon/Chise/Chise_EX</iconPath>
    <!-- 冷却时间，600 tick = 10 秒。 -->
    <cooldownTicksRange>600</cooldownTicksRange>
    <!-- 未征召时也显示按钮。 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <!-- 未征召时按钮置灰不可点。 -->
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <!-- 征召状态下显示按钮。 -->
    <showWhenDrafted>true</showWhenDrafted>
    <!-- 不播放心灵能力施法特效。 -->
    <showPsycastEffects>false</showPsycastEffects>
    <!-- 非敌对技能。 -->
    <hostile>true</hostile>
    <!-- 必须选定目标才能施放。 -->
    <targetRequired>true</targetRequired>
    <!-- 不要求施法者具有暴力能力。 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <!-- 施法动词参数：决定射程与可选目标类型。 -->
    <verbProperties>
      <soundCast>Hoshiro_B_Skill_B</soundCast>
      <!-- 显示主武器瞄准和范围预览的施法动词。 -->
      <verbClass>BANWlLib.BaVerb.Verb_CastAbilityWithTargetPreview</verbClass>
      <!-- 施法距离上限（格）。 -->
      <range>39.9</range>
      <!-- 瞄准时间（秒），0.1 秒对应 6 tick。 -->
      <warmupTime>0.1</warmupTime>
      <!-- 合法目标类型。 -->
      <targetParams>
        <!-- 不能选择自己。 -->
        <canTargetSelf>false</canTargetSelf>
        <!-- 可以选中角色。 -->
        <canTargetPawns>true</canTargetPawns>
        <!-- 可以选中人类。 -->
        <canTargetHumans>true</canTargetHumans>
        <!-- 可以选中动物。 -->
        <canTargetAnimals>true</canTargetAnimals>
        <!-- 可以选中机械族。 -->
        <canTargetMechs>true</canTargetMechs>
        <!-- 不能选中建筑。 -->
        <canTargetBuildings>false</canTargetBuildings>
        <!-- 不能直接选中空地。 -->
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <modExtensions>
      <li Class="BANWlLib.BaVerb.AbilityTargetPreviewExtension">
        <drawPrimaryWeaponAim>true</drawPrimaryWeaponAim><radius>3</radius>
      </li>
    </modExtensions>
    <!-- 技能组件：绑定技能档案与COST消耗。 -->
    <comps>
      <!-- 特殊技能组件，profile 指向档案，command 指定执行的指令分支。 -->
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <!-- 引用的技能档案 Def。 -->
        <profile>BANW_Special_Hoshino</profile>
        <!-- 指令分支：Ex 为输出形态EX。 -->
        <command>Ex</command>
      </li>
      <!-- COST消耗组件。 -->
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost">
        <!-- 施放消耗的 COST 值。 -->
        <cost>6</cost>
      </li>
    </comps>
  </AbilityDef>

  <!-- 防御形态EX按钮：位移到指定位置后获得增益、护盾与弹丸拦截。 -->
  <AbilityDef>
    <!-- 技能Def唯一标识，供 ProfileDef 的 alternateAbility 引用。 -->
    <defName>BANW_Special_Hoshino_AlternateEx</defName>
    <!-- 按钮显示名。 -->
    <label>加强防御态势</label>
    <!-- 技能说明文本。 -->
    <description>位移至指定位置后，攻击力增加156%，并获得最大生命值69.1%的护盾，持续40秒。

个人护盾与前方3格半圆拦截共用同一余额，按实际减伤后的伤害扣除。破盾这一击完全抵挡；余额耗尽后停止拦截。背后、友军和从拦截范围内部射出的弹丸不受前向拦截影响。</description>
    <!-- 技能实现类。 -->
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <!-- 按钮图标路径。 -->
    <iconPath>Ability/Icon/Hoshiro_B/Hoshiro_EXXX</iconPath>
    <!-- 冷却时间，60 tick = 1 秒。 -->
    <cooldownTicksRange>60</cooldownTicksRange>
    <!-- 未征召时也显示按钮。 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <!-- 未征召时按钮置灰不可点。 -->
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <!-- 征召状态下显示按钮。 -->
    <showWhenDrafted>true</showWhenDrafted>
    <!-- 不播放心灵能力施法特效。 -->
    <showPsycastEffects>false</showPsycastEffects>
    <!-- 非敌对技能。 -->
    <hostile>false</hostile>
    <!-- 必须选定目标才能施放。 -->
    <targetRequired>true</targetRequired>
    <!-- 不要求施法者具有暴力能力。 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <!-- 施法动词参数：防御EX支持选点位移。 -->
    <verbProperties>
      <!-- 位移只检查落点，不被途中树木或岩石遮挡。 -->
      <requireLineOfSight>false</requireLineOfSight>
      <!-- 标准施法动词。 -->
      <verbClass>Verb_CastAbility</verbClass>
      <!-- 施法距离上限（格）。 -->
      <range>29.9</range>
      <!-- 瞄准时间（秒），0 表示点击即施放，位移耗时由 moveSpeed 决定。 -->
      <warmupTime>0</warmupTime>
      <!-- 合法目标类型。 -->
      <targetParams>
        <!-- 不能选择自己。 -->
        <canTargetSelf>false</canTargetSelf>
        <!-- 可以选中角色。 -->
        <canTargetPawns>true</canTargetPawns>
        <!-- 可以选中人类。 -->
        <canTargetHumans>true</canTargetHumans>
        <!-- 可以选中动物。 -->
        <canTargetAnimals>true</canTargetAnimals>
        <!-- 可以选中机械族。 -->
        <canTargetMechs>true</canTargetMechs>
        <!-- 不能选中建筑。 -->
        <canTargetBuildings>false</canTargetBuildings>
        <!-- 可以选中空地位移。 -->
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <!-- 技能组件：绑定技能档案与COST消耗。 -->
    <comps>
      <!-- 特殊技能组件。 -->
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <!-- 引用的技能档案 Def。 -->
        <profile>BANW_Special_Hoshino</profile>
        <!-- 指令分支：AlternateEx 为防御形态EX。 -->
        <command>AlternateEx</command>
      </li>
      <!-- COST消耗组件。 -->
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost">
        <!-- 施放消耗的 COST 值。 -->
        <cost>4</cost>
      </li>
    </comps>
  </AbilityDef>

  <!-- 形态切换按钮：自身施放，在输出与防御形态之间切换。 -->
  <AbilityDef>
    <!-- 技能Def唯一标识，供 ProfileDef 的 switchAbility 引用。 -->
    <defName>BANW_Special_Hoshino_SwitchForm</defName>
    <!-- 按钮显示名。 -->
    <label>切换战斗形态</label>
    <!-- 技能说明文本。 -->
    <description>切换输出／坦克形态，同时切换职位特性、EX与普通技能，以及背负装备／前持盾牌。装备转换保留品质、颜色与耐久比例。初始为输出形态。</description>
    <!-- 技能实现类。 -->
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <!-- 按钮图标路径。 -->
    <iconPath>Ability/Icon/Hoshiro_B/Hoshiro</iconPath>
    <!-- 冷却时间，60 tick = 1 秒。 -->
    <cooldownTicksRange>60</cooldownTicksRange>
    <!-- 未征召时也显示按钮。 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <!-- 未征召时按钮置灰不可点。 -->
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <!-- 征召状态下显示按钮。 -->
    <showWhenDrafted>true</showWhenDrafted>
    <!-- 不播放心灵能力施法特效。 -->
    <showPsycastEffects>false</showPsycastEffects>
    <!-- 非敌对技能。 -->
    <hostile>false</hostile>
    <!-- 无需选定目标（自身施放）。 -->
    <targetRequired>false</targetRequired>
    <!-- 不要求施法者具有暴力能力。 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <!-- 施法动词参数。 -->
    <verbProperties>
      <!-- 标准施法动词。 -->
      <verbClass>Verb_CastAbility</verbClass>
      <!-- 施法距离上限（格）。 -->
      <range>25</range>
      <!-- 瞄准时间（秒）。 -->
      <warmupTime>0</warmupTime>
      <!-- 合法目标类型：仅自身。 -->
      <targetParams>
        <!-- 以自己为目标施放。 -->
        <canTargetSelf>true</canTargetSelf>
        <!-- 不能选中角色。 -->
        <canTargetPawns>false</canTargetPawns>
        <!-- 可以选中人类（配合 canTargetSelf 使用）。 -->
        <canTargetHumans>true</canTargetHumans>
        <!-- 可以选中动物。 -->
        <canTargetAnimals>true</canTargetAnimals>
        <!-- 可以选中机械族。 -->
        <canTargetMechs>true</canTargetMechs>
        <!-- 不能选中建筑。 -->
        <canTargetBuildings>false</canTargetBuildings>
        <!-- 不能选中空地。 -->
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <!-- 技能组件：绑定技能档案与COST消耗。 -->
    <comps>
      <!-- 特殊技能组件。 -->
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <!-- 引用的技能档案 Def。 -->
        <profile>BANW_Special_Hoshino</profile>
        <!-- 指令分支：SwitchForm 为形态切换。 -->
        <command>SwitchForm</command>
      </li>
    </comps>
  </AbilityDef>

  <!-- 防御形态普通技能按钮：主动获得受伤次数状态。 -->
  <AbilityDef>
    <!-- 技能Def唯一标识，供 hoshino.tankNormalAbility 引用。 -->
    <defName>BANW_Special_Hoshino_TankNormal</defName>
    <!-- 按钮显示名。 -->
    <label>更换护甲</label>
    <!-- 技能说明文本。 -->
    <description>装备防弹护板.防弹护板在自身受到25次伤害后解除.
防弹护板效果：承伤率减少24.1%。</description>
    <!-- 技能实现类。 -->
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <!-- 按钮图标路径。 -->
    <iconPath>Ability/Icon/Hoshiro_B/Hoshiro_B</iconPath>
    <!-- 冷却时间，2400 tick = 40 秒。 -->
    <cooldownTicksRange>2400</cooldownTicksRange>
    <!-- 未征召时也显示按钮。 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <!-- 未征召时按钮置灰不可点。 -->
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <!-- 征召状态下显示按钮。 -->
    <showWhenDrafted>true</showWhenDrafted>
    <!-- 不播放心灵能力施法特效。 -->
    <showPsycastEffects>false</showPsycastEffects>
    <!-- 非敌对技能。 -->
    <hostile>false</hostile>
    <!-- 无需选定目标（自身施放）。 -->
    <targetRequired>false</targetRequired>
    <!-- 不要求施法者具有暴力能力。 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <!-- 施法动词参数。 -->
    <verbProperties>
      <!-- 标准施法动词。 -->
      <verbClass>Verb_CastAbility</verbClass>
      <!-- 施法距离上限（格）。 -->
      <range>25</range>
      <!-- 瞄准时间（秒）。 -->
      <warmupTime>0</warmupTime>
      <!-- 合法目标类型：仅自身。 -->
      <targetParams>
        <!-- 以自己为目标施放。 -->
        <canTargetSelf>true</canTargetSelf>
        <!-- 不能选中角色。 -->
        <canTargetPawns>false</canTargetPawns>
        <!-- 不能选中空地。 -->
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <!-- 技能组件：绑定技能档案与COST消耗。 -->
    <comps>
      <!-- 特殊技能组件。 -->
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <!-- 引用的技能档案 Def。 -->
        <profile>BANW_Special_Hoshino</profile>
        <!-- 指令分支：Normal 为防御形态普通技能。 -->
        <command>Normal</command>
      </li>
    </comps>
  </AbilityDef>
  <JobDef>
    <defName>BANW_Job_HoshinoExChannel</defName>
    <driverClass>BANWlLib.Skills.JobDriver_HoshinoExChannel</driverClass>
    <reportString>正在瞄准并施放星野输出EX。</reportString>
    <abilityCasting>true</abilityCasting>
    <!-- 前摇和连射姿态各自绘制瞄准武器，避免重复绘制。 -->
    <neverShowWeapon>true</neverShowWeapon>
  </JobDef>
</Defs>
