<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 妮露技能配置：大亢奋、锐气层数、伤害与特效。 -->
  <BANWlLib.Skills.SpecialSkillProfileDef>
    <defName>BANW_Special_Nero</defName><label>妮露</label><role>Nero</role>
    <primaryAbility>BANW_Special_Nero_Ex</primaryAbility>
    <alternateAbility>BANW_Special_Nero_AlternateEx</alternateAbility>
    <range>25</range><normalIntervalTicks>1800</normalIntervalTicks>
    <radius>3</radius>
    <durationTicks>4200</durationTicks>
    <maxStacks>5</maxStacks>
    <stackMultiplier>0.35</stackMultiplier>
    <exMultiplier>1.2</exMultiplier>
    <casterEffecter>BANW_Effecter_A</casterEffecter>
    <targetEffecter>BANW_Effecter_C</targetEffecter>
    <stageEffecter>BANW_Effecter_B</stageEffecter>
    <endEffecter>BANW_Effecter_C</endEffecter>
    <stateEffecter>BANW_Effecter_B</stateEffecter>
    <exAttack>
      <!-- 总倍率由shots均分；关闭BA时改用basePower作为攻击基数。 -->
      <useBattleStats>true</useBattleStats>
      <basePower>100</basePower>
      <attackPowerRatio>13</attackPowerRatio>
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 本段每次伤害的护甲穿透：0.5为50%，不随连射发数均分。 -->
      <penetration>0</penetration>
      <isExSkill>true</isExSkill>
      <canCrit>true</canCrit>
      <applyAffinity>true</applyAffinity>
      <radius>0</radius>
      <shots>10</shots>
      <!-- 配置shotTicks时使用逐发时间表；删除整段列表后才使用统一shotIntervalTicks。 -->
      <shotIntervalTicks>6</shotIntervalTicks>
      <!-- 每个数值为相对本次EX生效的tick，最小为1，条目数必须等于shots。 -->
      <shotTicks>
        <li>1</li><li>7</li><li>13</li><li>19</li><li>25</li>
        <li>31</li><li>37</li><li>43</li><li>49</li><li>55</li>
      </shotTicks>
      <!-- 二段每发射击的音效，独立于一段施法音效。 -->
      <shotSound>BANW_Nero_ExShot</shotSound>
      <projectileDef>BANW_SpecialSkillBullet</projectileDef>
      <effecterDef>BANW_Effecter_C</effecterDef>
      
    </exAttack>
  </BANWlLib.Skills.SpecialSkillProfileDef>
  <AbilityDef>
    <defName>BANW_Special_Nero_Ex</defName>
    <label>测试新技能·妮露·大亢奋</label>
    <description>选择25格内的一名其他友军，使自己与目标获得70秒「大亢奋」，EX伤害倍率提高至1.2倍。

大亢奋持续期间，自身EX切换为「锐气攻击」。自身大亢奋结束时，恢复此技能并清空锐气层数。

基础消耗：2 COST。冷却：1秒。</description>
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <iconPath>UI/StarIcon</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <showWhenDrafted>true</showWhenDrafted>
    <showPsycastEffects>false</showPsycastEffects>
    <hostile>false</hostile>
    <targetRequired>true</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <!-- 一段成功施放时播放的独立音效。 -->
      <soundCast>Nero_Skill_EX</soundCast>
      <range>25</range><warmupTime>0</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs><canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <profile>BANW_Special_Nero</profile><command>Ex</command>
      </li>
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost"><cost>2</cost></li>
    </comps>
  </AbilityDef>
  <AbilityDef>
    <defName>BANW_Special_Nero_AlternateEx</defName>
    <label>测试新技能·妮露·锐气攻击</label>
    <description>向25格内的敌人连续发射10发子弹，基础总伤害为攻击力的1300%。整轮保持停步瞄准与持续施法，不能同时进行武器平A；每次射击播放独立射击音效，逐发时间可配置。施法被打断时停止未发出的子弹，已发出的弹丸继续命中结算。

发动前先获得1层锐气，最多5层。锐气伤害倍率为「1＋0.35×层数」，并与大亢奋的1.2倍倍率相乘；5层时合计为基础伤害的3.3倍。

自身大亢奋结束时清空锐气，并恢复一阶段EX。

基础消耗：4 COST。冷却：1秒。</description>
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <jobDef>BANW_Job_NeroExChannel</jobDef>
    <iconPath>UI/StarIcon</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <showWhenDrafted>true</showWhenDrafted>
    <showPsycastEffects>false</showPsycastEffects>
    <hostile>false</hostile>
    <targetRequired>true</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>25</range><warmupTime>0</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs><canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <profile>BANW_Special_Nero</profile><command>AlternateEx</command>
      </li>
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost"><cost>4</cost></li>
    </comps>
  </AbilityDef>
  <JobDef>
    <defName>BANW_Job_NeroExChannel</defName>
    <driverClass>BANWlLib.Skills.JobDriver_NeroExChannel</driverClass>
    <reportString>正在持续施放妮露二段EX。</reportString>
    <abilityCasting>true</abilityCasting>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>
</Defs>
