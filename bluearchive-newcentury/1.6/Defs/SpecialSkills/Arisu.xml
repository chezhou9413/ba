<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 临战爱丽丝EX：三档对敌表现、两档自身充能与固定直线多段伤害。 -->
  <BANWlLib.Skills.SpecialSkillProfileDef>
    <!-- 技能档案唯一标识，供 AbilityDef 的 comps 引用。 -->
    <defName>BANW_Special_Arisu</defName>
    <!-- 档案显示名。 -->
    <label>临战爱丽丝</label>
    <!-- 归属角色标识（用于匹配角色资源/图标）。 -->
    <role>Arisu</role>
    <!-- 该档案绑定的主技能 Def。 -->
    <primaryAbility>BANW_Special_Arisu_Ex</primaryAbility>
    <range>25</range>
    <arisu>
      <lineLength>25</lineLength><lineWidth>3</lineWidth>
      <!-- 首段额外延迟；实际首段在施法后的第1加damageDelayTicks个tick结算。 -->
      <damageDelayTicks>0</damageDelayTicks>
      <!-- 对敌使用时按当前0、1、2档选择A、B、C，仅触发所选一项。 -->
      <attackEffecters>
        <li>BANW_SpecialArisu_Attack_A</li>
        <li>BANW_SpecialArisu_Attack_B</li>
        <li>BANW_SpecialArisu_Attack_C</li>
      </attackEffecters>
      <!-- 对自己使用时按升至第1档、第2档分别播放，不使用对敌特效。 -->
      <chargeEffecters><li>BANW_Effecter_B</li><li>BANW_Effecter_C</li></chargeEffecters>
      <attackSound>BANW_Sound_At_Aris</attackSound>
      <chargeSound>BANW_Skill_NewA</chargeSound>
      <!-- 自动普通技能拥有独立Def、伤害、触发次数、冷却、声音和特效。 -->
      <normalSkill>BANW_Special_Arisu_Normal</normalSkill>
    </arisu>
    <exAttack>
      <!-- 总倍率由shots均分；关闭BA时改用basePower作为攻击基数。 -->
      <useBattleStats>true</useBattleStats>
      <!-- 未启用 BA 战斗数值时使用的固定攻击基数。 -->
      <basePower>100</basePower>
      <!-- 攻击力倍率，13 = 1300%。 -->
      <attackPowerRatio>13</attackPowerRatio>
      <!-- 使用的伤害 Def。 -->
      <damageDef>BANC_Damage_shenmi</damageDef>
      <!-- 本段每次伤害的护甲穿透：0.5为50%，不随连射发数均分。 -->
      <penetration>0</penetration>
      <isExSkill>true</isExSkill>
      <!-- 允许暴击。 -->
      <canCrit>true</canCrit>
      <!-- 结算时应用属性克制/亲和加成。 -->
      <applyAffinity>true</applyAffinity>
      <!-- 直线范围由arisu配置；直接范围结算，不生成追踪弹丸。 -->
      <radius>0</radius>
      <shots>5</shots>
      <shotIntervalTicks>6</shotIntervalTicks>
      <canHitOwnPawn>false</canHitOwnPawn><affectFriendly>false</affectFriendly><affectHostile>true</affectHostile>
    </exAttack>
  </BANWlLib.Skills.SpecialSkillProfileDef>
  <AbilityDef>
    <!-- 技能唯一标识。 -->
    <defName>BANW_Special_Arisu_Ex</defName>
    <label>测试新技能·临战爱丽丝·EX</label>
    <description>对自己使用时获得一档充能，最多两档；两档使用不同的自身充能特效，满档后不能继续充能。

对25格内的敌人使用时，沿瞄准方向对长度25格、宽度3格的直线区域造成5段AOE，段间隔0.1秒。未充能、一档、二档分别使用A、B、C定向特效，总伤害分别为攻击力1300%、2600%、3900%。伤害区域在施法时固定，每段重新判断区域内的敌人，成功发动后清空充能。

独立普通技能：每累计3次有效普攻命中，自动对敌人追加一次攻击力100%的攻击，不消耗COST；多余命中次数保留。完全闪避或完全吸收的攻击不计数。普通技能拥有独立的声音、特效与伤害配置，不消费EX充能，不能主动施放。

每次EX基础消耗：4 COST。冷却：1秒。</description>
    <abilityClass>BANWlLib.Skills.Ability_SpecialSkill</abilityClass>
    <!-- 技能图标路径。 -->
    <iconPath>UI/StarIcon</iconPath>
    <!-- 冷却时间（tick），60 = 1 秒。 -->
    <cooldownTicksRange>60</cooldownTicksRange>
    <!-- 未征召时也显示技能按钮。 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <!-- 未征召时按钮不可点击。 -->
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <!-- 征召状态下显示该技能。 -->
    <showWhenDrafted>true</showWhenDrafted>
    <!-- 不显示心灵能力相关特效。 -->
    <showPsycastEffects>false</showPsycastEffects>
    <!-- 非敌对技能（不会自动选中敌人为目标）。 -->
    <hostile>false</hostile>
    <!-- 必须选择目标才能释放。 -->
    <targetRequired>true</targetRequired>
    <!-- 施法者无需具备暴力能力也可使用。 -->
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>BANWlLib.Skills.Verb_ArisuSpecialSkill</verbClass>
      <range>25</range><warmupTime>0</warmupTime>
      <targetParams>
        <!-- 可对自己释放（用于充能）。 -->
        <canTargetSelf>true</canTargetSelf>
        <!-- 可选中人类/动物/机械等 Pawn 类型。 -->
        <canTargetPawns>true</canTargetPawns>
        <canTargetHumans>true</canTargetHumans>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <!-- 不能选建筑或空地。 -->
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- 特殊技能组件：绑定档案并声明为 EX 指令。 -->
      <li Class="BANWlLib.Skills.CompProperties_SpecialSkill">
        <profile>BANW_Special_Arisu</profile>
        <command>Ex</command>
      </li>
      <!-- COST 消耗组件：每次 EX 消耗 4 点。 -->
      <li Class="BANWlLib.CostSystem.CompProperties_AbilityCost">
        <cost>4</cost>
      </li>
    </comps>
  </AbilityDef>
</Defs>