<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 强化普攻的方向表现独立于武器弹丸，贴图或材质资源在此替换。 -->
  <ThingDef ParentName="MoteBase">
    <defName>BANW_Mote_Hoshino_EmpoweredShot</defName>
    <thingClass>MoteThrown</thingClass>
    <drawOffscreen>true</drawOffscreen>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>

      <texPath>Projectile/Bullet_Natsu</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(0.8,4)</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0.02</fadeInTime>
      <solidTime>1.00</solidTime>
      <fadeOutTime>0.18</fadeOutTime>
      <collide>false</collide>
    </mote>
  </ThingDef>
  <EffecterDef>
    <defName>BANW_Effecter_Hoshino_EmpoweredShot</defName>
    <children>
      <li>
        <!-- 从星野位置沿本发瞄准方向生成特效，rotation为资源轴向校正角。 -->
        <subEffecterClass>BANWlLib.Projectiles.SubEffecter_DirectionalImpactMote</subEffecterClass>
        <moteDef>BANW_Mote_Hoshino_EmpoweredShot</moteDef>
         <positionRadius>0.55</positionRadius><!-- 生成位置的半径范围 -->
        <burstCount>10</burstCount>  <!-- 一次触发时生成的特效数量 -->
        <scale>0.67~1</scale> <!-- 特效的缩放比例范围 -->
        <angle>0</angle><!-- 发射角度 -->
        <rotation>0</rotation>
        <scale>1</scale>
        <rotationRate>0</rotationRate>
        <speed>32~64</speed>
      </li>
    </children>
  </EffecterDef>
</Defs>