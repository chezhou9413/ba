<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 强化普攻的方向表现独立于武器弹丸，贴图或材质资源在此替换。 -->
  <ThingDef ParentName="MoteBase">
    <defName>BANW_Mote_Hoshino_EmpoweredShot</defName>
    <thingClass>MoteThrown</thingClass>
    <drawOffscreen>true</drawOffscreen><altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <graphicClass>BANWlLib.Effects.Graphic_BAAbSingle</graphicClass>
      <texPath>Effect/HPP</texPath><shaderType>MoteGlow</shaderType><drawSize>1.5</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0.02</fadeInTime><solidTime>0.20</solidTime><fadeOutTime>0.18</fadeOutTime><collide>false</collide>
    </mote>
  </ThingDef>
  <EffecterDef>
    <defName>BANW_Effecter_Hoshino_EmpoweredShot</defName>
    <children>
      <li>
        <!-- 从星野位置沿本发瞄准方向生成特效，rotation为资源轴向校正角。 -->
        <subEffecterClass>BANWlLib.Projectiles.SubEffecter_DirectionalImpactMote</subEffecterClass>
        <moteDef>BANW_Mote_Hoshino_EmpoweredShot</moteDef>
        <rotation>0</rotation><scale>1</scale><rotationRate>0</rotationRate>
      </li>
    </children>
  </EffecterDef>
</Defs>
