<Defs>
    <TraitDef>
        <defName>BAWC_TraitDef_Tank</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>职位:坦克</label>
                <description>{PAWN_nameDef}的职位是坦克，负责抵挡伤害，防御与血量比其他职业高</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                    <Flammability>-1.0</Flammability>
                    <PainShockThreshold>+0.15</PainShockThreshold>
                    <IncomingDamageFactor>-0.05</IncomingDamageFactor>
                    <BANW_HealthScalePercentOffset>0.55</BANW_HealthScalePercentOffset>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

