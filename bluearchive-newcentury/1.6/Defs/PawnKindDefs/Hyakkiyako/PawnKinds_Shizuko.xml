						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Hyakkiyako/Shizuko/Halo/Shizuko_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Hyakkiyako/Shizuko/Head/Shizuko_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Hyakkiyako/Shizuko/Body/Shizuko_Body</ReplacePath>
					</li>
					<li>
