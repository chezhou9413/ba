		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Mysterious</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Mysterious</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.12</li>
						<li>0.25</li>
						<li>0.35</li>
						<li>0.50</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<!-- 星级基础治愈力平加成长，先加入基础治愈力再乘治愈力百分比。 -->
