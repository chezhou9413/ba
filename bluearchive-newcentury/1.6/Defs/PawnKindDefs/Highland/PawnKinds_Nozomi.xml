
<Defs>


	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Nozomi</defName>
		<label>-望-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>
		<defaultFactionType>PlayerColony</defaultFactionType>
		<generateInitialNonFamilyRelations>false</generateInitialNonFamilyRelations>
		<humanPregnancyChance>0.0</humanPregnancyChance>
		<fixedGender>Female</fixedGender>
		<abilities>
        <li>BAWN_Nozomi_EX</li>
        <li>BAWN_Nozomi_EXX</li>
        <li>BAWN_Nozomi_StackBuff_Test</li>
        <li>BAWN_Nozomi_MultiStackBuff_Test</li>
        <li>BAWN_Nozomi_Shield_Test</li>
        </abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryHighland</li>
					<li>BANW_BackstoryNozomi</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Nozomi</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Nozomi</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>

		<skills>
			<li>
				<skill>Shooting</skill>
				<range>8~15</range>
			</li>
			<li>
				<skill>Construction</skill>
				<range>6~8</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>6~8</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>8~10</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>8~10</range>
			</li>

		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Attack>0</BAWC_TraitDef_Attack>
			<BAWC_TraitDef_zhendong>0</BAWC_TraitDef_zhendong>
			<BAWC_TraitDef_qing>0</BAWC_TraitDef_qing>
			<BAWC_TraitDef_Nozomi_A>0</BAWC_TraitDef_Nozomi_A>
			<BAWC_TraitDef_Nozomi_B>0</BAWC_TraitDef_Nozomi_B>
		</forcedTraits>
		<modExtensions>
			<li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>110</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Nozomi_levelup_A</li>
                    <li>Nozomi_levelup_B</li>
					<li>Nozomi_levelup_C</li>
					<li>Nozomi_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Nozomi_levelup_A</li>
                    <li>Nozomi_levelup_B</li>
					<li>Nozomi_levelup_C</li>
					<li>Nozomi_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>望</kindName>
				<kindDesName>橘 望</kindDesName>
				<Gender>Female</Gender>
				<kindAge>15</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Highland/Nozomi/Halo/Nozomi_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Highland/Nozomi/Head/Nozomi_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Highland/Nozomi/Body/Nozomi_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Highland/Nozomi/Hair/Nozomi_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Highland/Nozomi/Hair/Nozomi_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 学生初始生命值，参与生命值公式的基础乘算项，1 表示 100 点生命值。 -->
				<initialHealth>1.86</initialHealth>
				<!-- 学生基础攻击力平加，进入技能、武器显示和统一伤害结算。 -->
				<attackFlat>0</attackFlat>
				<!-- 学生基础攻击力百分比，0.26 表示最终攻击力额外增加 26%。 -->
				<attackPercent>0</attackPercent>
				<!-- 学生初始治愈力，参与治愈力公式的基础乘算项。 -->
				<!-- 学生基础受回复倍率平加，0.2 表示额外增加 20% 受疗。 -->
				<healReceivedMultiplierOffset>0</healReceivedMultiplierOffset>
				<!-- 学生基础 EX 技能倍率平加，0.5 表示 EX 技能倍率提高到 150%。 -->
				<exSkillMultiplierOffset>0</exSkillMultiplierOffset>
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Vibration</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Explosion</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.12</li>
						<li>0.25</li>
						<li>0.35</li>
						<li>0.50</li>
					</starValues>
				</attackPercent>
				<!-- 星级治愈力倍率成长，参与最终治愈力计算。 -->
				<healPercent>
					<starValues>
						<li>0</li>
						<li>0.1</li>
						<li>0.2</li>
						<li>0.3</li>
						<li>0.45</li>
					</starValues>
				</healPercent>
			</li>
			
		</modExtensions>
	</PawnKindDef>


	<TraitDef>
        <defName>BAWC_TraitDef_Nozomi_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#990099&gt;疾驰准备&lt;/color&gt;</label>
                <description>被动技能：自身攻击力增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets> 
                       <BANW_FinalDamageMultiplier>0.26</BANW_FinalDamageMultiplier>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>

	<TraitDef>
        <defName>BAWC_TraitDef_Nozomi_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#990099&gt;即刻发车！&lt;/color&gt;</label>
                <description>子技能：所有攻击必定暴击，增加自身&lt;color=#DC143C&gt;25%&lt;/color&gt;的暴击伤害和&lt;color=#DC143C&gt;26%&lt;/color&gt;的攻击速度</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets> 
                       <BANW_CriticalDamage>0.25</BANW_CriticalDamage>
					   <AimingDelayFactor>-0.25</AimingDelayFactor>
                       <RangedCooldownFactor>-0.25</RangedCooldownFactor>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
</Defs>
