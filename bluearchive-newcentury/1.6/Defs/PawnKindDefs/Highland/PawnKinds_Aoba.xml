
<Defs>

	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Aoba</defName>
		<label>-青叶-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>

		<defaultFactionType>PlayerColony</defaultFactionType>
		<generateInitialNonFamilyRelations>false</generateInitialNonFamilyRelations>

		<humanPregnancyChance>0.0</humanPregnancyChance>
		<fixedGender>Female</fixedGender>
		<abilities>
        <li>BAWN_Aoba_EX</li>
		<li>BAWN_Aoba_EXX</li>
        </abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryHighland</li>
					<li>BANW_BackstoryAoba</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Aoba</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Aoba</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>8</range>
			</li>
			<li>
				<skill>Construction</skill>
				<range>15</range>
			</li>
			<li>
				<skill>Mining</skill>
				<range>12</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>14</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>0</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Tank>0</BAWC_TraitDef_Tank>
			<BAWC_TraitDef_zhendong>0</BAWC_TraitDef_zhendong>
			<BAWC_TraitDef_qing>0</BAWC_TraitDef_qing>
			<BAWC_TraitDef_Aoba>0</BAWC_TraitDef_Aoba>
			<BAWC_TraitDef_Aoba_A>0</BAWC_TraitDef_Aoba_A>
			<BAWC_TraitDef_Aoba_B>0</BAWC_TraitDef_Aoba_B>
		</forcedTraits>
		<modExtensions>
			<li Class="BANWlLib.WeaponRestrictions.WeaponWhitelistKindExtension">
				<allowedWeapons>
					<li>BANC_Aoba</li>
				</allowedWeapons>
			</li>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Vibration</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Explosion</defenseType>
<!-- 学生初始生命值，参与生命值公式的基础乘算项，1 表示 100 点生命值。 -->
				<initialHealth>2.58</initialHealth>
				<!-- 学生基础攻击力平加，进入技能、武器显示和统一伤害结算。 -->
				<attackFlat>0</attackFlat>
				<!-- 学生基础攻击力百分比，0.26 表示最终攻击力额外增加 26%。 -->
				<attackPercent>0</attackPercent>
				<!-- 学生初始治愈力，参与治愈力公式的基础乘算项。 -->
				<initialHeal>120</initialHeal>
				<!-- 学生基础受回复倍率平加，0.2 表示额外增加 20% 受疗。 -->
				<healReceivedMultiplierOffset>0</healReceivedMultiplierOffset>
				<!-- 学生基础 EX 技能倍率平加，0.5 表示 EX 技能倍率提高到 150%。 -->
				<exSkillMultiplierOffset>0</exSkillMultiplierOffset>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.12</li>
						<li>0.25</li>
						<li>0.35</li>
						<li>0.50</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<!-- 升星固定治愈力成长，进入治愈力公式的固定加算项。 -->
				<healPercent>
					<starValues>
						<li>0</li>
						<li>0.1</li>
						<li>0.2</li>
						<li>0.3</li>
						<li>0.45</li>
					</starValues>
				</healPercent>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>0</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Aoba_levelup_A</li>
                    <li>Aoba_levelup_B</li>
					<li>Aoba_levelup_C</li>
					<li>Aoba_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Aoba_levelup_A</li>
                    <li>Aoba_levelup_B</li>
					<li>Aoba_levelup_C</li>
					<li>Aoba_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>青叶</kindName>
				<kindDesName>内海 青叶</kindDesName>
				<Gender>Female</Gender>
				<kindAge>15</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Highland/Aoba/Halo/Aoba_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Highland/Aoba/Head/Aoba_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Highland/Aoba/Body/Aoba_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Highland/Aoba/Hair/Aoba_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Highland/Aoba/Hair/Aoba_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>
<TraitDef>
        <defName>BAWC_TraitDef_Aoba</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FCFCB9&gt;货运管理部的工程师&lt;/color&gt;</label>
                <description>{PAWN_nameDef}的性格内向而怕事，但也有能若无其事说出毒舌发言的一面，修理机械的水平很高</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                <SmoothingSpeed>0.2</SmoothingSpeed>
				<ConstructionSpeed>0.3</ConstructionSpeed>
				<ConstructSuccessChance>0.5</ConstructSuccessChance>
				<FixBrokenDownBuildingSuccessChance>0.5</FixBrokenDownBuildingSuccessChance>
				<GeneralLaborSpeed>0.3</GeneralLaborSpeed>
				<SocialImpact>-0.8</SocialImpact>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Aoba_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#990099&gt;绝望连轴转&lt;/color&gt;</label>
                <description>被动技能：自身生命值增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets> 
                          <BANW_HealthBonusMultiplier>0.26</BANW_HealthBonusMultiplier>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Aoba_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#990099&gt;我就，没指望过&lt;/color&gt;</label>
                <description>子技能：使用普通技能时，额外&lt;color=#DC143C&gt;增加34%的护甲&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets> 

                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
</Defs>
