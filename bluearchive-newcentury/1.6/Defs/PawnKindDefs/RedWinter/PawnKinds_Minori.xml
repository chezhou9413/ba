                    <li>Minori_levelup_A</li>
                    <li>Minori_levelup_B</li>
					<li>Minori_levelup_C</li>
					<li>Minori_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Minori_levelup_A</li>
                    <li>Minori_levelup_B</li>
					<li>Minori_levelup_C</li>
					<li>Minori_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
