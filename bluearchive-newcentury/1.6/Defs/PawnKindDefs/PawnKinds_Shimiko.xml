<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Shimiko</defName>
		<label>-志美子-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>

		<defaultFactionType>PlayerColony</defaultFactionType>
		<generateInitialNonFamilyRelations>false</generateInitialNonFamilyRelations>
		
		<humanPregnancyChance>0.0</humanPregnancyChance>
		<fixedGender>Female</fixedGender>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<abilities>
		</abilities>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstorySany</li>
					<li>BANW_BackstoryShimiko</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<useFactionXenotypes>true</useFactionXenotypes>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>17</minGenerationAge>
		<maxGenerationAge>18</maxGenerationAge>
		<weaponTags>
         <li>BANC_Shimiko</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Shimiko</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>

		<skills>
			<li>
				<skill>Shooting</skill>
				<range>5~10</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>5~9</range>
			</li>
			<li>
				<skill>Cooking</skill>
				<range>5~9</range>
			</li>
			<li>
				<skill>Artistic</skill>
				<range>8~9</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>8</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>14~16</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Assistant>0</BAWC_TraitDef_Assistant>
			<BAWC_TraitDef_qing>0</BAWC_TraitDef_qing>
		</forcedTraits>
		<modExtensions>
			<li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
                <!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>30</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Arisu_levelup_A</li>
                    <li>Arisu_levelup_B</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                    <li>Arisu_levelup_C</li>
                    <li>Arisu_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>志美子</kindName>
				<kindDesName>园堂 志美子</kindDesName>
				<Gender>Female</Gender>
				<kindAge>17</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Sany/Shimiko/Halo/Shimiko_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Sany/Shimiko/Head/Shimiko_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Sany/Shimiko/Body/Shimiko_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Sany/Shimiko/Hair/Shimiko_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Sany/Shimiko/Hair/Shimiko_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>

	
</Defs>
