                <starUpSounds>
                    <li>Saki_levelup_A</li>
                    <li>Saki_levelup_B</li>
					<li>Saki_levelup_C</li>
					<li>Saki_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
