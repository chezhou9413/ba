<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Chise</defName>
		<label>-千世-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>
		<defaultFactionType>PlayerColony</defaultFactionType>
		<generateInitialNonFamilyRelations>false</generateInitialNonFamilyRelations>
		<humanPregnancyChance>0.0</humanPregnancyChance>
		<fixedGender>Female</fixedGender>
		<abilities>
        <li>BAWN_Chise_EX</li>
        </abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<abilities>
		</abilities>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryHyakkiyako</li>
					<li>BANW_BackstoryChise</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<useFactionXenotypes>true</useFactionXenotypes>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>17</minGenerationAge>
		<maxGenerationAge>18</maxGenerationAge>
		<weaponTags>
         <li>BANC_Chise</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Chise</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>

		<skills>
			<li>
				<skill>Shooting</skill>
				<range>8~12</range>
			</li>
			<li>
				<skill>Construction</skill>
				<range>4~5</range>
			</li>
			<li>
				<skill>Mining</skill>
				<range>6</range>
			</li>
			<li>
				<skill>Artistic</skill>
				<range>15</range>
			</li>
			<li>
				<skill>Plants</skill>
				<range>6</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>19</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>8</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Attack>0</BAWC_TraitDef_Attack>
			<BAWC_TraitDef_zhong>0</BAWC_TraitDef_zhong>
			<BAWC_TraitDef_Chise_A>0</BAWC_TraitDef_Chise_A>
			<BAWC_TraitDef_Chise_B>0</BAWC_TraitDef_Chise_B>
		</forcedTraits>
		<modExtensions>
			<li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
                <!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>30</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Arisu_levelup_A</li>
                    <li>Arisu_levelup_B</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                    <li>Arisu_levelup_C</li>
                    <li>Arisu_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>千世</kindName>
				<kindDesName>和乐 千世</kindDesName>
				<Gender>Female</Gender>
				<kindAge>17</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Hyakkiyako/Chise/Halo/Chise_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Hyakkiyako/Chise/Head/Chise_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Hyakkiyako/Chise/Body/Chise_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Hyakkiyako/Chise/Hair/Chise_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Hyakkiyako/Chise/Hair/Chise_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>

	<TraitDef>
        <defName>BAWC_TraitDef_Chise_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#4169E1&gt;好嘞，要加油啦~&lt;/color&gt;</label>
                <description>被动技能:自身攻击力增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					 <BANW_FinalDamageMultiplier>+0.26</BANW_FinalDamageMultiplier>
                </statOffsets>
				<statFactors>

				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Chise_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#4169E1&gt;会有点痛哦~&lt;/color&gt;</label>
                <description>子技能:自身攻击时会给敌人添加&lt;color=#DC143C&gt;燃烧&lt;/color&gt;效果</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                </statOffsets>
				<statFactors>

				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
</Defs>
