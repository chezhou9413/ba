        <defName>BAWC_TraitDef_Arisu_B_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#4169E1&gt;永不放弃的心&lt;/color&gt;</label>
                <description>被动技能:自身攻击力增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					 <BANW_FinalDamageMultiplier>+0.26</BANW_FinalDamageMultiplier>
                </statOffsets>
				<statFactors>

				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Arisu_B_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#4169E1&gt;形态：阿比舒&lt;/color&gt;</label>
                <description>被动技能:解放所有的可能性，所有攻击必定暴击，普通攻击不会有冷却时间，暴击伤害增加&lt;color=#DC143C&gt;40%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<BANW_CriticalDamage>0.40</BANW_CriticalDamage>
                </statOffsets>
				<statFactors>
              <RangedCooldownFactor>0</RangedCooldownFactor>
				</statFactors>
            </li>
        </degreeDatas>
