			<li>
				<skill>Construction</skill>
				<range>8~15</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>7~15</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>12</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>20</range>
			</li>
		</skills>
