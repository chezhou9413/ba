         <li>BANC_Arisu_B</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Arisu_B</li>
			<li>BANW_Body_Arisu_Bag</li>
		</apparelRequired>
		
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>18</range>
