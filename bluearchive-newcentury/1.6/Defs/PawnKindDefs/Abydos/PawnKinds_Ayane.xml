<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Ayane</defName>
		<label>-绫音-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>
		<defaultFactionType>PlayerColony</defaultFactionType>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<abilities>
			<li>BAWN_Ayane_EXX</li>
		</abilities>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryAbydos</li>
					<li>BANW_BackstoryAyane</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Ayane</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Ayane</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>1~3</range>
			</li>
			<li>
				<skill>Construction</skill>
				<range>7~8</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>8~10</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>8</range>
			</li>
			<li>
				<skill>Medicine</skill>
				<range>8</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>14</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Medical>0</BAWC_TraitDef_Medical>
			<BAWC_TraitDef_guantong>0</BAWC_TraitDef_guantong>
			<BAWC_TraitDef_qing>0</BAWC_TraitDef_qing>
			<BAWC_TraitDef_Ayane>0</BAWC_TraitDef_Ayane>
			<BAWC_TraitDef_Ayane_A>0</BAWC_TraitDef_Ayane_A>
		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Through</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Explosion</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.06</li>
						<li>0.12</li>
						<li>0.20</li>
						<li>0.30</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<attackFlat>
					<starValues>
						<li>0</li>
						<li>5</li>
						<li>10</li>
						<li>18</li>
						<li>30</li>
					</starValues>
				</attackFlat>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>30</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Ayane_A_levelup_A</li>
                    <li>Ayane_A_levelup_B</li>
					<li>Ayane_A_levelup_C</li>
					<li>Ayane_A_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                    <li>Ayane_A_levelup_A</li>
                    <li>Ayane_A_levelup_B</li>
					<li>Ayane_A_levelup_C</li>
					<li>Ayane_A_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>绫音</kindName>
				<kindDesName>奥空 绫音</kindDesName>
				<Gender>Female</Gender>
				<kindAge>15</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Ayane/Halo/Ayane_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Ayane/Head/Ayane_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Ayane/Body/Ayane_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Ayane/Hair/Ayane_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Ayane/Hair/Ayane_BackHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_halo_layer2</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Ayane/Halo/Ayane_Halo</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>
<TraitDef>
        <defName>BAWC_TraitDef_Ayane</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#191970&gt;对策委员会书记&lt;/color&gt;</label>
                <description>{PAWN_nameDef}作为阿拜多斯对策委员会的书记，她重视基本理论与规定，是个原则主义者，为了复兴阿拜多斯高中，一直踏实地努力着，在面对各种事务时都秉持着认真的态度。</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
				<FixBrokenDownBuildingSuccessChance>0.5</FixBrokenDownBuildingSuccessChance>
				<WorkSpeedGlobal>+0.30</WorkSpeedGlobal>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
<TraitDef>
        <defName>BAWC_TraitDef_Ayane_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;自我提升&lt;/color&gt;</label>
                <description>被动技能:自身治愈力增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                   <BANW_HealPowerMultiplier>0.26</BANW_HealPowerMultiplier>
                </statOffsets>
				<statFactors>

				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
</Defs>
