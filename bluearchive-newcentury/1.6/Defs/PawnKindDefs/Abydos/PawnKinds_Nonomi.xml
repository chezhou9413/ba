					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Nonomi/Body/Nonomi_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Nonomi/Hair/Nonomi_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Abydos/Nonomi/Hair/Nonomi_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
