					<starValues>
						<li>0</li>
						<li>0.12</li>
						<li>0.25</li>
						<li>0.35</li>
						<li>0.50</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<!-- 升星固定治愈力成长，进入治愈力公式的固定加算项。 -->
