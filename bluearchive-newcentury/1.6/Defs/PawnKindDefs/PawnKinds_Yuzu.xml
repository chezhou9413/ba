<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Yuzu</defName>
		<label>-柚子-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>

		<defaultFactionType>PlayerColony</defaultFactionType>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryMillennium</li>
					<li>BANW_BackstoryYuzu</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Yuzu</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Yuzu</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>8~12</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>10~15</range>
			</li>
			<li>
				<skill>Mining</skill>
				<range>6~8</range>
			</li>
			<li>
				<skill>Artistic</skill>
				<range>8</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>0</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>16</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Attack>0</BAWC_TraitDef_Attack>
			<BAWC_TraitDef_teshu>0</BAWC_TraitDef_teshu>
		</forcedTraits>
		<modExtensions>
			<li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
                <!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>30</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Arisu_levelup_A</li>
                    <li>Arisu_levelup_B</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                    <li>Arisu_levelup_C</li>
                    <li>Arisu_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>柚子</kindName>
				<kindDesName>花冈 柚子</kindDesName>
				<Gender>Female</Gender>
				<kindAge>16</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuzu/Halo/Yuzu_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuzu/Hair/Yuzu_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuzu/Hair/Yuzu_BackHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head_layer4</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuzu/Head/Yuzu_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body_layer2</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuzu/Body/Yuzu_Body</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>

</Defs>
