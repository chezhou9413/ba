<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Misaki</defName>
		<label>-美咲-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>
		<defaultFactionType>PlayerColony</defaultFactionType>
		<generateInitialNonFamilyRelations>false</generateInitialNonFamilyRelations>
		
		<humanPregnancyChance>0.0</humanPregnancyChance>
		<fixedGender>Female</fixedGender>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<abilities>
		</abilities>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryArian</li>
					<li>BANW_BackstoryMisaki</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<useFactionXenotypes>true</useFactionXenotypes>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>17</minGenerationAge>
		<maxGenerationAge>18</maxGenerationAge>
		<weaponTags>
         <li>BANC_Misaki</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Misaki</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>

		<skills>
			<li>
				<skill>Shooting</skill>
				<range>10~19</range>
			</li>
			<li>
				<skill>Plants</skill>
				<range>5~10</range>
			</li>
			<li>
				<skill>Medicine</skill>
				<range>5</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>0</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>0</range>
			</li>
		</skills>
		<forcedTraits>
		<BAWC_TraitDef_Attack>0</BAWC_TraitDef_Attack>
		<BAWC_TraitDef_baofa>0</BAWC_TraitDef_baofa>
		<BAWC_TraitDef_teshu>0</BAWC_TraitDef_teshu>
		<BAWC_TraitDef_Misaki_A></BAWC_TraitDef_Misaki_A>
		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Explosion</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Mysterious</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.06</li>
						<li>0.12</li>
						<li>0.20</li>
						<li>0.30</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<attackFlat>
					<starValues>
						<li>0</li>
						<li>5</li>
						<li>10</li>
						<li>18</li>
						<li>30</li>
					</starValues>
				</attackFlat>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>110</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Misaki_levelup_A</li>
                    <li>Misaki_levelup_B</li>
					<li>Misaki_levelup_C</li>
					<li>Misaki_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Misaki_levelup_A</li>
                    <li>Misaki_levelup_B</li>
					<li>Misaki_levelup_C</li>
					<li>Misaki_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>美咲</kindName>
				<kindDesName>戒野 美咲</kindDesName>
				<Gender>Female</Gender>
				<kindAge>17</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Arian/Misaki/Halo/Misaki_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Arian/Misaki/Head/Misaki_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Arian/Misaki/Body/Misaki_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Arian/Misaki/Hair/Misaki_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Arian/Misaki/Hair/Misaki_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>

	<TraitDef>
        <defName>BAWC_TraitDef_Misaki_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#DC143C&gt;毫无意义的技术&lt;/color&gt;</label>
                <description>被动技能:自身攻击力增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<BANW_FinalDamageMultiplier>0.26</BANW_FinalDamageMultiplier>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
</Defs>
