<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Juri</defName>
		<label>-朱莉-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>

		<defaultFactionType>PlayerColony</defaultFactionType>
		<abilities>
			<li>BAWN_Juri_EX</li>
        </abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryGehena</li>
					<li>BANW_BackstoryJuri</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Juri</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Juri</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>5~10</range>
			</li>
			<li>
				<skill>Cooking</skill>
				<range>20</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>4~10</range>
			</li>
			<li>
				<skill>Plants</skill>
				<range>10~15</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Assistant>0</BAWC_TraitDef_Assistant>
			<BAWC_TraitDef_qing>0</BAWC_TraitDef_qing>
			<BAWC_TraitDef_Juri>0</BAWC_TraitDef_Juri>
			<BAWC_TraitDef_Juri_A>0</BAWC_TraitDef_Juri_A>
			<BAWC_TraitDef_Juri_B>0</BAWC_TraitDef_Juri_B>
		</forcedTraits>
		<modExtensions>
			<li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>0</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Juri_levelup_A</li>
                    <li>Juri_levelup_B</li>
					<li>Juri_levelup_C</li>
					<li>Juri_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Juri_levelup_A</li>
                    <li>Juri_levelup_B</li>
					<li>Juri_levelup_C</li>
					<li>Juri_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>朱莉</kindName>
				<kindDesName>牛牧 朱莉</kindDesName>
				<Gender>Female</Gender>
				<kindAge>15</kindAge>
			</li>
		
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Juri/Halo/Juri_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Juri/Head/Juri_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Juri/Body/Juri_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Juri/Hair/Juri_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Juri/Hair/Juri_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>
<TraitDef>
        <defName>BAWC_TraitDef_Juri</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFB6C1&gt;格黑娜的炼金术士&lt;/color&gt;</label>
                <description>{PAWN_nameDef}虽然身为料理部的一员，可是她的手艺已经超过了一般的糟糕，做出来的料理可以算是毁灭级别，所以对供餐提供不了帮助</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<FoodPoisonChance>99.99</FoodPoisonChance>
                    <ToxicEnvironmentResistance>0.5</ToxicEnvironmentResistance>
					<ToxicResistance>0.5</ToxicResistance>
					<GlobalLearningFactor>0.2</GlobalLearningFactor>
                </statOffsets>
				<statFactors>
					<FoodPoisonChance>99.99</FoodPoisonChance>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Juri_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#DC143C&gt;干劲十足！&lt;/color&gt;</label>
                <description>被动技能:自身攻击力增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<BANW_FinalDamageMultiplier>0.26</BANW_FinalDamageMultiplier>
                </statOffsets>
				<statFactors>

				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>

	<TraitDef>
        <defName>BAWC_TraitDef_Juri_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#DC143C&gt;用餐时间到！&lt;/color&gt;</label>
                <description>子技能:自身&lt;color=#DC143C&gt;生命值增加17%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<BANW_HealthScalePercentOffset>0.17</BANW_HealthScalePercentOffset>
                </statOffsets>
				<statFactors>

				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
</Defs>
