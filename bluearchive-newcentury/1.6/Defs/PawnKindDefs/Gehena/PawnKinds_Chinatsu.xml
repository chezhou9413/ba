<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Chinatsu</defName>
		<label>-千夏-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>

		<defaultFactionType>PlayerColony</defaultFactionType>
		<abilities>
        </abilities>
		<abilities>
        <li>BAWN_Chinatsu_EX</li>
		<li>BAWN_Chinatsu_EXX</li>
        </abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryGehena</li>
					<li>BANW_BackstoryChinatsu</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Chinatsu</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Chinatsu</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>5</range>
			</li>
			<li>
				<skill>Medicine</skill>
				<range>17</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>5~8</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>8~10</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Medical>0</BAWC_TraitDef_Medical>
			<BAWC_TraitDef_guantong>0</BAWC_TraitDef_guantong>
			<BAWC_TraitDef_qing>0</BAWC_TraitDef_qing>
			<BAWC_TraitDef_Chinatsu_A>0</BAWC_TraitDef_Chinatsu_A>
			<BAWC_TraitDef_Chinatsu_B>0</BAWC_TraitDef_Chinatsu_B>
		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Through</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Explosion</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.12</li>
						<li>0.25</li>
						<li>0.35</li>
						<li>0.50</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<!-- 星级基础治愈力平加成长，先加入基础治愈力再乘治愈力百分比。 -->
				<healPercent>
					<starValues>
						<li>0</li>
						<li>0.1</li>
						<li>0.2</li>
						<li>0.3</li>
						<li>0.45</li>
					</starValues>
				</healPercent>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>0</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Chinatsu_levelup_A</li>
                    <li>Chinatsu_levelup_B</li>
					<li>Chinatsu_levelup_C</li>
					<li>Chinatsu_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Chinatsu_levelup_A</li>
                    <li>Chinatsu_levelup_B</li>
					<li>Chinatsu_levelup_C</li>
					<li>Chinatsu_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>千夏</kindName>
				<kindDesName>火宫 千夏</kindDesName>
				<Gender>Female</Gender>
				<kindAge>15</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Chinatsu/Halo/Chinatsu_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Chinatsu/Head/Chinatsu_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Chinatsu/Body/Chinatsu_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Chinatsu/Hair/Chinatsu_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Chinatsu/Hair/Chinatsu_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>
<TraitDef>
        <defName>BAWC_TraitDef_Chinatsu_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;强化医疗支援&lt;/color&gt;</label>
                <description>被动技能:自身治愈力增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                    <BANW_HealPowerMultiplier>0.26</BANW_HealPowerMultiplier>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
<TraitDef>
        <defName>BAWC_TraitDef_Chinatsu_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;强化防御支援&lt;/color&gt;</label>
                <description>被动技能:自身护甲值增加&lt;color=#DC143C&gt;17%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<ArmorRating_Sharp>0.17</ArmorRating_Sharp>
		        <ArmorRating_Blunt>0.17</ArmorRating_Blunt>
	            <ArmorRating_Heat>0.17</ArmorRating_Heat>
                </statOffsets>
				<statFactors>
				<ArmorRating_Sharp>1.17</ArmorRating_Sharp>
		        <ArmorRating_Blunt>1.17</ArmorRating_Blunt>
	            <ArmorRating_Heat>1.17</ArmorRating_Heat>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
</Defs>
