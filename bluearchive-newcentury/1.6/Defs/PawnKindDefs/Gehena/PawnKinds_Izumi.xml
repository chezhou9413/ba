					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Izumi/Hair/Izumi_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Izumi/Hair/Izumi_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
