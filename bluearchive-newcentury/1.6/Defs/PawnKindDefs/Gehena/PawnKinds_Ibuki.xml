
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Ibuki</defName>
		<label>-伊吹-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>

		<defaultFactionType>PlayerColony</defaultFactionType>
		<abilities>
			<li>BAWN_Ibuki_EX</li>
			<li>BAWN_Ibuki_EXX</li>
        </abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryGehena</li>
					<li>BANW_BackstoryIbuki</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>11</minGenerationAge>
		<maxGenerationAge>12</maxGenerationAge>
		<weaponTags>
         <li>BANC_Ibuki</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Ibuki</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>6</range>
			</li>
			<li>
				<skill>Artistic</skill>
				<range>8</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>14~15</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>6</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Assistant>0</BAWC_TraitDef_Assistant>
			<BAWC_TraitDef_shenmi>0</BAWC_TraitDef_shenmi>
			<BAWC_TraitDef_zhong>0</BAWC_TraitDef_zhong>
			<BAWC_TraitDef_Ibuki_A>0</BAWC_TraitDef_Ibuki_A>
			<BAWC_TraitDef_Ibuki_B>0</BAWC_TraitDef_Ibuki_B>
		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Mysterious</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Through</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.12</li>
						<li>0.25</li>
						<li>0.35</li>
						<li>0.50</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<!-- 升星固定治愈力成长，进入治愈力公式的固定加算项。 -->
				<healPercent>
					<starValues>
						<li>0</li>
						<li>0.1</li>
						<li>0.2</li>
						<li>0.3</li>
						<li>0.45</li>
					</starValues>
				</healPercent>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>0</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Ibuki_levelup_A</li>
                    <li>Ibuki_levelup_B</li>
					<li>Ibuki_levelup_C</li>
					<li>Ibuki_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Ibuki_levelup_A</li>
                    <li>Ibuki_levelup_B</li>
					<li>Ibuki_levelup_C</li>
					<li>Ibuki_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>伊吹</kindName>
				<kindDesName>丹花 伊吹</kindDesName>
				<Gender>Female</Gender>
				<kindAge>11</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Ibuki/Halo/Ibuki_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Ibuki/Head/Ibuki_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Ibuki/Body/Ibuki_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Ibuki/Hair/Ibuki_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Gehena/Ibuki/Hair/Ibuki_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>
<TraitDef>
        <defName>BAWC_TraitDef_Ibuki_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#4169E1&gt;品行端正的孩子&lt;/color&gt;</label>
                <description>被动技能：自身&lt;color=#DC143C&gt;生命值增加26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets> 
					<BANW_HealthBonusMultiplier>0.26</BANW_HealthBonusMultiplier>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Ibuki_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#4169E1&gt;万魔殿的可爱吉祥物&lt;/color&gt;</label>
                <description>子技能：使用EX技能时自身获得每秒恢复&lt;color=#DC143C&gt;8&lt;/color&gt;点生命值的治疗效果</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets> 
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
</Defs>
