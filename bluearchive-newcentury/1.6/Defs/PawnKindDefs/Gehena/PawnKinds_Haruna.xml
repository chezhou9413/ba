			 <li>
				<skill>Cooking</skill>
				<range>6</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>6</range>
			</li>
			<li>
				<skill>Artistic</skill>
				<range>17</range>
			</li>
			<li>
