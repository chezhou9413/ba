					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Sany/Hanako/Halo/Hanako_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Sany/Hanako/Head/Hanako_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Sany/Hanako/Body/Hanako_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Sany/Hanako/Hair/Hanako_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Sany/Hanako/Hair/Hanako_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
