                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Mika</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFC0CB&gt;圣猿未花&lt;/color&gt;</label>
                <description>{PAWN_nameDef}是茶话会的一员，拥有天生的怪力，天真的性格，容易被其他人的话语影响自己的判断，她表面上天真烂漫、活泼开朗，但内心也有着复杂的一面</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
