	<TraitDef>
        <defName>BAWC_TraitDef_Mika_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;格洛丽亚·帕特里&lt;/color&gt;</label>
                <description>被动技能:增加自身&lt;color=#DC143C&gt;26%&lt;/color&gt;的攻击力。</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<BANW_FinalDamageMultiplier>+0.26</BANW_FinalDamageMultiplier>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Mika_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;本尼迪克特&lt;/color&gt;</label>
