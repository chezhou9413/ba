<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Azusa</defName>
		<label>-梓-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>
		<defaultFactionType>PlayerColony</defaultFactionType>
		<abilities>
			<li>BAWN_Azusa_EX</li>
		</abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstorySany</li>
					<li>BANW_BackstoryAzusa</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Azusa</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Azusa</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>18~20</range>
			</li>
			<li>
				<skill>Melee</skill>
				<range>15</range>
			</li>
			<li>
				<skill>Mining</skill>
				<range>11~12</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>8~10</range>
			</li>
			<li>
				<skill>Plants</skill>
				<range>6</range>
			</li>
			<li>
				<skill>Animals</skill>
				<range>6</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>1</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>7</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Attack>0</BAWC_TraitDef_Attack>
			<BAWC_TraitDef_baofa>0</BAWC_TraitDef_baofa>
			<BAWC_TraitDef_zhong>0</BAWC_TraitDef_zhong>
			<BAWC_TraitDef_Azusa_A>0</BAWC_TraitDef_Azusa_A>
			<BAWC_TraitDef_Azusa_B>0</BAWC_TraitDef_Azusa_B>
		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Explosion</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Through</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.06</li>
						<li>0.12</li>
						<li>0.20</li>
						<li>0.30</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<attackFlat>
					<starValues>
						<li>0</li>
						<li>5</li>
						<li>10</li>
						<li>18</li>
						<li>30</li>
					</starValues>
				</attackFlat>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>110</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Azusa_levelup_A</li>
                    <li>Azusa_levelup_B</li>
					<li>Azusa_levelup_C</li>
					<li>Azusa_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Azusa_levelup_A</li>
                    <li>Azusa_levelup_B</li>
					<li>Azusa_levelup_C</li>
					<li>Azusa_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>梓</kindName>
				<kindDesName>白洲 梓</kindDesName>
				<Gender>Female</Gender>
				<kindAge>15</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Sany/Azusa/Halo/Azusa_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Sany/Azusa/Head/Azusa_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Sany/Azusa/Body/Azusa_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Sany/Azusa/Hair/Azusa_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Sany/Azusa/Hair/Azusa_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>
<TraitDef>
        <defName>BAWC_TraitDef_Azusa_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#DC143C&gt;严酷的训练 &lt;/color&gt;</label>
                <description>被动技能:自身暴击率增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<BANW_CriticalChance>0.26</BANW_CriticalChance>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
<TraitDef>
        <defName>BAWC_TraitDef_Azusa_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#DC143C&gt;瞄准弱点&lt;/color&gt;</label>
                <description>子技能:自身攻击时有&lt;color=#00FFFF&gt;20%&lt;/color&gt;的概率造成&lt;color=#DC143C&gt;80%&lt;/color&gt;攻击力的追加伤害</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
</Defs>
