		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Turugi</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Turugi</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>

		<skills>
			<li>
				<skill>Shooting</skill>
				<range>20</range>
			</li>
			<li>
				<skill>Melee</skill>
				<range>15</range>
			</li>
			<li>
				<skill>Mining</skill>
				<range>10</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>0</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>7</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Attack>0</BAWC_TraitDef_Attack>
			<BAWC_TraitDef_zhong>0</BAWC_TraitDef_zhong>
			<BAWC_TraitDef_Turugi>0</BAWC_TraitDef_Turugi>
			<BAWC_TraitDef_Turugi_A>0</BAWC_TraitDef_Turugi_A>
			<BAWC_TraitDef_Turugi_B>0</BAWC_TraitDef_Turugi_B>
		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Through</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Through</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.06</li>
						<li>0.12</li>
						<li>0.20</li>
						<li>0.30</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<attackFlat>
					<starValues>
						<li>0</li>
						<li>5</li>
						<li>10</li>
						<li>18</li>
						<li>30</li>
					</starValues>
				</attackFlat>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>110</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Turugi_levelup_A</li>
                    <li>Turugi_levelup_B</li>
					<li>Turugi_levelup_C</li>
					<li>Turugi_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Turugi_levelup_A</li>
                    <li>Turugi_levelup_B</li>
					<li>Turugi_levelup_C</li>
					<li>Turugi_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>鹤城</kindName>
				<kindDesName>剑先 鹤城</kindDesName>
				<Gender>Female</Gender>
				<kindAge>17</kindAge>
			</li>
			<li Class="BANWlLib.KindStats.BANWKindStatExtension">
        <worldCargoCapacityOffset>100</worldCargoCapacityOffset>
      </li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Sany/Turugi/Halo/Turugi_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Sany/Turugi/Head/Turugi_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Sany/Turugi/Body/Turugi_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Sany/Turugi/Hair/Turugi_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Sany/Turugi/Hair/Turugi_BackHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_halo_layer2</BodyAddonName>
						<ReplacePath>Pawns/Sany/Turugi/Halo/Turugi_Halo</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>
<TraitDef>
        <defName>BAWC_TraitDef_Turugi</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FF7F50&gt;圣三一的战略兵器&lt;/color&gt;</label>
                <description>{PAWN_nameDef}的性格核心是与生俱来的好战与暴躁，堪称 "行动先于思考" 的典型。面对不满的事物或违背她认知的状况，会第一时间选择用武力解决，甚至做出冲上去撞电车这类看似失控的举动。日常表情管理完全失控，给人极具冲击力的强势印象。这种狂躁并非无的放矢，更多是对 "正义" 的直接践行 —— 用最迅猛的方式扫清障碍。</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
				<MeleeDodgeChance>5</MeleeDodgeChance>
				<IncomingDamageFactor>-0.1</IncomingDamageFactor>
				<MoveSpeed>2.80</MoveSpeed>
				<Flammability>-0.6</Flammability>
                </statOffsets>
				<statFactors>
				<StaggerDurationFactor>0</StaggerDurationFactor>
				<MeleeDamageFactor>7.5</MeleeDamageFactor>
				<MeleeArmorPenetration>2.5</MeleeArmorPenetration>
				<MeleeCooldownFactor>0.5</MeleeCooldownFactor>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>

