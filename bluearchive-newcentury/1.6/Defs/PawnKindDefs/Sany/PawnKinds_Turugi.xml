                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                    
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
<HediffDef>
    <defName>BANW_Turugi_HpBuff</defName>
    <label>肉体再生</label>
    <description>鹤城的夸张的治愈能力，能在肉眼可见的速度修复自身的伤口</description>
	<labelNoun>每秒回复60点血</labelNoun>
    <defaultLabelColor>(255, 0, 0)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
	<everCurableByItem>false</everCurableByItem>
        
		 <stages>
          <li>
          <painFactor>0.70</painFactor>     
           <statOffsets>
			<ImmunityGainSpeed>2.0</ImmunityGainSpeed>
            </statOffsets>
           </li>
          </stages>
    <comps>
      <li Class="BANWlLib.comp.HediffCompProps_Regeneration">
        <healAmount>6</healAmount>
        <healIntervalTicks>6</healIntervalTicks>
		<isHeatScar>true</isHeatScar>
      </li>
    </comps>
  </HediffDef>
</Defs>
