<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Yuuka</defName>
		<label>-优香-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>
		<defaultFactionType>PlayerColony</defaultFactionType>
		<abilities>
        <li>BAWN_Yuuka_EX</li>
        </abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
		<li>
			<def>BANW_Yuuka_HpBuff</def>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryMillennium</li>
					<li>BANW_BackstoryYuuka</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Yuuka</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Yuuka</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>8~14</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>10~15</range>
			</li>
			<li>
				<skill>Construction</skill>
				<range>9</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>15</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>18</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Tank>0</BAWC_TraitDef_Tank>
			<BAWC_TraitDef_baofa>0</BAWC_TraitDef_baofa>
			<BAWC_TraitDef_zhong>0</BAWC_TraitDef_zhong>
			<BAWC_TraitDef_Yuuka_A>0</BAWC_TraitDef_Yuuka_A>
			<BAWC_TraitDef_Yuuka_B>0</BAWC_TraitDef_Yuuka_B>
		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Explosion</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Through</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.12</li>
						<li>0.25</li>
						<li>0.35</li>
						<li>0.50</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<!-- 星级基础治愈力平加成长，先加入基础治愈力再乘治愈力百分比。 -->
				<healPercent>
					<starValues>
						<li>0</li>
						<li>0.1</li>
						<li>0.2</li>
						<li>0.3</li>
						<li>0.45</li>
					</starValues>
				</healPercent>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>30</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Yuuka_levelup_A</li>
                    <li>Yuuka_levelup_B</li>
					<li>Yuuka_levelup_C</li>
					<li>Yuuka_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Yuuka_levelup_A</li>
                    <li>Yuuka_levelup_B</li>
					<li>Yuuka_levelup_C</li>
					<li>Yuuka_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>优香</kindName>
				<kindDesName>早濑 优香</kindDesName>
				<Gender>Female</Gender>
				<kindAge>16</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuuka/Halo/Yuuka_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuuka/Head/Yuuka_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuuka/Body/Yuuka_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuuka/Hair/Yuuka_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuuka/Hair/Yuuka_BackHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_halo_layer2</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Yuuka/Halo/Yuuka_Halo</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>

	<TraitDef>
        <defName>BAWC_TraitDef_Yuuka_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#DC143C&gt;导出最优解&lt;/color&gt;</label>
                <description>被动技能:自身护甲值增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                </statOffsets>
				<statFactors>
			    <ArmorRating_Sharp>1.26</ArmorRating_Sharp>
		        <ArmorRating_Blunt>1.26</ArmorRating_Blunt>
	            <ArmorRating_Heat>1.26</ArmorRating_Heat>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>

<TraitDef>
        <defName>BAWC_TraitDef_Yuuka_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#DC143C&gt;高速演算&lt;/color&gt;</label>
                <description>子技能:自身获得每10秒回复&lt;color=#DC143C&gt;52&lt;/color&gt;点生命值</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>

<HediffDef>
    <defName>BANW_Yuuka_HpBuff</defName>
    <label>高速演算</label>
    <description>子技能:自身获得每10秒回复&lt;color=#DC143C&gt;100&lt;/color&gt;点生命值</description>
    <defaultLabelColor>(0, 94, 255)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
	<everCurableByItem>false</everCurableByItem>
        
		 <stages>
          <li>     
           <statOffsets>
            </statOffsets>
           </li>
          </stages>
    <comps>
      <li Class="BANWlLib.comp.HediffCompProps_Regeneration">
        <healAmount>100</healAmount>
        <healIntervalTicks>600</healIntervalTicks>
      </li>
    </comps>
  </HediffDef>
</Defs>
