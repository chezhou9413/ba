<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Momoi</defName>
		<label>-桃井-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>
		<defaultFactionType>PlayerColony</defaultFactionType>
		<abilities>
        <li>BAWN_Momoi_EX</li>
		<li>BAWN_Momoi_EXX</li>
        </abilities>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryMillennium</li>
					<li>BANW_BackstoryMomoi</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Momoi</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Momoi</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>10~15</range>
			</li>
			<li>
				<skill>Construction</skill>
				<range>8~10</range>
			</li>
			<li>
				<skill>Artistic</skill>
				<range>8~12</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>8~10</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>8~10</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>9</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Attack>0</BAWC_TraitDef_Attack>
			<BAWC_TraitDef_qing>0</BAWC_TraitDef_qing>
			<BAWC_TraitDef_Momoi_A>0</BAWC_TraitDef_Momoi_A>
			<BAWC_TraitDef_Momoi_B>0</BAWC_TraitDef_Momoi_B>
		</forcedTraits>
		<modExtensions>
			
			<li Class="BANWlLib.BattleSystem.BattleBaseStatExtension">
				<!-- 攻击类型，作为属性克制矩阵的行。 -->
				<damageType>Through</damageType>
				<!-- 护甲类型，作为属性克制矩阵的列。 -->
				<defenseType>Explosion</defenseType>
			</li>
			<li Class="BANWlLib.BattleSystem.BattleStarGrowthExtension">
				<!-- 星级生命百分比成长，starValues 从 1 星到 5 星依次读取。 -->
				<healthPercent>
					<starValues>
						<li>0</li>
						<li>0.08</li>
						<li>0.16</li>
						<li>0.25</li>
						<li>0.35</li>
					</starValues>
				</healthPercent>
				<!-- 星级攻击百分比成长，参与 BattleStatUtility 的最终攻击力计算。 -->
				<attackPercent>
					<starValues>
						<li>0</li>
						<li>0.12</li>
						<li>0.25</li>
						<li>0.35</li>
						<li>0.50</li>
					</starValues>
				</attackPercent>
				<!-- 星级攻击平加成长，先加入基础攻击力再乘百分比。 -->
				<!-- 星级基础治愈力平加成长，先加入基础治愈力再乘治愈力百分比。 -->
				<healPercent>
					<starValues>
						<li>0</li>
						<li>0.1</li>
						<li>0.2</li>
						<li>0.3</li>
						<li>0.45</li>
					</starValues>
				</healPercent>
			</li><li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>30</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Momoi_levelup_A</li>
                    <li>Momoi_levelup_B</li>
					<li>Momoi_levelup_C</li>
					<li>Momoi_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Momoi_levelup_A</li>
                    <li>Momoi_levelup_B</li>
					<li>Momoi_levelup_C</li>
					<li>Momoi_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>桃井</kindName>
				<kindDesName>才羽 桃井</kindDesName>
				<Gender>Female</Gender>
				<kindAge>15</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Momoi/Halo/Momoi_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Momoi/Head/Momoi_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Momoi/Body/Momoi_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Momoi/Hair/Momoi_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Momoi/Hair/Momoi_BackHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>

	<TraitDef>
        <defName>BAWC_TraitDef_Momoi_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;创造性品味&lt;/color&gt;</label>
                <description>被动技能:增加自身&lt;color=#DC143C&gt;26%&lt;/color&gt;的暴击率。</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<BANW_CriticalChance>0.26</BANW_CriticalChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

	<TraitDef>
        <defName>BAWC_TraitDef_Momoi_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;开发者协同效应：绿&lt;/color&gt;</label>
                <description>子技能:增加自身&lt;color=#DC143C&gt;31%&lt;/color&gt;的攻击力。</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
					<BANW_FinalDamageMultiplier>+0.26</BANW_FinalDamageMultiplier>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>
</Defs>
