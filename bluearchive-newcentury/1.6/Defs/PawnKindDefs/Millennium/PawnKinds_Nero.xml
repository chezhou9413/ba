	<TraitDef>
        <defName>BAWC_TraitDef_Nero</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFA500&gt;最强的小个子女仆&lt;/color&gt;</label>
                <description>{PAWN_nameDef}表面是穿着女仆装搭配刺绣夹克的不良少女，操着混混腔调、行事暴力直接，甚至会用冲锋枪威胁他人。但作为千年学园秘密组织「CC」的部长，她实则是代号「Double O」的顶级特工，拥有「千年最强战力」，被视为「胜利的象征」。</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
				<ArmorRating_Sharp>0.5</ArmorRating_Sharp>
		        <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
	            <ArmorRating_Heat>0.5</ArmorRating_Heat>
				<MeleeDodgeChance>20</MeleeDodgeChance>
				<IncomingDamageFactor>-0.1</IncomingDamageFactor>
				<MoveSpeed>5.80</MoveSpeed>
				<Flammability>-0.6</Flammability>
				<AimingDelayFactor>-0.80</AimingDelayFactor>
				<CarryingCapacity>100</CarryingCapacity> 
				<ShootingAccuracyPawn>30</ShootingAccuracyPawn>
                </statOffsets>
				<statFactors>
				<ShootingAccuracyPawn>2.0</ShootingAccuracyPawn>
				<StaggerDurationFactor>0</StaggerDurationFactor>
				<MeleeDamageFactor>5.5</MeleeDamageFactor>
				<MeleeArmorPenetration>5.5</MeleeArmorPenetration>
				<MeleeCooldownFactor>0.2</MeleeCooldownFactor>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>

