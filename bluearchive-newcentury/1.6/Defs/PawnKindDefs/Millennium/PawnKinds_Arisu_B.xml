					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Arisu_B/Body/Arisu_B_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_halo_layer2</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Arisu_B/Halo/Arisu_B_Halo</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head_layer5</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Arisu_B/Head/Arisu_B_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback_layer2</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Arisu_B/Hair/Arisu_B_BackHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront_layer4</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Arisu_B/Hair/Arisu_B_FrontHair</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
	</PawnKindDef>
