<TraitDef>
        <defName>BAWC_TraitDef_Chihiro_A</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;利用漏洞&lt;/color&gt;</label>
                <description>被动技能:自身护甲穿透增加&lt;color=#DC143C&gt;26%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
                    <BANW_RangedWeapon_Penetration>0.26</BANW_RangedWeapon_Penetration>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
</TraitDef>
<TraitDef>
        <defName>BAWC_TraitDef_Chihiro_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;构筑防火墙&lt;/color&gt;</label>
                <description>子技能:自身疼痛感受降低&lt;color=#DC143C&gt;17%&lt;/color&gt;</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
            </li>
        </degreeDatas>
</TraitDef>
 <HediffDef>
    <defName>BAWC_TraitDef_Chihiro_Buff</defName>
    <label>构筑防火墙</label>
    <description>自身疼痛感受降低17%</description>
    <defaultLabelColor>(255,187,0)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <painFactor>0.83</painFactor>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
      <li Class="BANWlLib.comp.HediffCompProps_Regeneration">
        <healAmount>8</healAmount>
        <healIntervalTicks>150</healIntervalTicks>
      </li>
    </comps>
  </HediffDef>
</Defs>
