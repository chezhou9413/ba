<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<PawnKindDef ParentName="BANW_BasePawn">
		<defName>BANW_Chihiro</defName>
		<label>-千寻-</label>
		<race>BANW_KivotosStudent</race>
		<combatPower>100</combatPower>
		<isFighter>true</isFighter>

		<defaultFactionType>PlayerColony</defaultFactionType>
		<startingHediffs>
		<li>
			<def>BANW_LevelTrait</def>
			<severity>0.001</severity>
		</li>
		<li>
			<def>BAWC_TraitDef_Chihiro_Buff</def>
		</li>
        </startingHediffs>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>BANW_BackstoryMillennium</li>
					<li>BANW_BackstoryChihiro</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<weaponMoney>9999~9999</weaponMoney>
		<minGenerationAge>15</minGenerationAge>
		<maxGenerationAge>16</maxGenerationAge>
		<weaponTags>
         <li>BANC_Chihiro</li>
        </weaponTags>
		<apparelRequired Inherit="False">
			<li>BANW_Body_Chihiro</li>
		</apparelRequired>
		<forcedHair>Bald</forcedHair>
		<skills>
			<li>
				<skill>Shooting</skill>
				<range>8~12</range>
			</li>
			<li>
				<skill>Construction</skill>
				<range>10~15</range>
			</li>
			<li>
				<skill>Crafting</skill>
				<range>15</range>
			</li>
			<li>
				<skill>Cooking</skill>
				<range>9~12</range>
			</li>
			<li>
				<skill>Artistic</skill>
				<range>9</range>
			</li>
			<li>
				<skill>Social</skill>
				<range>9</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>18</range>
			</li>
		</skills>
		<forcedTraits>
			<BAWC_TraitDef_Attack>0</BAWC_TraitDef_Attack>
			<BAWC_TraitDef_zhong>0</BAWC_TraitDef_zhong>
			<BAWC_TraitDef_Chihiro_A>0</BAWC_TraitDef_Chihiro_A>
			<BAWC_TraitDef_Chihiro_B>0</BAWC_TraitDef_Chihiro_B>
		</forcedTraits>
		<modExtensions>
			<li Class="BANWlLib.PawnProgressBarKindExtension">
				<starInterval>0.5</starInterval>
				<showProgressBar>false</showProgressBar>
				<starProgressRatios>
					<li>0.0</li>
					<li>0.09</li>
					<li>0.33</li>
					<li>0.63</li>
					<li>1.0</li>
				</starProgressRatios>
				<starSize>28</starSize>
				<starTexturePath>UI/StarIcon</starTexturePath>
				<!-- 起始星星经验：用于没有存档数据的新生成学生 -->
                <initialExperience>110</initialExperience>
                <!-- 升星特效占位：后续可替换为学生专属 EffecterDef -->
                <starUpEffects>
                    <li>BANW_Effecter_B</li>
                </starUpEffects>
                <!-- 升星语音占位：后续可替换为学生专属 SoundDef -->
                <starUpSounds>
                    <li>Chihiro_levelup_A</li>
                    <li>Chihiro_levelup_B</li>
					<li>Chihiro_levelup_C</li>
					<li>Chihiro_levelup_D</li>
                </starUpSounds>
                <!-- 升级特效占位：后续可替换为学生专属 EffecterDef -->
                <levelUpEffects>
                    <li>BANW_Effecter_LevelUp</li>
                </levelUpEffects>
                <!-- 升级语音占位：后续可替换为学生专属 SoundDef -->
                <levelUpSounds>
                     <li>Chihiro_levelup_A</li>
                    <li>Chihiro_levelup_B</li>
					<li>Chihiro_levelup_C</li>
					<li>Chihiro_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>千寻</kindName>
				<kindDesName>各务 千寻</kindDesName>
				<Gender>Female</Gender>
				<kindAge>17</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
						<BodyAddonName>KivotosStudent_halo</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Chihiro/Halo/Chihiro_Halo2</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_head</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Chihiro/Head/Chihiro_Head</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_Body</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Chihiro/Body/Chihiro_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Chihiro/Hair/Chihiro_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Chihiro/Hair/Chihiro_BackHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_halo_layer2</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Chihiro/Halo/Chihiro_Halo</ReplacePath>
					</li>
				</bodyAddonRules>
			</li>
		</modExtensions>
