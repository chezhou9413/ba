        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;“CC”的特工&lt;/color&gt;</label>
                <description>{PAWN_nameDef}她的代号为03，专门负责“清洁”。她常利用自己给人的温柔印象来潜入敌营，用炸药将敌营清扫干净，因此得名“清扫达人”。</description>
                <marketValueFactorOffset>1</marketValueFactorOffset>
                <statOffsets>
				<CleaningSpeed>5</CleaningSpeed>
				<GeneralLaborSpeed>0.3</GeneralLaborSpeed>
                </statOffsets>
				<statFactors>
				</statFactors>
            </li>
        </degreeDatas>
    </TraitDef>
	<TraitDef>
        <defName>BAWC_TraitDef_Akane_B</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>&lt;color=#FFBB00&gt;挺进，要敏捷&lt;/color&gt;</label>
