						<ReplacePath>Pawns/Millennium/Akane/Body/Akane_Body</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairfront</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Akane/Hair/Akane_FrontHair</ReplacePath>
					</li>
					<li>
						<BodyAddonName>KivotosStudent_hairback</BodyAddonName>
						<ReplacePath>Pawns/Millennium/Akane/Hair/Akane_BackHair</ReplacePath>
					</li>
