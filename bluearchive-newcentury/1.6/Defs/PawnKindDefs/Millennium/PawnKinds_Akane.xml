                     <li>Akane_levelup_A</li>
                    <li>Akane_levelup_B</li>
					<li>Akane_levelup_C</li>
					<li>Akane_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
				<kindName>茜</kindName>
				<kindDesName>室笠 茜</kindDesName>
				<Gender>Female</Gender>
				<kindAge>15</kindAge>
			</li>
			<li Class="ChezhouLib.HAR.Extension.kindRuleHAR">
				<bodyAddonRules>
					<li>
