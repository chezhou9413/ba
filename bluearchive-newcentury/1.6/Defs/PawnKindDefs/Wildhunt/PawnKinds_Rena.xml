                     <li>Rena_levelup_A</li>
                    <li>Rena_levelup_B</li>
					<li>Rena_levelup_C</li>
					<li>Rena_levelup_D</li>
                </levelUpSounds>
			</li>
			<li Class="ChezhouLib.Extension.kindRule">
