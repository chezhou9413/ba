  <ThingDef ParentName="BANC_BaseHumanMakeableGun">
    <defName>BANC_Hiyori</defName>
    <label>身份</label>
    <description>日和使用的狙击步枪。精准瞄准敌人飞行20mm的子弹，即使是在弹如雨下的战场中存在感也非常强。</description>
    <graphicData>
      <texPath>Weapon/Arian/Hiyori</texPath><!--贴图路径-->
      <graphicClass>Graphic_Single</graphicClass><!--贴图-->
      <drawSize>1.6</drawSize><!--贴图大小-->
    </graphicData>
    <weaponTags>
      <li>BANC_Hiyori</li><!--武器Tag-->
    </weaponTags>
    <equippedAngleOffset>45</equippedAngleOffset><!--武器Tag-->
    <soundInteract>BANW_Wp_SR_De</soundInteract><!--装备音效-->
    <statBases>
      <WorkToMake>80000</WorkToMake><!--制作时间-->
      <Mass>3.5</Mass><!--重量-->
      <AccuracyTouch>0.41</AccuracyTouch><!--贴近-->
      <AccuracyShort>0.58</AccuracyShort><!--近-->
      <AccuracyMedium>1</AccuracyMedium><!--中-->
      <AccuracyLong>1</AccuracyLong><!--远-->
      <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown><!--冷却时间-->
    </statBases>
    <equippedStatOffsets>
     <!-- <SocialImpact>-0.35</SocialImpact>--><!--社交增加-->
    </equippedStatOffsets>
    <costList>
      <Steel>1</Steel><!--材料-->
    </costList>
    <recipeMaker>
      <!--<researchPrerequisite>BA_Weapon_SRT</researchPrerequisite>-->
      <skillRequirements>
        <Crafting>8</Crafting><!--需要的手工-->
      </skillRequirements>
      <displayPriority>440</displayPriority><!--优先级-->
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass><!--子弹类型-->
        <hasStandardCommand>true</hasStandardCommand><!--子弹类型-->
        <defaultProjectile>BANC_Bullet_Hiyori</defaultProjectile><!--子弹-->
        <burstShotCount>1</burstShotCount><!--连射次数-->
        <warmupTime>1.3</warmupTime><!--瞄准时间-->
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots><!--射速-->
        <range>69.9</range><!--射距-->
        <soundCast>BANW_Wp_SR_At_A</soundCast><!--射击音效-->
        <soundCastTail>GunTail_Heavy</soundCastTail><!--装填音效-->
        <muzzleFlashScale>15</muzzleFlashScale><!--枪口闪光大小-->
      </li>
    </verbs>
    <comps>
      <li Class="ChezhouLib.Comp.CompProperties_KindLocked">
        <requiredPawnKindDefName>
          <li>BANW_Hiyori</li>
        </requiredPawnKindDefName>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>BANC_Bullet_Hiyori</defName>
    <label>身份子弹</label>
    <projectile>
      <damageDef>BANC_Damage_baofa</damageDef><!--子弹类型-->
      <damageAmountBase>21</damageAmountBase><!--子弹伤害-->
      <stoppingPower>1.5</stoppingPower><!--抑制-->
      <armorPenetrationBase>0.1</armorPenetrationBase><!--穿透-->
      <speed>120</speed><!--子弹速度-->
    </projectile>
    <graphicData>
      <shaderType>MoteGlow</shaderType><!-- 使用的着色器类型，用于发光效果 -->
      <drawSize>4</drawSize>
      <texPath>Projectile/Bullet_Hiyori</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="BANC_BaseHumanMakeableGun">
    <defName>BANC_Misaki</defName>
    <label>圣徒掠夺者</label>
    <description>美咲使用的火箭发射器。火箭弹发射后达到一定高度，将分裂成多个炮弹，造成大范围爆炸。</description>
    <graphicData>
      <texPath>Weapon/Arian/Misaki</texPath><!--贴图路径-->
      <graphicClass>Graphic_Single</graphicClass><!--贴图-->
      <drawSize>1.5</drawSize><!--贴图大小-->
    </graphicData>
    <weaponTags>
      <li>BANC_Misaki</li><!--武器Tag-->
    </weaponTags>
    <equippedAngleOffset>45</equippedAngleOffset><!--武器Tag-->
    <soundInteract>Interact_Rifle</soundInteract><!--装备音效-->
    <statBases>
      <WorkToMake>80000</WorkToMake><!--制作时间-->
      <Mass>3.5</Mass><!--重量-->
      <AccuracyTouch>0.81</AccuracyTouch><!--贴近-->
      <AccuracyShort>0.88</AccuracyShort><!--近-->
      <AccuracyMedium>0.86</AccuracyMedium><!--中-->
      <AccuracyLong>0.89</AccuracyLong><!--远-->
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown><!--冷却时间-->
    </statBases>
    <equippedStatOffsets>
     <!-- <SocialImpact>-0.35</SocialImpact>--><!--社交增加-->
    </equippedStatOffsets>
    <costList>
      <Steel>1</Steel><!--材料-->
    </costList>
    <recipeMaker>
      <!--<researchPrerequisite>BA_Weapon_SRT</researchPrerequisite>-->
      <skillRequirements>
        <Crafting>8</Crafting><!--需要的手工-->
      </skillRequirements>
      <displayPriority>440</displayPriority><!--优先级-->
    </recipeMaker>
    <verbs>
      <li>
        <targetParams>
        <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <verbClass>Verb_Shoot</verbClass><!--子弹类型-->
        <hasStandardCommand>true</hasStandardCommand><!--子弹类型-->
        <defaultProjectile>BANC_Bullet_Misaki</defaultProjectile><!--子弹-->
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer><!--ai攻击建筑-->
        <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius><!--5格回避范围-->
        <burstShotCount>5</burstShotCount><!--连射次数-->
        <warmupTime>2</warmupTime><!--瞄准时间-->
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots><!--射速-->
        <range>40.9</range><!--射距-->
        <soundCast>ThumpCannon_Fire</soundCast><!--射击音效-->
        <soundCastTail>GunTail_Heavy</soundCastTail><!--装填音效-->
        <muzzleFlashScale>9</muzzleFlashScale><!--枪口闪光大小-->
        <forcedMissRadius>1.5</forcedMissRadius>
      </li>
    </verbs>
    <comps>
      <li Class="ChezhouLib.Comp.CompProperties_KindLocked">
        <requiredPawnKindDefName>
          <li>BANW_Misaki</li>
        </requiredPawnKindDefName>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>BANC_Bullet_Misaki</defName>
    <label>圣徒掠夺者</label>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>BANC_Damage_Misaki</damageDef><!--子弹类型-->
      <damageAmountBase>11</damageAmountBase><!--子弹伤害-->
      <explosionRadius>1</explosionRadius>
      <stoppingPower>2</stoppingPower><!--抑制-->
      <armorPenetrationBase>0.1</armorPenetrationBase><!--穿透-->
      <speed>25</speed><!--子弹速度-->
    </projectile>
    <graphicData>
      <shaderType>TransparentPostLight</shaderType><!-- 使用的着色器类型，用于发光效果 -->
      <drawSize>1</drawSize>
      <texPath>Projectile/Bullet_Misaki</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>


</Defs>