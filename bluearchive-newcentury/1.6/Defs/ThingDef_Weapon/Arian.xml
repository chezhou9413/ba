<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<ThingDef ParentName="BANC_BaseHumanMakeableGun">
    <defName>BANC_Atsuko</defName>
    <label>天蝎座</label>
    <description>亚津子使用的冲锋枪。短小的枪身蕴藏着强大火力，尤其适合近距离战斗。</description>
    <graphicData>
      <texPath>Weapon/Arian/Atsuko</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <weaponTags>
      <li>BANC_Atsuko</li>
    </weaponTags>
    <equippedAngleOffset>45</equippedAngleOffset>
    <soundInteract>BANW_Wp_SMG_De</soundInteract>
    <statBases>
      <WorkToMake>80000</WorkToMake>
      <Mass>3.5</Mass>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>0.6</AccuracyLong>
      <RangedWeapon_Cooldown>0.9</RangedWeapon_Cooldown>
    </statBases>
    <equippedStatOffsets>
     
    </equippedStatOffsets>
    <costList>
      <Steel>1</Steel>
    </costList>
    <recipeMaker>
      
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>440</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>BANC_Bullet_Atsuko</defaultProjectile>
        <burstShotCount>5</burstShotCount>
        <warmupTime>1.5</warmupTime>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <range>22.9</range>
        <soundCast>BANW_Wp_SMG_At</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <comps>
      <li Class="ChezhouLib.Comp.CompProperties_KindLocked">
        <requiredPawnKindDefName>
          <li>BANW_Atsuko</li>
        </requiredPawnKindDefName>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>BANC_Bullet_Atsuko</defName>
    <label>天蝎座子弹</label>
    <projectile>
      <damageDef>BANC_Damage_baofa</damageDef>
      <damageAmountBase>5</damageAmountBase>
      <stoppingPower>0.5</stoppingPower>
      <armorPenetrationBase>0.1</armorPenetrationBase>
      <speed>65</speed>
    </projectile>
    <graphicData>
      <shaderType>MoteGlow</shaderType>
      <drawSize>2.5</drawSize>
      <texPath>Projectile/Bullet_Atsuko</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

