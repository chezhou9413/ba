  <ThingDef ParentName="BaseBullet">
    <defName>BANC_Bullet_Nozomi_Train_Test</defName>
    <label>发车测试子弹</label>
    <thingClass>BANWlLib.Projectiles.Projectile_PiercingArea</thingClass>
    <projectile>
      <!-- 统一战斗层使用的伤害类型。 -->
      <damageDef>BANC_Damage_Nozomi_Train</damageDef>
      <!-- 固定基础伤害交给扩展字段配置，这里保持 0。 -->
      <damageAmountBase>0</damageAmountBase>
      <stoppingPower>3</stoppingPower>
      <armorPenetrationBase>0.25</armorPenetrationBase>
      <speed>120</speed>
      <flyOverhead>true</flyOverhead>
    </projectile>
    <graphicData>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(4,12)</drawSize>
      <texPath>Projectile/Bullet_Nozomi</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <modExtensions>
      <li Class="BANWlLib.Projectiles.PiercingProjectileExtension">
        <!-- 同一目标每隔多少 tick 可再次受到该穿透弹伤害。 -->
        <damageIntervalTicks>5</damageIntervalTicks>
        <!-- 判定宽度，垂直于飞行方向。 -->
        <damageWidth>3</damageWidth>
        <!-- 判定长度，沿飞行方向。 -->
        <damageLength>8</damageLength>
        <!-- true 表示即使点击近处，也按 maxRange 沿点击方向飞到最大距离。 -->
        <extendToMaxRange>true</extendToMaxRange>
        <!-- 最大飞行距离，应与技能 range 保持一致。 -->
        <maxRange>44</maxRange>
        <!-- 是否跳过同阵营和盟友。 -->
        <immuneFriendlyFire>true</immuneFriendlyFire>
        <!-- 固定基础伤害，0 表示只吃攻击力倍率。 -->
        <baseAmount>0</baseAmount>
        <!-- 最终攻击力倍率，2.0 表示造成 200% 攻击力伤害。 -->
        <attackPowerRatio>2.0</attackPowerRatio>
        <!-- true 表示该段效果会额外乘施法者 EX技能倍率。 -->
        <isExSkill>true</isExSkill>
        <!-- 是否允许暴击。 -->
        <canCrit>true</canCrit>
        <!-- 是否应用攻击类型与护甲类型克制。 -->
        <applyAffinity>true</applyAffinity>
        <!-- 是否允许命中墙体等建筑。 -->
        <canHitBuilding>true</canHitBuilding>
        <!-- 是否命中敌对目标。 -->
        <affectHostile>true</affectHostile>
        <!-- 是否命中友方目标。 -->
        <affectFriendly>false</affectFriendly>
        <!-- 命中 Pawn 或 Building 时触发的方向自适应特效。 -->
        <directionalImpactEffect>BANW_Effecter_DirectionalImpact_Test</directionalImpactEffect>
        <!-- 是否对 Pawn 触发方向命中特效。 -->
        <directionalImpactOnPawn>true</directionalImpactOnPawn>
        <!-- 是否对 Building 触发方向命中特效。 -->
        <directionalImpactOnBuilding>true</directionalImpactOnBuilding>
        <!-- 方向命中特效飞出速度。 -->
        <directionalImpactSpeed>10</directionalImpactSpeed>
        <!-- 方向命中特效沿弹道方向向前偏移。 -->
        <directionalImpactOffsetForward>0.3</directionalImpactOffsetForward>
        <!-- 方向命中特效向上偏移，避免埋进地面。 -->
        <directionalImpactOffsetUp>0.5</directionalImpactOffsetUp>
        <!-- 飞行开始时的绘制缩放。 -->
        <startDrawScale>0.5</startDrawScale>
        <!-- 飞行结束时的绘制缩放。 -->
        <endDrawScale>1.2</endDrawScale>
        <!-- 淡入 tick 数。 -->
        <fadeInTicks>2</fadeInTicks>
        <!-- 淡出 tick 数。 -->
        <fadeOutTicks>5</fadeOutTicks>
      </li>
    </modExtensions>
  </ThingDef>

