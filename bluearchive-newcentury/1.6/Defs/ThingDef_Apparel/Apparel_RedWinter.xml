<ThingDef ParentName="BANW_Apparel_Base">
        <defName>BANW_Body_Nodoka_Bag</defName>
        <label>和香的望远镜</label>
        <description>和香随身携带的望远镜，喜欢天体观测，有时候也会用来偷窥老师.</description>
        <graphicData><!--需要一个衣服的通用物品贴图-->
            <texPath>Pawns/RedWinter/Nodoka/Apparel/Nodoka_Bag</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <tickerType>Normal</tickerType>
        <equippedStatOffsets>

		</equippedStatOffsets>
        <apparel>
            <wornGraphicData>
                <renderUtilityAsPack>true</renderUtilityAsPack>
            </wornGraphicData>
            <wornGraphicPath>Pawns/RedWinter/Nodoka/Apparel/Nodoka_Bag_Apparel</wornGraphicPath>
            <bodyPartGroups Inherit="False">
                <li>Torso</li><!--躯干-->
				<li>Neck</li><!--脖子-->
				<li>Shoulders</li><!--肩膀-->
				<li>Arms</li><!--臂-->
				<li>Legs</li><!--腿-->
				<li>FullHead</li><!--头-->
				<li>Feet</li><!--脚-->
				<li>Waist</li><!--腰-->
				<li>Hands</li><!--手-->
            </bodyPartGroups >
            <layers Inherit="False">
                <li>Belt</li>
            </layers>
            <tags>
                <li>BANW_Body_Nodoka_Bag</li>
                <li>BANW_Body</li>
            </tags>
        </apparel>
        <comps>
      <li Class="ChezhouLib.Comp.CompProperties_KindLocked">
        <requiredPawnKindDefName>
          <li>BANW_Nodoka</li>
        </requiredPawnKindDefName>
      </li>
    </comps>
    </ThingDef>

